---
export interface Props {
  intent?: "primary" | "danger" | "success" | "warning" | "info" | "neutral";
  showDot?: boolean;
  class?: string;
}

const { intent = "neutral", showDot = true, class: extraClass = "" } = Astro.props;

const intentClasses = {
  primary: "bg-global-primary/10 text-global-primary border-global-primary/20",
  danger: "bg-red-600/20 text-red-400 border-red-600/30",
  success: "bg-emerald-600/20 text-emerald-400 border-emerald-600/30",
  warning: "bg-yellow-600/20 text-yellow-400 border-yellow-600/30",
  info: "bg-blue-600/20 text-blue-400 border-blue-600/30",
  neutral: "bg-white/5 text-global-text-muted border-white/10",
};

const dotClasses = {
  primary: "bg-global-primary",
  danger: "bg-red-500",
  success: "bg-emerald-500",
  warning: "bg-yellow-500",
  info: "bg-blue-500",
  neutral: "bg-gray-400",
};

const baseClass = "inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-semibold border transition-colors shrink-0";
---

<span class:list={[baseClass, intentClasses[intent], extraClass]}>
  {showDot && <span class:list={["w-1.5 h-1.5 rounded-full shrink-0", dotClasses[intent]]} />}
  <slot />
</span>
