---
export type AdminIconName =
  | "upload"
  | "sheets"
  | "courses"
  | "teachers"
  | "moderation"
  | "contributions"
  | "curriculum"
  | "logout";

interface Props {
  name: AdminIconName;
  class?: string;
}

const { name, class: className = "h-5 w-5" } = Astro.props;
---

<svg
  class={className}
  xmlns="http://www.w3.org/2000/svg"
  fill="none"
  viewBox="0 0 24 24"
  stroke="currentColor"
  stroke-width="1.9"
  aria-hidden="true"
>
  {
    name === "upload" && (
      <>
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M12 16V4m0 0L7.5 8.5M12 4l4.5 4.5"
        />
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M5 14v4a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-4"
        />
      </>
    )
  }

  {
    name === "sheets" && (
      <>
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M7 3.75h7.25L18 7.5v12.75H7z"
        />
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M14.25 3.75V7.5H18"
        />
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M9.75 11.5h5.5M9.75 14.5h5.5M9.75 17.5h3.5"
        />
      </>
    )
  }

  {
    name === "courses" && (
      <>
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M4.5 5.5c2.75-.8 5.25-.2 7.5 1.3v13c-2.25-1.5-4.75-2.1-7.5-1.3z"
        />
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M19.5 5.5c-2.75-.8-5.25-.2-7.5 1.3v13c2.25-1.5 4.75-2.1 7.5-1.3z"
        />
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.8v13" />
      </>
    )
  }

  {
    name === "teachers" && (
      <>
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="m6.5 6.5 5.5-2.75 5.5 2.75L12 9.25z"
        />
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M17.5 6.5v3.5"
        />
        <circle cx="12" cy="11" r="2.5" />
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M6 20v-1.25A4.75 4.75 0 0 1 10.75 14h2.5A4.75 4.75 0 0 1 18 18.75V20"
        />
      </>
    )
  }

  {
    name === "moderation" && (
      <>
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M12 3 19 6v5c0 4.6-2.8 8-7 10-4.2-2-7-5.4-7-10V6z"
        />
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="m9 12 2 2 4-5"
        />
      </>
    )
  }

  {
    name === "contributions" && (
      <>
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 3.5V14" />
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="m8.5 10.5 3.5 3.5 3.5-3.5"
        />
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M5 17.5v1.25a1.75 1.75 0 0 0 1.75 1.75h10.5A1.75 1.75 0 0 0 19 18.75V17.5"
        />
      </>
    )
  }

  {
    name === "curriculum" && (
      <>
        <rect x="3.5" y="3.5" width="6" height="6" rx="1" />
        <rect x="14.5" y="3.5" width="6" height="6" rx="1" />
        <rect x="9" y="14.5" width="6" height="6" rx="1" />
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M6.5 9.5v2h11v-2M12 11.5v3"
        />
      </>
    )
  }

  {
    name === "logout" && (
      <>
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M10 5H5v14h5M14 8l4 4-4 4M18 12H9"
        />
      </>
    )
  }
</svg>
