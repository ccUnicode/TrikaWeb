---
export interface Props {
  size?: number;
  class?: string;
  title?: string;
}
const { size = 20, class: extraClass = "", title } = Astro.props as Props;
---
<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={extraClass}
  aria-label={title}
  aria-hidden={title ? "false" : "true"}
>
  <path d="M3 6h18" />
  <path d="M8 6V4h8v2" />
  <path d="M19 6l-1 14H6L5 6" />
  <path d="M10 11v5" />
  <path d="M14 11v5" />
</svg>
