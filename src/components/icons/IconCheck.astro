---
export interface Props {
  size?: number;
  class?: string;
  title?: string;
}
const { size = 20, class: extraClass = "", title } = Astro.props as Props;
---
<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={extraClass}
  aria-label={title}
  aria-hidden={title ? "false" : "true"}
>
  <polyline points="20 6 9 17 4 12" />
</svg>
