---
interface Props {
    title: string;
    description: string;
}

const { title, description } = Astro.props;
---

<div class="mb-8 flex flex-row items-center justify-between gap-4 flex-wrap">
    <div>
        <h1 class="text-2xl font-bold text-global-text">{title}</h1>
        <p class="mt-1 text-sm text-global-text-muted">{description}</p>
    </div>
    <div class="flex gap-2 flex-wrap">
        <a
            href="/admin/courses"
            class="rounded-lg bg-global-card border border-global-border px-4 py-2 text-sm font-medium text-global-text transition hover:bg-global-border"
        >
            Cursos
        </a>
        <a
            href="/admin/sheets"
            class="rounded-lg bg-global-card border border-global-border px-4 py-2 text-sm font-medium text-global-text transition hover:bg-global-border"
        >
            Planchas
        </a>
        <a
            href="/admin/teachers"
            class="rounded-lg bg-global-card border border-global-border px-4 py-2 text-sm font-medium text-global-text transition hover:bg-global-border"
        >
            Profesores
        </a>
        <a
            href="/admin/upload"
            class="rounded-lg bg-global-card border border-global-border px-4 py-2 text-sm font-medium text-global-text transition hover:bg-global-border"
        >
            Panel de subida
        </a>
        <a
            href="/admin/ratings"
            class="rounded-lg bg-global-card border border-global-border px-4 py-2 text-sm font-medium text-global-text transition hover:bg-global-border"
        >
            Calificaciones
        </a>
        <a
            href="/admin/contributions"
            class="rounded-lg bg-global-card border border-global-border px-4 py-2 text-sm font-medium text-global-text transition hover:bg-global-border"
        >
            Aportes
        </a>
        <a
            href="/admin/mallas"
            class="rounded-lg bg-global-card border border-global-border px-4 py-2 text-sm font-medium text-global-text transition hover:bg-global-border"
        >
            Mallas
        </a>
        <a
            href="/admin/moderation"
            class="rounded-lg bg-global-card border border-global-border px-4 py-2 text-sm font-medium text-global-text transition hover:bg-global-border"
        >
            Moderación
        </a>
        <form action="/api/admin/logout" method="POST">
            <button
                type="submit"
                class="rounded-lg bg-red-600/20 border border-red-600/30 px-4 py-2 text-sm font-medium text-red-400 transition hover:bg-red-600/30 cursor-pointer"
            >
                Cerrar Sesión
            </button>
        </form>
    </div>
</div>


