---
interface Props {
    title: string;
    description: string;
}

const { title, description } = Astro.props;
---

<header class="mb-8">
    <h1 class="text-2xl font-bold text-global-text">
        {title}
    </h1>

    <p class="mt-1 text-sm text-global-text-muted">
        {description}
    </p>
</header>