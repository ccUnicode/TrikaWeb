---
import { getUserSession } from "../lib/auth";

export interface Props {
  sheetId: number;
  avgRating?: number | null;
}
const { sheetId, avgRating } = Astro.props;
const formattedAvgRating = avgRating ? avgRating.toFixed(1) : "0.0";

const { user, profile } = await getUserSession(Astro.cookies);
const isLoggedIn = !!user;
const sessionUserId = user?.id || "";
const sessionUserName = profile?.full_name || "Estudiante";
const sessionAvatarUrl = profile?.avatar_url || "";
const userInitial = profile?.full_name ? profile.full_name.charAt(0).toUpperCase() : "E";
const userAvatar = profile?.avatar_url || null;
---

<section
  id="sheet-feedback-section"
  class="rounded-2xl border border-global-border-subtle bg-global-surface p-4 sm:p-6 max-w-4xl mx-auto"
  data-sheet-id={sheetId}
  data-session-user-id={sessionUserId}
  data-session-user-name={sessionUserName}
  data-session-avatar-url={sessionAvatarUrl}
>
  <!-- Header -->
  <div class="flex items-center justify-between mb-8">
    <div class="flex items-center gap-4">
      <h2 class="text-xl font-bold text-global-text flex items-center gap-2">
        Comentarios
        <span id="feedback-total-badge" class="text-sm font-medium text-global-text-muted ml-1">0</span>
      </h2>
    </div>
    <div class="flex items-center gap-2">
      <span class="text-yellow-400 text-sm flex items-center font-semibold tracking-wide bg-yellow-400/10 px-2 py-1 rounded-lg">
        <span class="mr-1 text-[16px]">★</span><span id="feedback-avg-badge">{formattedAvgRating}</span>
      </span>
    </div>
  </div>

  <!-- Formulario de Nuevo Comentario -->
  <div id="feedback-form-container" class="mb-8">
    <div class="flex gap-3 sm:gap-4">
      <!-- Avatar -->
      <div class="flex-shrink-0">
        {userAvatar ? (
          <img src={userAvatar} alt="Avatar" class="w-10 h-10 rounded-full object-cover border border-[#2A3240]" />
        ) : (
          <div class="w-10 h-10 rounded-full bg-[#1E2430] border border-[#2A3240] flex items-center justify-center font-bold text-lg text-global-primary">
            {userInitial}
          </div>
        )}
      </div>
      <!-- Inputs -->
      <div class="flex-1 flex flex-col gap-2">
        <!-- Texto -->
        <div>
          <textarea
            id="feedback-content"
            rows="2"
            maxlength="500"
            placeholder={isLoggedIn ? "Añade un comentario..." : "Inicia sesión para comentar..."}
            disabled={!isLoggedIn}
            class="w-full rounded-xl border border-global-border bg-global-bg px-4 py-3 text-sm text-global-text placeholder-global-text-muted/50 outline-none focus:border-global-primary transition-colors resize-none disabled:opacity-50"
          ></textarea>
        </div>
        
        <div class="flex items-center gap-2.5 mt-2">
          <input
            type="checkbox"
            id="feedback-anonymous"
            disabled={!isLoggedIn}
            class="rounded border-global-border-subtle bg-global-bg/50 text-global-primary focus:ring-global-primary focus:ring-offset-global-surface h-4 w-4 transition-all cursor-pointer disabled:opacity-50"
          />
          <label class="font-medium text-global-text-muted text-xs cursor-pointer select-none" for="feedback-anonymous">
            Publicar anónimamente (tu nombre no será visible)
          </label>
        </div>
        
        <!-- Estrellas y Acciones -->
        <div class="flex items-center justify-between mt-1">
          <div>
            <div class="flex items-center gap-0.5" id="feedback-stars-input">
              {Array.from({ length: 5 }).map((_, idx) => {
                const val = idx + 1;
                return (
                  <button
                    type="button"
                    class="feedback-star-btn w-7 h-7 flex items-center justify-center rounded hover:bg-global-surface transition-all focus:outline-none cursor-pointer disabled:opacity-50"
                    data-star={val}
                    aria-label={`${val} estrellas`}
                  >
                    <svg
                      class="w-5 h-5 pointer-events-none transition-colors duration-150 text-global-text-muted/30"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                    >
                      <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                    </svg>
                  </button>
                );
              })}
            </div>
          </div>
          
          <div id="feedback-form-status" class="hidden mt-3 rounded-xl bg-red-500/10 border border-red-500/20 px-3.5 py-2.5 text-xs font-medium text-red-400 flex items-center gap-2.5 transition-all">
            <svg class="w-4 h-4 text-red-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span id="feedback-form-status-text" class="flex-1"></span>
          </div>
          
          <div class="flex justify-end gap-2">
            <button
              type="button"
              id="cancel-feedback-btn"
              class="rounded-full px-4 py-2 text-sm font-semibold text-global-text transition hover:bg-global-surface cursor-pointer hidden disabled:opacity-50"
            >
              Cancelar
            </button>
            <button
              type="button"
              id="submit-feedback-btn"
              disabled
              class="rounded-full bg-global-primary px-4 py-2 text-sm font-semibold text-black transition hover:bg-global-primary-hover cursor-pointer disabled:opacity-50 disabled:bg-global-border disabled:text-global-text-muted flex items-center justify-center"
            >
              Comentar
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Lista de comentarios -->
  <div id="feedback-list" class="space-y-3">
    <!-- Se llena con JS -->
  </div>

  <!-- Estado vacío -->
  <div id="feedback-empty" class="hidden text-center py-6">
    <svg class="mx-auto w-10 h-10 text-global-text-muted/40 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z"></path>
    </svg>
    <p class="text-sm text-global-text-muted">Aún no hay comentarios. ¡Sé el primero!</p>
  </div>

  <!-- Loading -->
  <div id="feedback-loading" class="text-center py-6">
    <div class="animate-spin h-6 w-6 border-2 border-global-primary border-t-transparent rounded-full mx-auto mb-2"></div>
    <p class="text-xs text-global-text-muted">Cargando comentarios...</p>
  </div>

  <!-- Paginación -->
  <div id="feedback-pagination" class="hidden flex items-center justify-center gap-4 pt-4 mt-4 border-t border-global-border/50">
    <button
      type="button"
      id="feedback-prev-btn"
      class="rounded-lg border border-global-border bg-global-card px-3 py-1.5 text-xs text-global-text transition hover:bg-global-border disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer"
    >
      ← Anterior
    </button>
    <span id="feedback-page-info" class="text-xs text-global-text-muted">1 / 1</span>
    <button
      type="button"
      id="feedback-next-btn"
      class="rounded-lg border border-global-border bg-global-card px-3 py-1.5 text-xs text-global-text transition hover:bg-global-border disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer"
    >
      Siguiente →
    </button>
  </div>
</section>

<!-- Modal de eliminación -->
<div
  id="feedback-delete-modal"
  class="fixed inset-0 z-[100] flex items-center justify-center bg-black/50 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300"
>
  <div class="bg-global-surface border border-global-border rounded-xl p-6 max-w-md w-full mx-4 shadow-xl transform scale-95 transition-transform duration-300" id="feedback-delete-modal-box">
    <h3 class="text-lg font-bold text-global-text mb-2">
      ¿Eliminar tu comentario?
    </h3>
    <p class="text-global-text-muted text-sm mb-6">
      Esta acción es permanente y no se puede deshacer.
    </p>
    <div class="flex justify-end gap-3">
      <button
        type="button"
        id="cancel-feedback-delete-btn"
        class="px-4 py-2 rounded-lg border border-global-border text-global-text bg-global-card hover:bg-global-bg transition cursor-pointer text-sm font-medium"
      >
        Cancelar
      </button>
      <button
        type="button"
        id="confirm-feedback-delete-btn"
        class="px-4 py-2 rounded-lg bg-red-600/20 border border-red-600/30 text-red-400 hover:bg-red-600/30 transition cursor-pointer text-sm font-medium"
      >
        Eliminar
      </button>
    </div>
  </div>
</div>

<script>
  import { ensureDeviceId } from "../lib/client/device";

  function initSheetFeedback() {
    const section = document.getElementById("sheet-feedback-section");
    if (!section) return;

    const sheetId = section.getAttribute("data-sheet-id");
    const sessionUserId = section.getAttribute("data-session-user-id") || "";
    const sessionUserName = section.getAttribute("data-session-user-name") || "Tú";
    const sessionAvatarUrl = section.getAttribute("data-session-avatar-url") || "";
    if (!sheetId) return;

    // Elements
    const formContainer = document.getElementById("feedback-form-container");
    const starsInput = document.getElementById("feedback-stars-input");
    const contentInput = document.getElementById("feedback-content") as HTMLTextAreaElement;
    const cancelBtn = document.getElementById("cancel-feedback-btn") as HTMLButtonElement;
    const submitBtn = document.getElementById("submit-feedback-btn") as HTMLButtonElement;
    const formStatus = document.getElementById("feedback-form-status");
    const feedbackList = document.getElementById("feedback-list");
    const feedbackEmpty = document.getElementById("feedback-empty");
    const feedbackLoading = document.getElementById("feedback-loading");
    const totalBadge = document.getElementById("feedback-total-badge");
    const avgBadge = document.getElementById("feedback-avg-badge");
    const anonymousCheck = document.getElementById("feedback-anonymous") as HTMLInputElement;
    const paginationEl = document.getElementById("feedback-pagination");
    const prevBtn = document.getElementById("feedback-prev-btn") as HTMLButtonElement;
    const nextBtn = document.getElementById("feedback-next-btn") as HTMLButtonElement;
    const pageInfo = document.getElementById("feedback-page-info");

    const deleteModal = document.getElementById("feedback-delete-modal");
    const deleteModalBox = document.getElementById("feedback-delete-modal-box");
    const confirmDeleteBtn = document.getElementById("confirm-feedback-delete-btn") as HTMLButtonElement;
    const cancelDeleteBtn = document.getElementById("cancel-feedback-delete-btn");

    // Local State (Optimistic UI)
    let localComments: any[] = [];
    let totalComments = 0;
    let currentAvgRating = 0;
    
    let selectedStars = 0;
    let hoverStars = 0;
    let currentPage = 1;
    let totalPages = 1;
    const pageSize = 5;
    
    let userFeedbackId: number | null = null;
    let isSubmitting = false;
    let deletingId: number | null = null;
    let commentToDelete: number | null = null;

    // ── Stars interaction ──
    const highlightStars = (count: number) => {
      starsInput?.querySelectorAll(".feedback-star-btn").forEach((btn) => {
        const val = Number((btn as HTMLElement).dataset.star);
        const svg = btn.querySelector("svg");
        if (svg) {
          if (val <= count) {
            svg.classList.remove("text-global-text-muted/30");
            svg.classList.add("fill-yellow-400", "text-yellow-400");
          } else {
            svg.classList.add("text-global-text-muted/30");
            svg.classList.remove("fill-yellow-400", "text-yellow-400");
          }
        }
      });
    };

    starsInput?.querySelectorAll(".feedback-star-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        if (isSubmitting) return;
        selectedStars = Number((btn as HTMLElement).dataset.star);
        highlightStars(selectedStars);
        updateSubmitState();
      });
      btn.addEventListener("mouseenter", () => {
        if (isSubmitting) return;
        hoverStars = Number((btn as HTMLElement).dataset.star);
        highlightStars(hoverStars);
      });
    });
    starsInput?.addEventListener("mouseleave", () => {
      if (isSubmitting) return;
      hoverStars = 0;
      highlightStars(selectedStars);
    });

    // ── Character counter ──
    contentInput?.addEventListener("input", () => {
      updateSubmitState();
    });

    contentInput?.addEventListener("focus", () => {
      if (cancelBtn) cancelBtn.classList.remove("hidden");
    });

    cancelBtn?.addEventListener("click", () => {
      resetForm();
      if (cancelBtn) cancelBtn.classList.add("hidden");
      contentInput?.blur();
    });

    const updateSubmitState = () => {
      const hasText = contentInput ? contentInput.value.trim().length > 0 : false;
      if (submitBtn) {
        submitBtn.disabled = isSubmitting || selectedStars === 0 || !hasText;
        submitBtn.textContent = isSubmitting ? "Publicando..." : "Comentar";
      }
      if (contentInput) contentInput.disabled = isSubmitting;
      if (cancelBtn) cancelBtn.disabled = isSubmitting;
    };

    const statusText = document.getElementById("feedback-form-status-text");

    const showFormError = (msg: string) => {
      if (statusText) statusText.textContent = msg;
      if (formStatus) formStatus.classList.remove("hidden");
    };

    const hideFormError = () => {
      if (formStatus) formStatus.classList.add("hidden");
      if (statusText) statusText.textContent = "";
    };

    const populateForm = (feedback: any) => {
      selectedStars = feedback.stars || 0;
      highlightStars(selectedStars);
      if (contentInput) {
        contentInput.value = feedback.content || "";
      }
      if (anonymousCheck) {
        anonymousCheck.checked = feedback.is_anonymous === true;
      }
      hideFormError();
      updateSubmitState();
    };

    const resetForm = () => {
      selectedStars = 0;
      hoverStars = 0;
      highlightStars(0);
      if (contentInput) contentInput.value = "";
      if (anonymousCheck) anonymousCheck.checked = false;
      hideFormError();
      updateSubmitState();
    };

    // ── Submit feedback (Optimistic) ──
    submitBtn?.addEventListener("click", async () => {
      if (selectedStars === 0 || isSubmitting) return;

      isSubmitting = true;
      updateSubmitState();
      hideFormError();

      try {
        const deviceId = ensureDeviceId();
        const payload = {
          stars: selectedStars,
          content: contentInput?.value?.trim() || null,
          is_anonymous: anonymousCheck?.checked || false,
        };

        const res = await fetch(`/api/sheets/${sheetId}/feedback`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });

        const data = await res.json();

        if (!res.ok) {
          showFormError(data.error ?? "Error al enviar el comentario");
          isSubmitting = false;
          updateSubmitState();
          return;
        }

        // Optimistic UI update
        const newComment = {
          id: data.id || Date.now(),
          stars: selectedStars,
          content: payload.content,
          is_anonymous: payload.is_anonymous,
          user_name: sessionUserName,
          user_id: sessionUserId,
          device_id: deviceId,
          user_avatar: sessionAvatarUrl,
          created_at: new Date().toISOString(),
        };

        if (userFeedbackId) {
          localComments = [newComment, ...localComments.filter((c: any) => c.id !== userFeedbackId)];
        } else {
          localComments = [newComment, ...localComments];
          totalComments++;
        }
        userFeedbackId = newComment.id;

        resetForm();
        if (cancelBtn) cancelBtn.classList.add("hidden");
        
        renderFeedbackList();
        
      } catch {
        showFormError("Error de conexión al procesar el comentario");
      } finally {
        isSubmitting = false;
        updateSubmitState();
      }
    });

    // ── Delete Modal Logic ──
    const showDeleteModal = () => {
      deleteModal?.classList.remove("opacity-0", "pointer-events-none");
      deleteModalBox?.classList.remove("scale-95");
      deleteModalBox?.classList.add("scale-100");
    };

    const hideDeleteModal = () => {
      deleteModal?.classList.add("opacity-0", "pointer-events-none");
      deleteModalBox?.classList.remove("scale-100");
      deleteModalBox?.classList.add("scale-95");
    };

    cancelDeleteBtn?.addEventListener("click", hideDeleteModal);

    confirmDeleteBtn?.addEventListener("click", async () => {
      if (!confirmDeleteBtn || !commentToDelete) return;
      confirmDeleteBtn.disabled = true;
      confirmDeleteBtn.textContent = "Eliminando...";

      const idToDelete = commentToDelete;
      
      hideDeleteModal();
      deletingId = idToDelete;
      renderFeedbackList(); // Show "Eliminando..."

      try {
        const deviceId = ensureDeviceId();
        const res = await fetch(`/api/sheets/${sheetId}/feedback`, {
          method: "DELETE",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ device_id: deviceId }),
        });

        if (res.ok) {
          localComments = localComments.filter((c: any) => c.id !== idToDelete);
          userFeedbackId = null;
          totalComments = Math.max(0, totalComments - 1);
          loadFeedback(1);
        } else {
          alert("Error al eliminar");
        }
      } catch {
        alert("Error al eliminar el comentario");
      } finally {
        deletingId = null;
        commentToDelete = null;
        confirmDeleteBtn.disabled = false;
        confirmDeleteBtn.textContent = "Eliminar";
        renderFeedbackList();
      }
    });

    // ── Edit/Delete/Like/Reply own feedback ──
    feedbackList?.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      
      // Edit logic
      if (target.closest("[data-edit-own]")) {
        const userFeedback = localComments.find((c: any) => c.id === userFeedbackId);
        if (userFeedback) populateForm(userFeedback);
        contentInput?.focus();
        if (cancelBtn) cancelBtn.classList.remove("hidden");
        formContainer?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }

      // Delete logic
      if (target.closest("[data-delete-own]")) {
        const itemBtn = target.closest("[data-delete-own]") as HTMLElement;
        commentToDelete = Number(itemBtn.dataset.id);
        showDeleteModal();
        return;
      }

      // Like logic
      const likeBtn = target.closest("[data-like-id]") as HTMLElement;
      if (likeBtn) {
        const id = Number(likeBtn.dataset.likeId);
        const comment = localComments.find((c: any) => c.id === id);
        if (comment) {
          comment.isLiked = !comment.isLiked;
          comment.likesCount = (comment.likesCount ?? 0) + (comment.isLiked ? 1 : -1);
          renderFeedbackList();
        }
        return;
      }

      // Reply logic
      const replyBtn = target.closest("[data-reply-id]") as HTMLElement;
      if (replyBtn) {
        const id = Number(replyBtn.dataset.replyId);
        const comment = localComments.find((c: any) => c.id === id);
        if (comment) {
          comment.isReplying = true;
          renderFeedbackList();
          setTimeout(() => {
            const ta = feedbackList.querySelector(`textarea[data-reply-textarea="${id}"]`) as HTMLTextAreaElement;
            ta?.focus();
          }, 0);
        }
        return;
      }

      // Cancel reply
      const cancelReplyBtn = target.closest("[data-cancel-reply]") as HTMLElement;
      if (cancelReplyBtn) {
        const id = Number(cancelReplyBtn.dataset.cancelReply);
        const comment = localComments.find((c: any) => c.id === id);
        if (comment) {
          comment.isReplying = false;
          renderFeedbackList();
        }
        return;
      }

      // Submit reply
      const submitReplyBtn = target.closest("[data-submit-reply]") as HTMLElement;
      if (submitReplyBtn) {
        const id = Number(submitReplyBtn.dataset.submitReply);
        const comment = localComments.find((c: any) => c.id === id);
        if (comment) {
          comment.isReplying = false;
          renderFeedbackList();
        }
        return;
      }
    });

    // ── Render ──
    function renderFeedbackList() {
      if (!feedbackList) return;
      const deviceId = ensureDeviceId();

      if (totalBadge) totalBadge.textContent = String(totalComments);

      if (localComments.length === 0) {
        feedbackList.innerHTML = "";
        feedbackEmpty?.classList.remove("hidden");
        return;
      }

      feedbackEmpty?.classList.add("hidden");

      feedbackList.innerHTML = localComments
         .map((item) => {
          const date = new Date(item.created_at).toLocaleDateString("es-PE", {
            day: "numeric",
            month: "short",
            year: "numeric",
          });
          const starsHtml = "★".repeat(item.stars) + "☆".repeat(5 - item.stars);
          const escapedContent = escapeHtml(item.content ?? "");
          
          const isOwn = (sessionUserId && item.user_id === sessionUserId) || item.device_id === deviceId;
          const isDeleting = item.id === deletingId;
          
          const isLiked = !!item.isLiked;
          const likesCount = item.likesCount ?? 0;
          const isReplying = !!item.isReplying;
          const isAuthor = item.is_anonymous === false && isOwn;
          
          const avatarUrl = item.user_avatar;
          const authorInitial = item.user_name ? item.user_name.charAt(0).toUpperCase() : "A";
          const displayAuthor = item.is_anonymous ? "Anónimo" : (item.user_name || "Anónimo");

          const likeBtnClass = isLiked 
            ? "flex items-center gap-1.5 text-global-primary transition-colors duration-200 cursor-pointer group"
            : "flex items-center gap-1.5 text-global-text-muted hover:text-global-text transition-colors duration-200 cursor-pointer group";

          const likeSvgFill = isLiked ? "currentColor" : "none";

          let actionsHtml = "";
          if (isOwn) {
            if (isDeleting) {
              actionsHtml = `<span class="text-xs text-red-400 font-medium mr-2">Eliminando...</span>`;
            } else {
              actionsHtml = `
                <button type="button" data-edit-own class="text-global-text-muted hover:text-blue-400 transition-colors cursor-pointer p-1" title="Editar">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
                </button>
                <button type="button" data-delete-own data-id="${item.id}" class="text-global-text-muted hover:text-red-400 transition-colors cursor-pointer p-1" title="Eliminar">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                </button>
              `;
            }
          }

          let replyFormHtml = "";
          if (isReplying) {
            replyFormHtml = `
              <div class="mt-3 ml-8 sm:ml-12 border-l-2 border-global-border-subtle pl-4 py-1">
                <div class="flex gap-3">
                  <div class="flex-shrink-0">
                    <div class="w-8 h-8 rounded-full bg-[#1E2430] border border-[#2A3240] flex items-center justify-center font-bold text-sm text-global-primary">
                      A
                    </div>
                  </div>
                  <div class="flex-1 flex flex-col gap-2">
                    <textarea
                      data-reply-textarea="${item.id}"
                      placeholder="Escribe una respuesta..."
                      class="w-full rounded-xl border border-global-border bg-global-bg px-3 py-2 text-xs text-global-text placeholder-global-text-muted/50 outline-none focus:border-global-primary transition-colors resize-none"
                      rows="2"
                    ></textarea>
                    <div class="flex justify-end gap-2">
                      <button type="button" data-cancel-reply="${item.id}" class="rounded-full px-3 py-1.5 text-xs font-semibold text-global-text transition hover:bg-global-surface cursor-pointer">
                        Cancelar
                      </button>
                      <button type="button" data-submit-reply="${item.id}" class="rounded-full bg-global-primary px-3 py-1.5 text-xs font-semibold text-black transition hover:bg-global-primary-hover cursor-pointer">
                        Responder
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            `;
          }

          return `
            <div ${isOwn ? 'id="user-own-feedback-item"' : ''} class="py-4 border-b border-global-border last:border-b-0 bg-global-card/50 px-2 sm:px-4 transition-colors relative flex flex-col ${isDeleting ? 'opacity-50' : ''}">
              <div class="flex gap-3 sm:gap-4">
                <!-- Avatar -->
                <div class="flex-shrink-0 mt-1">
                  ${avatarUrl && !item.is_anonymous ? `
                    <img src="${avatarUrl}" alt="Avatar" class="w-10 h-10 rounded-full object-cover border border-[#2A3240]" />
                  ` : `
                    <div class="w-10 h-10 rounded-full bg-[#1E2430] border border-[#2A3240] text-global-primary flex items-center justify-center font-bold text-lg">
                      ${item.is_anonymous ? "A" : authorInitial}
                    </div>
                  `}
                </div>
                
                <!-- Content -->
                <div class="flex-1 min-w-0">
                  <!-- Header -->
                  <div class="flex items-center gap-2 mb-0.5">
                    <span class="font-bold text-global-text text-sm">${escapeHtml(displayAuthor)}</span>
                    ${isAuthor ? '<span class="text-[10px] font-bold text-purple-400 bg-purple-500/10 px-1.5 py-0.5 rounded">Autor</span>' : ''}
                    <span class="text-xs text-global-text-muted ml-1">${date}</span>
                    ${isOwn ? '<span class="text-[10px] font-bold text-global-primary uppercase tracking-wider bg-global-primary/10 px-1.5 py-0.5 rounded-md ml-1">(Tú)</span>' : ''}
                  </div>
                  
                  <!-- Stars -->
                  <div class="text-yellow-400 text-xs tracking-wider mb-2">
                    ${starsHtml}
                  </div>
                  
                  <!-- Body text -->
                  ${escapedContent ? `<p class="text-sm text-global-text-muted leading-relaxed whitespace-pre-line">${escapedContent}</p>` : ""}
                  
                  <!-- Footer / Interactions -->
                  <div class="flex items-center gap-4 mt-3">
                    ${isOwn ? `
                      <div class="flex items-center gap-2 ml-auto">
                        ${actionsHtml}
                      </div>
                    ` : ""}
                  </div>
                </div>
              </div>
              
              <!-- Reply Form -->
              ${replyFormHtml}
            </div>
          `;
        })
        .join("");
    }

    function escapeHtml(text: string): string {
      const div = document.createElement("div");
      div.textContent = text;
      return div.innerHTML;
    }

    // ── Load feedback ──
    async function loadFeedback(page: number) {
      currentPage = page;
      feedbackLoading?.classList.remove("hidden");
      feedbackEmpty?.classList.add("hidden");
      if (feedbackList) feedbackList.innerHTML = "";
      paginationEl?.classList.add("hidden");

      try {
        const deviceId = ensureDeviceId();
        const res = await fetch(
          `/api/sheets/${sheetId}/feedback?device_id=${deviceId}&page=${page}&pageSize=${pageSize}`
        );
        const data = await res.json();

        if (data.error) {
          console.error("Feedback API error:", data.error);
          if (feedbackList) {
            feedbackList.innerHTML = `<p class="text-center text-sm text-red-400 py-4">${escapeHtml(data.error)}</p>`;
          }
          return;
        }

        localComments = (data.feedback ?? []).map((c: any) => {
          c.likesCount = 0;
          c.isLiked = !!c.isLiked;
          c.isReplying = !!c.isReplying;
          return c;
        });

        totalComments = data.total ?? 0;
        totalPages = Math.ceil(totalComments / pageSize) || 1;
        currentAvgRating = data.avgRating || 0;

        if (avgBadge) {
          avgBadge.textContent = currentAvgRating.toFixed(1);
        }

        if (data.userFeedback) {
          userFeedbackId = data.userFeedback.id;
          const userComment = data.userFeedback;
          if (userComment.likesCount === undefined) userComment.likesCount = 0;
          userComment.isLiked = !!userComment.isLiked;
          userComment.isReplying = !!userComment.isReplying;

          localComments = localComments.filter((i: any) => i.id !== userFeedbackId);
          if (page === 1) {
            localComments.unshift(userComment);
          }
        } else {
          userFeedbackId = null;
        }

        renderFeedbackList();

        // Pagination
        if (totalPages > 1) {
          paginationEl?.classList.remove("hidden");
          if (pageInfo) pageInfo.textContent = `${page} / ${totalPages}`;
          if (prevBtn) prevBtn.disabled = page <= 1;
          if (nextBtn) nextBtn.disabled = page >= totalPages;
        }
      } catch (err) {
        console.error("Feedback load error:", err);
        if (feedbackList) {
          feedbackList.innerHTML = '<p class="text-center text-sm text-red-400 py-4">Error al cargar comentarios</p>';
        }
      } finally {
        feedbackLoading?.classList.add("hidden");
      }
    }

    // ── Pagination handlers ──
    prevBtn?.addEventListener("click", () => loadFeedback(currentPage - 1));
    nextBtn?.addEventListener("click", () => loadFeedback(currentPage + 1));

    // ── Init ──
    loadFeedback(1);
  }

  document.addEventListener("astro:page-load", initSheetFeedback);
  document.addEventListener("DOMContentLoaded", initSheetFeedback);
</script>
