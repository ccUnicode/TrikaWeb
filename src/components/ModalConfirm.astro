---
interface Props {
  id: string;
  title: string;
  message: string;
  cancelText?: string;
  confirmText?: string;
  confirmId: string;
  cancelId: string;
  feedbackId?: string;
}

const {
  id,
  title,
  message,
  cancelText = "Cancelar",
  confirmText = "Eliminar",
  confirmId,
  cancelId,
  feedbackId = `${id}-feedback`
} = Astro.props;
---

<div id={id} class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 backdrop-blur-sm p-4 transition-opacity duration-300">
  <div class="w-full max-w-md rounded-xl bg-global-surface border border-global-border p-6 shadow-xl text-left transform scale-95 transition-transform duration-300">
    <h3 class="text-lg font-bold text-global-text mb-2">{title}</h3>
    <p class="text-sm text-global-text-muted mb-6 leading-relaxed">{message}</p>
    
    <div class="flex justify-end gap-3">
      <button 
        id={cancelId} 
        type="button"
        class="px-4 py-2 rounded-lg text-sm font-medium text-global-text bg-global-card border border-global-border hover:bg-global-bg transition cursor-pointer select-none"
      >
        {cancelText}
      </button>
      <button 
        id={confirmId} 
        type="button"
        class="px-4 py-2 rounded-lg text-sm font-medium text-red-400 bg-red-600/20 border border-red-600/30 hover:bg-red-600/30 transition cursor-pointer select-none"
      >
        {confirmText}
      </button>
    </div>
    
    {feedbackId && (
      <span id={feedbackId} class="text-sm hidden text-left mt-3 block text-gray-400"></span>
    )}
  </div>
</div>
