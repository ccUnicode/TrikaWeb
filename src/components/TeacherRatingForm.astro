---
export interface Props {
  teacherId: number;
  avg: number | null;
  count: number | null;
  showSummary?: boolean;
}
const { teacherId, avg, count, showSummary = true } = Astro.props as Props;
const displayAvg = typeof avg === "number" ? avg.toFixed(2) : "-";
const displayCount = count ?? 0;
const fields = [
  {
    name: "difficulty",
    label: "Dificultad",
    description: "Nivel de exigencia en exámenes y tareas.",
    low: "Difícil",
    high: "Fácil",
  },
  {
    name: "didactic",
    label: "Didáctica",
    description: "Capacidad para explicar y hacerse entender.",
    low: "Confuso",
    high: "Claro",
  },
  {
    name: "resources",
    label: "Recursos",
    description: "Materiales (diapos, libros, etc).",
    low: "Poco",
    high: "Mucho",
  },
  {
    name: "responsability",
    label: "Responsabilidad",
    description: "Puntualidad y cumplimiento.",
    low: "Tardón",
    high: "Puntual",
  },
  {
    name: "grading",
    label: "Justo al calificar",
    description: "¿Qué tan justo es calificando?",
    low: "Injusto",
    high: "Justo",
  },
];
---

<div
  class="teacher-rating space-y-2 rounded-3xl border border-global-border bg-global-surface px-4 py-3 sm:px-6 sm:py-4"
  data-teacher-rating
  data-teacher-id={teacherId}
>
  <form class="space-y-3" data-rating-form>
    {
      showSummary && (
        <div class="text-center space-y-1 mb-4">
          <p class="text-lg font-medium text-global-text">Tu opinión importa</p>
          <p class="text-sm text-global-text-muted">
            Promedio actual:
            <span class="text-global-primary font-bold">{displayAvg}</span>
            en {displayCount} votos
          </p>
        </div>
      )
    }

    <!-- Hidden inputs to store values -->
    {
      fields.map((f) => (
        <input
          type="hidden"
          name={f.name}
          id={`input-${f.name}-${teacherId}`}
          value=""
        />
      ))
    }

    <div class="grid gap-x-6 gap-y-2.5 md:grid-cols-2">
      {
        fields.map((field) => (
          <div class="space-y-1 group" data-star-group={field.name}>
            <div class="flex items-center gap-2">
              <label class="font-medium text-global-text text-sm shrink-0">
                {field.label}
              </label>
              <div class="relative group/info cursor-help">
                <svg
                  class="w-3.5 h-3.5 text-global-text-muted hover:text-global-primary transition-colors"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                  />
                </svg>
                <div class="absolute left-1/2 -translate-x-1/2 bottom-full mb-2 w-48 p-2 bg-global-surface border border-global-border rounded-lg text-xs text-center text-global-text shadow-xl opacity-0 invisible group-hover/info:opacity-100 group-hover/info:visible transition-all z-20 pointer-events-none">
                  {field.description}
                  <div class="absolute left-1/2 -translate-x-1/2 top-full w-0 h-0 border-x-4 border-x-transparent border-t-4 border-t-global-border" />
                </div>
              </div>
            </div>

            <div class="bg-global-bg/30 rounded-xl py-1.5 px-3 border border-transparent group-hover:border-global-border-subtle transition-colors">
              <div class="flex items-center justify-between sm:justify-center gap-0.5 sm:gap-2.5 w-full">
                <span class="text-[10px] font-medium text-global-text-muted uppercase tracking-wider w-auto sm:w-12 text-left leading-tight">
                  {field.low}
                </span>

                <div
                  class="flex justify-center gap-0.5 sm:gap-1"
                  data-stars-container
                >
                  {Array.from({ length: 5 }).map((_, idx) => {
                    const val = idx + 1;
                    return (
                      <button
                        type="button"
                        class="star-btn w-6 h-6 sm:w-8 sm:h-8 flex items-center justify-center rounded-lg hover:bg-global-bg transition-all focus:outline-none focus:ring-2 focus:ring-global-primary/50 cursor-pointer"
                        data-value={val}
                        data-field={field.name}
                        aria-label={`${val} estrellas`}
                      >
                        <svg
                          class="w-4 h-4 sm:w-5 sm:h-5 pointer-events-none transition-transform duration-200 star-inactive"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.5"
                        >
                          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                        </svg>
                      </button>
                    );
                  })}
                </div>

                <span class="text-[10px] font-medium text-global-text-muted uppercase tracking-wider w-auto sm:w-12 text-right leading-tight">
                  {field.high}
                </span>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <div class="pt-2.5 border-t border-global-border-subtle/50">
      <label class="block space-y-1.5" for={`comment-${teacherId}`}>
        <span class="font-medium text-global-text text-sm"
          >Comentario (opcional)</span
        >
        <textarea
          id={`comment-${teacherId}`}
          name="comment"
          rows={2}
          class="w-full rounded-xl border border-global-border-subtle bg-global-bg/50 px-3.5 py-2 text-sm text-global-text placeholder:text-global-text-muted/50 focus:border-global-primary focus:bg-global-bg focus:outline-none focus:ring-1 focus:ring-global-primary transition-all resize-none"
          placeholder="Comparte tu experiencia con este profesor..."></textarea>
      </label>
    </div>

    <div class="flex items-center gap-2 py-0.5">
      <input
        type="checkbox"
        id={`is_anonymous-${teacherId}`}
        name="is_anonymous"
        class="rounded border-global-border-subtle bg-global-bg/50 text-global-primary focus:ring-global-primary focus:ring-offset-global-surface h-4 w-4 transition-all cursor-pointer"
      />
      <label class="font-medium text-global-text-muted text-xs cursor-pointer select-none" for={`is_anonymous-${teacherId}`}>
        Calificar de forma anónima (tu nombre no será visible para otros estudiantes)
      </label>
    </div>

    <div class="flex flex-col items-center gap-2">
      <button
        type="submit"
        class="relative w-full rounded-xl bg-global-primary px-5 py-3 text-sm font-bold text-black hover:bg-global-primary-hover hover:scale-[1.005] active:scale-[0.99] transition-all shadow-md cursor-pointer"
        data-submit
      >
        <span class="relative z-10">Enviar Calificación</span>
      </button>
      <span
        data-status
        class="text-xs font-medium text-global-text-muted h-3 block transition-colors duration-300"
      ></span>
    </div>
  </form>

  <!-- Success State (hidden by default) -->
  <div data-success-state class="hidden text-center space-y-6 py-8">
    <div class="space-y-3">
      <div
        class="w-16 h-16 mx-auto rounded-full bg-global-primary/20 flex items-center justify-center"
      >
        <svg
          class="w-8 h-8 text-global-primary"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M5 13l4 4L19 7"></path>
        </svg>
      </div>
      <h3 class="text-2xl font-bold text-global-text">
        ¡Gracias por calificar!
      </h3>
      <p class="text-global-text-muted">Tu calificación ha sido registrada.</p>
    </div>
  </div>
</div>

<style>
  /* Star Animation States */
  .star-inactive {
    color: rgba(180, 189, 201, 0.3); /* #B4BDC9 at 30% opacity */
  }

  /* Active/Filled State */
  .star-btn.active svg {
    fill: #22c55e;
    color: #22c55e;
    transform: scale(1.1);
  }

  /* Hover preview from group parent */
  .group[data-star-group]:hover .star-btn svg {
    /* Base state when hovering group but not specific star: handled by JS mostly */
  }
</style>

<script>
  import { ensureDeviceId } from "../lib/client/device";

  /**
   * Inicializa el formulario de calificación de profesor:
   * - Estrellas interactivas con hover preview y estado activo
   * - Validación de que todas las 5 dimensiones estén completas
   * - Envío POST a /api/profesores/:id/rate con device_id
   * - Recarga la página tras éxito para actualizar stats globales
   */
  const init = (widget: HTMLElement) => {
    if (widget.dataset.bound === "true") return;
    widget.dataset.bound = "true";
    const form = widget.querySelector("[data-rating-form]") as HTMLFormElement;
    const status = widget.querySelector("[data-status]") as HTMLElement;
    const teacherId = widget.dataset.teacherId;

    /** Configura las estrellas interactivas para cada dimensión (dificultad, didáctica, etc.) */
    const starGroups = widget.querySelectorAll("[data-star-group]");

    starGroups.forEach((group) => {
      const g = group as HTMLElement;
      const fieldName = g.dataset.starGroup;
      const input = widget.querySelector(
        `#input-${fieldName}-${teacherId}`,
      ) as HTMLInputElement;
      const buttons = g.querySelectorAll(".star-btn");

      let currentValue = 0;

      /** Actualiza las clases visuales de las estrellas según el valor seleccionado */
      const updateStars = (val: number) => {
        buttons.forEach((b, idx) => {
          const btn = b as HTMLButtonElement;
          const btnVal = idx + 1;
          if (btnVal <= val) {
            btn.classList.add("active");
          } else {
            btn.classList.remove("active");
          }
        });
      };

      /** Al hacer clic en una estrella: fija el valor y anima */
      buttons.forEach((b) => {
        const btn = b as HTMLButtonElement;
        btn.addEventListener("click", () => {
          const val = Number(btn.dataset.value);
          currentValue = val;
          if (input) input.value = currentValue.toString();
          updateStars(currentValue);

          const svg = btn.querySelector("svg");
          if (svg) {
            svg.style.transform = "scale(0.8)";
            setTimeout(() => (svg.style.transform = ""), 150);
          }
        });

        /** Vista previa al pasar el mouse sobre las estrellas */
        btn.addEventListener("mouseenter", () => {
          const val = Number(btn.dataset.value);
          updateStars(val);
        });
      });

      /** Al salir del área, restaura el valor seleccionado */
      g.querySelector("[data-stars-container]")?.addEventListener(
        "mouseleave",
        () => {
          updateStars(currentValue);
        },
      );
    });

    /** Envío del formulario: valida, construye payload y envía al servidor */
    form?.addEventListener("submit", async (event: SubmitEvent) => {
      event.preventDefault();
      const formData = new FormData(form);
      const payload: Record<string, any> = {};
      formData.forEach((value, key) => {
        if (
          [
            "difficulty",
            "didactic",
            "resources",
            "responsability",
            "grading",
          ].includes(key)
        ) {
          payload[key] = Number(value);
        } else {
          payload[key] = value;
        }
      });

      payload.is_anonymous = formData.has("is_anonymous");

      const missing = [
        "difficulty",
        "didactic",
        "resources",
        "responsability",
        "grading",
      ].some((field) => !payload[field]);

      if (missing) {
        if (status) {
          status.textContent = "Por favor, completa todas las estrellas.";
          status.classList.add("text-red-400");
          status.classList.remove("text-global-text-muted");
        }
        return;
      }

      widget.classList.add("opacity-50", "pointer-events-none");
      if (status) {
        status.textContent = "Enviando...";
        status.classList.remove("text-red-400");
      }

      try {
        const response = await fetch(`/api/profesores/${teacherId}/rate`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });

        if (!response.ok) {
          const error = await response.json().catch(() => ({}));
          if (status) {
            status.textContent = error?.error ?? "Error al guardar";
            status.classList.add("text-red-400");
            status.classList.remove("text-global-text-muted");
          }
          return;
        }

        // Éxito: muestra mensaje y recarga para actualizar stats del perfil
        const result = await response.json();
        const successState = widget.querySelector("[data-success-state]");

        if (status) {
          status.textContent = "¡Enviado! Actualizando...";
          status.classList.remove("text-red-400");
          status.classList.add("text-green-500");
        }

        setTimeout(() => {
          window.location.reload();
        }, 1000);

        if (successState) {
          form.classList.add("hidden");
          successState.classList.remove("hidden");
        }
      } catch (err) {
        console.error(err);
        if (status) {
          status.textContent = "Error de conexión";
          status.classList.add("text-red-400");
        }
      } finally {
        widget.classList.remove("opacity-50", "pointer-events-none");
      }
    });

    // prefill previous vote if user already rated
    if (teacherId) {
      fetch(`/api/profesores/${teacherId}/rate`)
        .then(res => res.json())
        .then(data => {
          if (data.hasVoted && data.rating) {
            const rating = data.rating;
            const commentArea = form.querySelector('[name="comment"]') as HTMLTextAreaElement | null;
            if (commentArea) commentArea.value = rating.comment || "";
            const anonCheckbox = form.querySelector('[name="is_anonymous"]') as HTMLInputElement | null;
            if (anonCheckbox) anonCheckbox.checked = rating.is_anonymous !== false;
            const fields = ["difficulty", "didactic", "resources", "responsability", "grading"];
            fields.forEach(field => {
              const val = rating[field];
              if (val) {
                const input = form.querySelector(`#input-${field}-${teacherId}`) as HTMLInputElement | null;
                if (input) input.value = val.toString();
                const group = form.querySelector(`[data-star-group="${field}"]`);
                if (group) {
                  const buttons = group.querySelectorAll(".star-btn");
                  buttons.forEach((b, idx) => {
                    if (idx + 1 <= val) {
                      b.classList.add("active");
                    } else {
                      b.classList.remove("active");
                    }
                  });
                }
              }
            });
          }
        })
        .catch(err => console.error("Error prefilling rating form:", err));
    }
  };

  if (typeof window !== "undefined") {
    document
      .querySelectorAll("[data-teacher-rating]")
      .forEach((el) => init(el as HTMLElement));
  }
</script>
