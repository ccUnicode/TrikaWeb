---
import Layout from "../../../../layouts/Layout.astro";
import AdminLayout from "../../../../components/AdminLayout.astro";

const rawCourseId = Astro.params.id;
const courseId = Number(rawCourseId);

if (!Number.isInteger(courseId) || courseId <= 0) {
  return Astro.redirect("/admin/courses");
}
---

<Layout title="" variant="admin">
  <AdminLayout title="" description="">
    <div class="mb-6 w-full">
      <a
        href="/admin/courses"
        class="group mb-5 inline-flex items-center gap-2 rounded-xl border border-emerald-400/30 bg-emerald-500/10 px-4 py-2.5 text-sm font-semibold text-emerald-300 shadow-sm transition hover:border-emerald-400/50 hover:bg-emerald-500/15 hover:text-emerald-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400/50"
      >
        <svg
          class="h-4 w-4 transition-transform group-hover:-translate-x-0.5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M19 12H5"></path>
          <path d="M12 19l-7-7 7-7"></path>
        </svg>

        <span>Volver a cursos</span>
      </a>

      <div class="flex w-full flex-wrap items-start justify-between gap-4">
        <div class="min-w-0 flex-1">
          <h1 class="text-2xl font-bold text-global-text">Editar curso</h1>

          <p class="mt-1 text-sm text-global-text-muted">
            Actualiza los datos y la configuración académica.
          </p>
        </div>

        <span
          id="course-status"
          class="inline-flex h-8 shrink-0 items-center justify-center rounded-lg border px-4 text-[10px] font-bold uppercase tracking-wide"
        >
          Cargando...
        </span>
      </div>
    </div>

    <section
      class="rounded-2xl border border-global-border bg-global-surface p-6"
    >
      <div
        id="page-feedback"
        class="mb-4 hidden rounded-xl border px-4 py-3 text-sm"
      >
      </div>

      <form id="edit-course-form" class="grid gap-4 sm:grid-cols-3">
        <input type="hidden" id="course-id" value={courseId} />

        <div>
          <label
            for="course-code"
            class="mb-1.5 block text-sm font-medium text-global-text-muted"
          >
            Código
          </label>

          <input
            id="course-code"
            type="text"
            required
            class="w-full rounded-xl border border-global-border bg-global-bg px-4 py-2.5 text-sm text-global-text outline-none transition focus:border-global-primary focus:ring-1 focus:ring-global-primary"
          />
        </div>

        <div class="sm:col-span-2">
          <label
            for="course-name"
            class="mb-1.5 block text-sm font-medium text-global-text-muted"
          >
            Nombre
          </label>

          <input
            id="course-name"
            type="text"
            class="w-full rounded-xl border border-global-border bg-global-bg px-4 py-2.5 text-sm text-global-text outline-none transition focus:border-global-primary focus:ring-1 focus:ring-global-primary"
            required
          />
        </div>

        <div class="sm:col-span-3">
          <div class="mb-1.5 flex items-center justify-between gap-3">
            <label
              for="course-summary"
              class="block text-sm font-medium text-global-text-muted"
            >
              Sumilla (opcional)
            </label>

            <span
              id="course-summary-counter"
              class="text-xs text-global-text-muted"
              aria-live="polite"
            >
              0/1000
            </span>
          </div>

          <textarea
            id="course-summary"
            maxlength="1000"
            class="h-32 w-full resize-none overflow-y-auto rounded-xl border border-global-border bg-global-bg px-4 py-3 text-sm leading-relaxed text-global-text outline-none transition focus:border-global-primary focus:ring-1 focus:ring-global-primary"
          ></textarea>
        </div>

        <div>
          <label
            for="course-credits"
            class="mb-1.5 block text-sm font-medium text-global-text-muted"
          >
            Créditos
          </label>

          <input
            id="course-credits"
            type="number"
            min="1"
            step="1"
            required
            class="w-full rounded-xl border border-global-border bg-global-bg px-4 py-2.5 text-sm text-global-text outline-none transition focus:border-global-primary focus:ring-1 focus:ring-global-primary"
          />
        </div>

        <div class="relative">
          <label
            class="mb-1.5 block text-sm font-medium text-global-text-muted"
          >
            Sistema de evaluación
          </label>

          <input type="hidden" id="course-system" />

          <div id="system-combobox-container" class="relative">
            <input
              id="course-system-search"
              type="text"
              autocomplete="off"
              required
              class="w-full rounded-xl border border-global-border bg-global-card px-4 py-2.5 pr-10 text-sm text-global-text outline-none transition placeholder-gray-500 focus:border-global-primary focus:ring-1 focus:ring-global-primary"
              placeholder="Cargando sistemas..."
            />

            <div
              class="pointer-events-none absolute inset-y-0 right-3 flex items-center"
            >
              <svg
                class="h-4 w-4 text-global-text-muted"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 9l-7 7-7-7"></path>
              </svg>
            </div>

            <ul
              id="system-dropdown"
              class="teacher-scroll absolute left-0 top-full z-30 mt-1 hidden max-h-72 w-full overflow-auto rounded-xl border border-global-border bg-global-surface shadow-lg"
            >
            </ul>
          </div>
        </div>

        <div class="relative">
          <label
            class="mb-1.5 block text-sm font-medium text-global-text-muted"
          >
            Subsistema de evaluación
          </label>

          <input type="hidden" id="course-subsystem" />

          <div id="subsystem-combobox-container" class="relative">
            <input
              id="course-subsystem-search"
              type="text"
              autocomplete="off"
              disabled
              class="w-full rounded-xl border border-global-border bg-global-card px-4 py-2.5 pr-10 text-sm text-global-text outline-none transition placeholder-gray-500 focus:border-global-primary focus:ring-1 focus:ring-global-primary disabled:cursor-not-allowed disabled:opacity-60"
              placeholder="Selecciona primero un sistema"
            />

            <div
              class="pointer-events-none absolute inset-y-0 right-3 flex items-center"
            >
              <svg
                class="h-4 w-4 text-global-text-muted"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 9l-7 7-7-7"></path>
              </svg>
            </div>

            <ul
              id="subsystem-dropdown"
              class="teacher-scroll absolute left-0 top-full z-30 mt-1 hidden max-h-60 w-full overflow-auto rounded-xl border border-global-border bg-global-surface shadow-lg"
            >
            </ul>
          </div>

          <p class="font-medium mt-1 text-xs text-green-400 italic">
            Puedes registrar el curso sin este dato, pero no podrás subir
            archivos hasta completar su configuración.
          </p>
        </div>

        <div id="evaluation-config-wrapper" class="hidden sm:col-span-3">
          <label
            class="mb-1.5 block text-sm font-medium text-global-text-muted"
          >
            Evaluaciones del curso
          </label>

          <p
            id="evaluation-config-help"
            class="mb-2 text-xs text-global-text-muted"
          >
          </p>

          <div id="evaluation-options" class="grid gap-2 sm:grid-cols-2"></div>
        </div>

        <div class="sm:col-span-3 flex flex-wrap items-center gap-3">
          <button
            type="submit"
            id="save-course-btn"
            class="rounded-xl bg-global-primary px-5 py-2.5 text-sm font-semibold text-black transition hover:bg-global-primary-hover disabled:cursor-not-allowed disabled:opacity-50"
            disabled
          >
            Guardar cambios
          </button>

          <span id="save-feedback" class="text-sm"></span>
        </div>
      </form>
    </section>
  </AdminLayout>
</Layout>

<script>
  type CourseStatus = "INCOMPLETO" | "COMPLETO";

  type CourseDetails = {
    id: number;
    code: string;
    name: string;
    summary: string;
    credits: number;
    system_id: number;
    subsystem_id: number | null;
    status: CourseStatus;
    is_hidden: boolean;
    selected_evaluations: number[];
  };

  type EvaluationSystem = {
    system_id: number;
    system_cod: string;
    system_description: string;
    requires_subsystem: boolean;
  };

  type EvaluationSubsystem = {
    subsystem_id: number;
    subsystem_cod: string;
    practices_quantity: number;
  };

  type VariableEvaluation = {
    evaluation_id: number;
    evaluation_name: string;
  };

  const courseIdInput = document.getElementById(
    "course-id",
  ) as HTMLInputElement;

  const codeInput = document.getElementById("course-code") as HTMLInputElement;

  const nameInput = document.getElementById("course-name") as HTMLInputElement;

  const summaryInput = document.getElementById(
    "course-summary",
  ) as HTMLTextAreaElement;

  const summaryCounter = document.getElementById(
    "course-summary-counter",
  ) as HTMLSpanElement;

  const creditsInput = document.getElementById(
    "course-credits",
  ) as HTMLInputElement;

  const systemSelect = document.getElementById(
    "course-system",
  ) as HTMLInputElement;

  const systemSearchInput = document.getElementById(
    "course-system-search",
  ) as HTMLInputElement;

  const systemDropdown = document.getElementById(
    "system-dropdown",
  ) as HTMLUListElement;

  const systemComboboxContainer = document.getElementById(
    "system-combobox-container",
  ) as HTMLDivElement;

  const subsystemSelect = document.getElementById(
    "course-subsystem",
  ) as HTMLInputElement;

  const subsystemSearchInput = document.getElementById(
    "course-subsystem-search",
  ) as HTMLInputElement;

  const subsystemDropdown = document.getElementById(
    "subsystem-dropdown",
  ) as HTMLUListElement;

  const subsystemComboboxContainer = document.getElementById(
    "subsystem-combobox-container",
  ) as HTMLDivElement;

  const statusEl = document.getElementById("course-status") as HTMLSpanElement;

  const evaluationWrapper = document.getElementById(
    "evaluation-config-wrapper",
  ) as HTMLDivElement;

  const evaluationHelp = document.getElementById(
    "evaluation-config-help",
  ) as HTMLParagraphElement;

  const evaluationOptions = document.getElementById(
    "evaluation-options",
  ) as HTMLDivElement;

  const saveBtn = document.getElementById(
    "save-course-btn",
  ) as HTMLButtonElement;

  const pageFeedback = document.getElementById(
    "page-feedback",
  ) as HTMLDivElement;

  const SUMMARY_MAX_LENGTH = 1000;

  const editForm = document.getElementById(
    "edit-course-form",
  ) as HTMLFormElement;

  const saveFeedback = document.getElementById(
    "save-feedback",
  ) as HTMLSpanElement;

  let cachedSystems: EvaluationSystem[] = [];
  let cachedSubsystems: EvaluationSubsystem[] = [];
  let cachedEvaluations: VariableEvaluation[] = [];

  let currentCourse: CourseDetails | null = null;
  let selectedEvaluationIds: number[] = [];

  function setSaveFeedback(
    message: string,
    kind: "ok" | "error" | "loading" = "ok",
  ) {
    saveFeedback.textContent = message;

    saveFeedback.className = "text-sm";

    if (kind === "error") {
      saveFeedback.classList.add("text-red-400");
      return;
    }

    if (kind === "loading") {
      saveFeedback.classList.add("text-global-text-muted");
      return;
    }

    saveFeedback.classList.add("text-green-400");
  }

  function updateEvaluationCheckboxLimits() {
    const subsystemId = Number(subsystemSelect.value);

    const subsystem = cachedSubsystems.find(
      (item) => item.subsystem_id === subsystemId,
    );

    if (!subsystem) {
      return;
    }

    const checkboxes = Array.from(
      document.querySelectorAll(".course-evaluation-checkbox"),
    ) as HTMLInputElement[];

    const checkedCount = checkboxes.filter(
      (checkbox) => checkbox.checked,
    ).length;

    const maximum = subsystem.practices_quantity;

    evaluationHelp.textContent = `Selecciona exactamente ${maximum} evaluaciones. Actualmente: ${checkedCount}/${maximum}.`;

    for (const checkbox of checkboxes) {
      checkbox.disabled = !checkbox.checked && checkedCount >= maximum;
    }
  }

  function escapeHtml(value: string) {
    return value
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");
  }

  function showPageError(message: string) {
    pageFeedback.textContent = message;
    pageFeedback.className =
      "mb-4 rounded-xl border border-red-500/30 bg-red-500/10 px-4 py-3 text-sm text-red-400";
  }

  function updateSummaryCounter() {
    const currentLength = summaryInput.value.length;

    summaryCounter.textContent = `${currentLength}/${SUMMARY_MAX_LENGTH}`;

    summaryCounter.classList.remove(
      "text-global-text-muted",
      "text-yellow-400",
      "text-red-400",
    );

    const remaining = SUMMARY_MAX_LENGTH - currentLength;

    if (remaining === 0) {
      summaryCounter.classList.add("text-red-400");
    } else if (remaining <= 100) {
      summaryCounter.classList.add("text-yellow-400");
    } else {
      summaryCounter.classList.add("text-global-text-muted");
    }
  }

  function renderStatus(status: CourseStatus) {
    statusEl.className =
      "inline-flex h-8 items-center justify-center rounded-lg border px-4 text-[10px] font-bold uppercase tracking-wide";

    if (status === "COMPLETO") {
      statusEl.textContent = "Completo";
      statusEl.classList.add(
        "border-blue-500/30",
        "bg-blue-500/10",
        "text-blue-400",
      );
      return;
    }

    statusEl.textContent = "Configuración pendiente";
    statusEl.classList.add(
      "border-orange-500/30",
      "bg-orange-500/10",
      "text-orange-400",
    );
  }

  async function loadSystems() {
    const response = await fetch("/api/admin/evaluation-systems", {
      credentials: "include",
    });

    const data = await response.json().catch(() => null);

    if (!response.ok || !data?.systems) {
      throw new Error(data?.error || "No se pudieron cargar los sistemas");
    }

    cachedSystems = data.systems;

    systemSearchInput.placeholder = "Buscar sistema por letra o descripción...";
  }

  function formatSystemShort(system: EvaluationSystem) {
    const description = String(system.system_description || "");

    return description
      .replaceAll("Promedio de trabajos calificados", "Trabajos")
      .replaceAll("Promedio de prácticas", "Prácticas")
      .replaceAll("promedio de prácticas", "Prácticas")
      .replaceAll("promedio de trabajos calificados", "Trabajos")
      .replaceAll("examen parcial", "EP")
      .replaceAll("Examen parcial", "EP")
      .replaceAll("examen final", "EF")
      .replaceAll("Examen final", "EF")
      .replaceAll("examen oral", "EO")
      .replaceAll("Evaluación del proceso de aprendizaje", "EPA")
      .replaceAll("trabajo final", "TF")
      .replace(/\((\d+)\)/g, "×$1");
  }

  function renderSystemDropdown(systems: EvaluationSystem[]) {
    if (!systems.length) {
      systemDropdown.innerHTML = `
      <li class="px-4 py-3 text-center text-sm text-global-text-muted">
        No se encontraron sistemas.
      </li>
    `;
      return;
    }

    systemDropdown.innerHTML = systems
      .map((system) => {
        const shortDescription = formatSystemShort(system);

        return `
        <li
          data-id="${system.system_id}"
          data-code="${escapeHtml(system.system_cod)}"
          class="cursor-pointer px-4 py-3 transition-colors hover:bg-black/30"
        >
          <div class="flex items-start gap-3">
            <span
              class="inline-flex h-7 min-w-7 items-center justify-center rounded-lg border border-global-border bg-global-card text-xs font-bold text-global-primary"
            >
              ${escapeHtml(system.system_cod)}
            </span>

            <div class="min-w-0">
              <div class="text-sm font-semibold text-global-text">
                Sistema ${escapeHtml(system.system_cod)}
              </div>

              <div class="text-xs leading-relaxed text-global-text-muted">
                ${escapeHtml(shortDescription)}
              </div>
            </div>
          </div>
        </li>
      `;
      })
      .join("");

    systemDropdown.querySelectorAll("li[data-id]").forEach((item) => {
      item.addEventListener("click", async () => {
        const systemId = Number(item.getAttribute("data-id"));

        const systemCode = item.getAttribute("data-code") || "";

        systemSelect.value = String(systemId);
        systemSearchInput.value = `Sistema ${systemCode}`;

        selectedEvaluationIds = [];

        systemDropdown.classList.add("hidden");

        await handleSystemChange();
      });
    });
  }

  function renderSubsystemDropdown(subsystems: EvaluationSubsystem[]) {
    if (!subsystems.length) {
      subsystemDropdown.innerHTML = `
      <li class="px-4 py-3 text-center text-sm text-global-text-muted">
        No hay subsistemas disponibles.
      </li>
    `;
      return;
    }

    subsystemDropdown.innerHTML = `
    <li
      data-pending="true"
      class="cursor-pointer px-4 py-2.5 text-sm text-global-text transition-colors hover:bg-black/30"
    >
      <div class="font-medium">
        Dejar pendiente
      </div>
      <div class="text-xs text-global-text-muted">
        El curso se guardará como incompleto
      </div>
    </li>

    ${subsystems
      .map(
        (subsystem) => `
          <li
            data-id="${subsystem.subsystem_id}"
            data-code="${escapeHtml(subsystem.subsystem_cod)}"
            class="cursor-pointer px-4 py-2.5 text-sm text-global-text transition-colors hover:bg-black/30"
          >
            <div class="flex items-center justify-between gap-3">
              <span class="font-medium">
                ${escapeHtml(subsystem.subsystem_cod)}
              </span>

              <span class="text-xs text-global-text-muted">
                ${subsystem.practices_quantity} eval.
              </span>
            </div>
          </li>
        `,
      )
      .join("")}
  `;

    subsystemDropdown
      .querySelector("li[data-pending]")
      ?.addEventListener("click", () => {
        subsystemSelect.value = "";
        subsystemSearchInput.value = "Configuración pendiente";

        selectedEvaluationIds = [];

        subsystemDropdown.classList.add("hidden");

        evaluationOptions.innerHTML = "";
        evaluationHelp.textContent = "";
        evaluationWrapper.classList.add("hidden");
      });

    subsystemDropdown.querySelectorAll("li[data-id]").forEach((item) => {
      item.addEventListener("click", () => {
        const subsystemId = Number(item.getAttribute("data-id"));

        const subsystemCode = item.getAttribute("data-code") || "";

        subsystemSelect.value = String(subsystemId);

        subsystemSearchInput.value = subsystemCode;

        selectedEvaluationIds = [];

        subsystemDropdown.classList.add("hidden");

        renderEvaluationOptions();
      });
    });
  }

  async function loadSubsystems() {
    const response = await fetch("/api/admin/evaluation-subsystems", {
      credentials: "include",
    });

    const data = await response.json().catch(() => null);

    if (!response.ok || !data?.ok) {
      throw new Error(data?.error || "No se pudieron cargar los subsistemas");
    }

    cachedSubsystems = data.subsystems || [];
  }

  async function loadCourse() {
    const courseId = Number(courseIdInput.value);

    const response = await fetch(
      `/api/admin/course-details?course_id=${courseId}`,
      {
        credentials: "include",
      },
    );

    const data = await response.json().catch(() => null);

    if (!response.ok || !data?.ok) {
      throw new Error(data?.error || "No se pudo cargar el curso");
    }

    currentCourse = data.course;
    selectedEvaluationIds = currentCourse?.selected_evaluations || [];

    codeInput.value = currentCourse?.code || "";
    nameInput.value = currentCourse?.name || "";
    summaryInput.value = currentCourse?.summary || "";
    creditsInput.value = String(currentCourse?.credits || "");

    const currentSystem = cachedSystems.find(
      (system) => system.system_id === currentCourse?.system_id,
    );

    systemSelect.value = currentSystem ? String(currentSystem.system_id) : "";

    systemSearchInput.value = currentSystem
      ? `Sistema ${currentSystem.system_cod}`
      : "";

    renderStatus(currentCourse!.status);
    updateSummaryCounter();

    await handleSystemChange(
      currentCourse?.subsystem_id ?? null,
      selectedEvaluationIds,
    );

    saveBtn.disabled = false;
  }

  async function handleSystemChange(
    preferredSubsystemId: number | null = null,
    preferredEvaluationIds: number[] = [],
  ) {
    const systemId = Number(systemSelect.value);

    const selectedSystem = cachedSystems.find(
      (system) => system.system_id === systemId,
    );

    subsystemSelect.value = "";
    subsystemSearchInput.value = "";
    subsystemDropdown.classList.add("hidden");

    evaluationOptions.innerHTML = "";
    evaluationHelp.textContent = "";
    evaluationWrapper.classList.add("hidden");
    cachedEvaluations = [];

    if (!selectedSystem) {
      subsystemSearchInput.disabled = true;
      subsystemSearchInput.placeholder = "Selecciona primero un sistema";
      return;
    }

    if (!selectedSystem.requires_subsystem) {
      subsystemSearchInput.disabled = true;
      subsystemSearchInput.placeholder = "No aplica";
      subsystemSearchInput.value = "No aplica";
      return;
    }

    subsystemSearchInput.disabled = false;
    subsystemSearchInput.placeholder = "Buscar subsistema o dejar pendiente...";

    if (preferredSubsystemId !== null) {
      const preferredSubsystem = cachedSubsystems.find(
        (subsystem) => subsystem.subsystem_id === preferredSubsystemId,
      );

      if (preferredSubsystem) {
        subsystemSelect.value = String(preferredSubsystem.subsystem_id);

        subsystemSearchInput.value = preferredSubsystem.subsystem_cod;
      }
    } else {
      subsystemSearchInput.value = "Configuración pendiente";
    }

    await loadEvaluationOptions(systemId, preferredEvaluationIds);
  }

  async function loadEvaluationOptions(
    systemId: number,
    preferredEvaluationIds: number[] = [],
  ) {
    const response = await fetch("/api/admin/course-evaluation-options", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
      },
      credentials: "include",
      body: JSON.stringify({
        system_id: systemId,
      }),
    });

    const data = await response.json().catch(() => null);

    if (!response.ok || !data?.ok) {
      cachedEvaluations = [];
      return;
    }

    cachedEvaluations = data.evaluations || [];

    renderEvaluationOptions(preferredEvaluationIds);
  }

  function renderEvaluationOptions(preferredEvaluationIds: number[] = []) {
    const subsystemId = Number(subsystemSelect.value);

    const subsystem = cachedSubsystems.find(
      (item) => item.subsystem_id === subsystemId,
    );

    if (!subsystem) {
      evaluationOptions.innerHTML = "";
      evaluationHelp.textContent = "";
      evaluationWrapper.classList.add("hidden");
      return;
    }

    evaluationWrapper.classList.remove("hidden");

    evaluationOptions.innerHTML = cachedEvaluations
      .map((evaluation) => {
        const checked = preferredEvaluationIds.includes(
          evaluation.evaluation_id,
        );

        return `
          <label
            class="flex items-center gap-3 rounded-xl border border-global-border bg-global-bg px-4 py-3 text-sm text-global-text"
          >
            <input
              type="checkbox"
              class="course-evaluation-checkbox"
              value="${evaluation.evaluation_id}"
              data-evaluation-name="${escapeHtml(evaluation.evaluation_name)}"
              ${checked ? "checked" : ""}
            />

            <span>
              ${escapeHtml(evaluation.evaluation_name)}
            </span>
          </label>
        `;
      })
      .join("");

    const checkboxes = Array.from(
      document.querySelectorAll(".course-evaluation-checkbox"),
    ) as HTMLInputElement[];

    for (const checkbox of checkboxes) {
      checkbox.addEventListener("change", () => {
        const allCheckboxes = Array.from(
          document.querySelectorAll(".course-evaluation-checkbox"),
        ) as HTMLInputElement[];

        if (checkbox.checked) {
          const allowed = canCheckEvaluation(checkbox, allCheckboxes);

          if (!allowed) {
            checkbox.checked = false;

            setSaveFeedback(
              "Debes seleccionar las evaluaciones en orden.",
              "error",
            );

            updateEvaluationCheckboxLimits();
            return;
          }
        } else {
          uncheckFollowingEvaluations(checkbox, allCheckboxes);
        }

        setSaveFeedback("", "ok");
        updateEvaluationCheckboxLimits();
      });
    }

    updateEvaluationCheckboxLimits();
  }

  function parseEvaluationLabel(label: string) {
    const match = label.match(/^(.*?)(\d+)$/);

    if (!match) {
      return {
        baseName: label.trim(),
        order: null as number | null,
      };
    }

    return {
      baseName: match[1].trim(),
      order: Number(match[2]),
    };
  }

  function canCheckEvaluation(
    target: HTMLInputElement,
    checkboxes: HTMLInputElement[],
  ) {
    const parsed = parseEvaluationLabel(target.dataset.evaluationName || "");

    if (parsed.order === null || parsed.order <= 1) {
      return true;
    }

    for (let order = 1; order < parsed.order; order++) {
      const requiredEvaluation = checkboxes.find((checkbox) => {
        const current = parseEvaluationLabel(
          checkbox.dataset.evaluationName || "",
        );

        return current.baseName === parsed.baseName && current.order === order;
      });

      if (!requiredEvaluation?.checked) {
        return false;
      }
    }

    return true;
  }

  function uncheckFollowingEvaluations(
    target: HTMLInputElement,
    checkboxes: HTMLInputElement[],
  ) {
    const parsed = parseEvaluationLabel(target.dataset.evaluationName || "");

    if (parsed.order === null) {
      return;
    }

    for (const checkbox of checkboxes) {
      const current = parseEvaluationLabel(
        checkbox.dataset.evaluationName || "",
      );

      if (
        current.baseName === parsed.baseName &&
        current.order !== null &&
        current.order > parsed.order
      ) {
        checkbox.checked = false;
      }
    }
  }

  summaryInput.addEventListener("input", updateSummaryCounter);

  systemSearchInput.addEventListener("input", (event) => {
    const query = (event.target as HTMLInputElement).value.trim().toLowerCase();

    systemSelect.value = "";
    selectedEvaluationIds = [];

    subsystemSelect.value = "";
    subsystemSearchInput.value = "";
    subsystemSearchInput.disabled = true;
    subsystemSearchInput.placeholder = "Selecciona primero un sistema";

    evaluationOptions.innerHTML = "";
    evaluationHelp.textContent = "";
    evaluationWrapper.classList.add("hidden");

    const filteredSystems = cachedSystems.filter((system) => {
      const haystack =
        `${system.system_cod} ${system.system_description}`.toLowerCase();

      return haystack.includes(query);
    });

    renderSystemDropdown(filteredSystems);
    systemDropdown.classList.remove("hidden");
  });

  systemSearchInput.addEventListener("focus", () => {
    renderSystemDropdown(cachedSystems);
    systemDropdown.classList.remove("hidden");
  });

  subsystemSearchInput.addEventListener("input", (event) => {
    const query = (event.target as HTMLInputElement).value.trim().toLowerCase();

    subsystemSelect.value = "";
    selectedEvaluationIds = [];

    evaluationOptions.innerHTML = "";
    evaluationHelp.textContent = "";
    evaluationWrapper.classList.add("hidden");

    const filteredSubsystems = cachedSubsystems.filter((subsystem) =>
      subsystem.subsystem_cod.toLowerCase().includes(query),
    );

    renderSubsystemDropdown(filteredSubsystems);

    subsystemDropdown.classList.remove("hidden");
  });

  subsystemSearchInput.addEventListener("focus", () => {
    if (subsystemSearchInput.disabled) {
      return;
    }

    renderSubsystemDropdown(cachedSubsystems);

    subsystemDropdown.classList.remove("hidden");
  });

  document.addEventListener("click", (event) => {
    const target = event.target as Node;

    if (!systemComboboxContainer.contains(target)) {
      systemDropdown.classList.add("hidden");
    }

    if (!subsystemComboboxContainer.contains(target)) {
      subsystemDropdown.classList.add("hidden");
    }
  });

  editForm.addEventListener("submit", async (event) => {
    event.preventDefault();

    if (saveBtn.disabled) {
      return;
    }

    const course_id = Number(courseIdInput.value);

    const code = codeInput.value.trim().toUpperCase();

    const name = nameInput.value.trim();
    const summary = summaryInput.value.trim();

    const credits = Number(creditsInput.value);

    const system_id = Number(systemSelect.value);

    const subsystem_id = subsystemSelect.value
      ? Number(subsystemSelect.value)
      : null;

    const selected_evaluations = Array.from(
      document.querySelectorAll(".course-evaluation-checkbox:checked"),
    )
      .map((element) => Number((element as HTMLInputElement).value))
      .filter(
        (evaluationId) => Number.isInteger(evaluationId) && evaluationId > 0,
      );

    if (!Number.isInteger(course_id) || course_id <= 0) {
      setSaveFeedback("Curso inválido.", "error");
      return;
    }

    if (code.length < 2) {
      setSaveFeedback("El código debe tener al menos 2 caracteres.", "error");
      return;
    }

    if (name.length < 2) {
      setSaveFeedback("El nombre debe tener al menos 2 caracteres.", "error");
      return;
    }

    if (summary.length > 1000) {
      setSaveFeedback(
        "La sumilla no puede superar los 1000 caracteres.",
        "error",
      );
      return;
    }

    if (!Number.isInteger(credits) || credits <= 0) {
      setSaveFeedback("Los créditos deben ser un entero mayor a 0.", "error");
      return;
    }

    const selectedSystem = cachedSystems.find(
      (system) => system.system_id === system_id,
    );

    if (!selectedSystem) {
      setSaveFeedback("Debes seleccionar un sistema válido.", "error");
      return;
    }

    if (selectedSystem.requires_subsystem && subsystem_id !== null) {
      const selectedSubsystem = cachedSubsystems.find(
        (subsystem) => subsystem.subsystem_id === subsystem_id,
      );

      if (!selectedSubsystem) {
        setSaveFeedback("El subsistema seleccionado no es válido.", "error");
        return;
      }

      if (
        selected_evaluations.length !== selectedSubsystem.practices_quantity
      ) {
        setSaveFeedback(
          `Debes seleccionar exactamente ${selectedSubsystem.practices_quantity} evaluaciones.`,
          "error",
        );
        return;
      }
    }

    if (
      selectedSystem.requires_subsystem &&
      subsystem_id === null &&
      selected_evaluations.length > 0
    ) {
      setSaveFeedback(
        "No puedes seleccionar evaluaciones mientras el subsistema esté pendiente.",
        "error",
      );
      return;
    }

    if (
      !selectedSystem.requires_subsystem &&
      (subsystem_id !== null || selected_evaluations.length > 0)
    ) {
      setSaveFeedback(
        "El sistema seleccionado no requiere subsistema ni evaluaciones variables.",
        "error",
      );
      return;
    }

    saveBtn.disabled = true;
    setSaveFeedback("Guardando cambios...", "loading");

    try {
      const response = await fetch("/api/admin/update-course", {
        method: "PATCH",
        headers: {
          "Content-Type": "application/json",
        },
        credentials: "include",
        body: JSON.stringify({
          course_id,
          code,
          name,
          summary,
          credits,
          system_id,
          subsystem_id,
          selected_evaluations,
        }),
      });

      const data = await response.json().catch(() => null);

      if (!response.ok || !data?.ok) {
        throw new Error(data?.error || "No se pudo actualizar el curso");
      }

      const updatedStatus = data.course.status as CourseStatus;

      renderStatus(updatedStatus);

      selectedEvaluationIds = selected_evaluations;

      if (currentCourse) {
        currentCourse = {
          ...currentCourse,
          ...data.course,
          selected_evaluations,
        };
      }

      setSaveFeedback(
        updatedStatus === "COMPLETO"
          ? "Cambios guardados. La configuración del curso está completa."
          : "Cambios guardados. El curso continúa con configuración pendiente.",
        "ok",
      );
    } catch (error) {
      console.error("Error actualizando curso:", error);

      setSaveFeedback(
        error instanceof Error ? error.message : "Ocurrió un error al guardar",
        "error",
      );
    } finally {
      saveBtn.disabled = false;
    }
  });

  document.addEventListener("DOMContentLoaded", async () => {
    try {
      await Promise.all([loadSystems(), loadSubsystems()]);

      await loadCourse();
    } catch (error) {
      console.error(error);

      showPageError(
        error instanceof Error ? error.message : "No se pudo cargar la página",
      );
    }
  });
</script>
