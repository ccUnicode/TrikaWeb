---
import Layout from "../../layouts/Layout.astro";
import AdminHeader from "../../components/AdminHeader.astro";
import { validateAdminSession } from "../../lib/adminAuth";
import AdminLayout from "../../components/AdminLayout.astro";
import ModalConfirm from "../../components/ModalConfirm.astro";

const isAdmin = await validateAdminSession(Astro.cookies);
if (!isAdmin) {
  return Astro.redirect("/admin/login");
}
---

<Layout 
  title="Gestionar Planchas | TrikaWeb Admin"
  variant="admin"
>
  <AdminLayout
    title="Gestionar Planchas"
    description="Oculta o muestra planchas sin borrarlas"
  >
    <section
      class="rounded-2xl bg-global-surface border border-global-border p-4 sm:p-6"
    >
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 sm:gap-4 mb-4">
        <div>
          <h2 class="text-base sm:text-lg font-semibold text-global-text">Planchas</h2>
          <p class="text-xs sm:text-sm text-global-text-muted">
            <span id="visible-count" class="font-semibold text-global-text"
              >0</span
            > visibles ·
            <span id="hidden-count" class="font-semibold text-global-text"
              >0</span
            > ocultas
          </p>
        </div>
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2 w-full lg:w-auto">
          <input
            id="sheets-course"
            type="text"
            class="w-full sm:w-[220px] rounded-xl border border-global-border bg-global-bg px-3.5 py-2 text-sm text-global-text outline-none focus:border-global-primary focus:ring-1 focus:ring-global-primary transition-colors"
            placeholder="Curso (Nombre / Código)"
          />
          <div class="flex items-center gap-2 flex-1 sm:w-auto">
            <input
              id="sheets-q"
              type="text"
              class="flex-1 sm:w-[220px] rounded-xl border border-global-border bg-global-bg px-3.5 py-2 text-sm text-global-text outline-none focus:border-global-primary focus:ring-1 focus:ring-global-primary transition-colors"
              placeholder="Ciclo, Eval, Docente..."
            />
            <button
              id="sheets-refresh"
              type="button"
              class="h-[38px] px-3.5 rounded-xl bg-global-card border border-global-border text-sm font-medium text-global-text transition hover:bg-global-border cursor-pointer flex items-center justify-center shrink-0"
              title="Recargar planchas"
              aria-label="Recargar planchas"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
              </svg>
            </button>
          </div>
        </div>
      </div>

      <div id="sheets-list" class="space-y-3"></div>
      <div
        id="sheets-pagination"
        class="mt-6 flex items-center justify-between gap-3"
      >
      </div>
    </section>

    <ModalConfirm
      id="delete-modal"
      title="¿Eliminar plancha?"
      message="Esta acción es permanente y no se puede deshacer."
      confirmId="confirm-delete-btn"
      cancelId="cancel-delete-btn"
    />
  </AdminLayout>
</Layout>

<script>
  type AdminSheet = {
    id: number;
    exam_type: string;
    cycle: string;
    teacher_hint: string | null;
    avg_difficulty: number | null;
    rating_count: number;
    view_count: number;
    solution_kind: string | null;
    thumb_storage_path: string | null;
    is_hidden: boolean;
    course_code: string | null;
    course_name: string | null;
  };

  const listEl = document.getElementById("sheets-list") as HTMLDivElement;
  const paginationEl = document.getElementById(
    "sheets-pagination",
  ) as HTMLDivElement;
  const courseInput = document.getElementById(
    "sheets-course",
  ) as HTMLInputElement;
  const qInput = document.getElementById("sheets-q") as HTMLInputElement;
  const refreshBtn = document.getElementById(
    "sheets-refresh",
  ) as HTMLButtonElement;
  const visibleCountEl = document.getElementById(
    "visible-count",
  ) as HTMLSpanElement;
  const hiddenCountEl = document.getElementById(
    "hidden-count",
  ) as HTMLSpanElement;

  const deleteModal = document.getElementById("delete-modal") as HTMLDivElement;
  const confirmDeleteBtn = document.getElementById(
    "confirm-delete-btn",
  ) as HTMLButtonElement;
  const cancelDeleteBtn = document.getElementById(
    "cancel-delete-btn",
  ) as HTMLButtonElement;

  let sheetIdPendingDelete: number | null = null;
  let deleteBtnRef: HTMLButtonElement | null = null;

  function showDeleteModal(sheetId: number, btn: HTMLButtonElement) {
    sheetIdPendingDelete = sheetId;
    deleteBtnRef = btn;
    if (deleteModal) {
      deleteModal.classList.remove("hidden");
      deleteModal.classList.add("flex");
    }
  }

  function hideDeleteModal() {
    if (deleteModal) {
      deleteModal.classList.add("hidden");
      deleteModal.classList.remove("flex");
    }
    sheetIdPendingDelete = null;
    deleteBtnRef = null;
  }

  cancelDeleteBtn?.addEventListener("click", hideDeleteModal);

  confirmDeleteBtn?.addEventListener("click", async () => {
    if (!sheetIdPendingDelete || !deleteBtnRef) return;

    const b = deleteBtnRef;
    const sheetId = sheetIdPendingDelete;
    hideDeleteModal();

    b.disabled = true;
    try {
      const res = await fetch("/api/admin/delete-sheet", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        credentials: "include",
        body: JSON.stringify({ sheet_id: sheetId }),
      });
      const out = await res.json().catch(() => null);
      if (!res.ok || !out?.ok) {
        throw new Error(out?.error || "No se pudo eliminar la plancha");
      }

      // Actualización optimista del DOM
      const sheetRow = b.closest(`[data-sheet-id="${sheetId}"]`);
      if (sheetRow) {
        const toggleBtn = sheetRow.querySelector(".toggle-sheet-btn");
        const wasHidden =
          toggleBtn?.getAttribute("data-next-hidden") === "false";
        sheetRow.remove();

        if (visibleCountEl && hiddenCountEl) {
          let tc = parseInt(
            wasHidden
              ? hiddenCountEl.textContent || "0"
              : visibleCountEl.textContent || "0",
            10,
          );
          if (wasHidden)
            hiddenCountEl.textContent = String(Math.max(0, tc - 1));
          else visibleCountEl.textContent = String(Math.max(0, tc - 1));
        }
      }

      if (out?.counts) {
        if (visibleCountEl)
          visibleCountEl.textContent = String(out.counts.visible);
        if (hiddenCountEl)
          hiddenCountEl.textContent = String(out.counts.hidden);
      }
    } catch (e) {
      console.error(e);
      b.disabled = false;
      alert(e instanceof Error ? e.message : "Error desconocido");
    }
  });

  let page = 1;
  const pageSize = 20;
  let searchTimer: ReturnType<typeof setTimeout> | undefined;

  const scheduleSearch = () => {
    clearTimeout(searchTimer);
    searchTimer = setTimeout(() => loadSheets(1), 250);
  };

  listEl?.addEventListener("click", async (e) => {
    const target = e.target as HTMLElement;
    const toggleBtn = target.closest(
      ".toggle-sheet-btn",
    ) as HTMLButtonElement | null;

    if (toggleBtn) {
      const btn = toggleBtn;
      const sheetId = Number(btn.getAttribute("data-sheet-id"));
      const nextHidden = btn.getAttribute("data-next-hidden") === "true";

      btn.disabled = true;
      try {
        const res = await fetch("/api/admin/toggle-sheet", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          credentials: "include",
          body: JSON.stringify({
            sheet_id: sheetId,
            is_hidden: nextHidden,
          }),
        });
        const out = await res.json().catch(() => null);
        if (!res.ok || !out?.ok) {
          throw new Error(out?.error || "No se pudo actualizar");
        }

        btn.disabled = false;
        btn.setAttribute("data-next-hidden", nextHidden ? "false" : "true");
        btn.textContent = nextHidden ? "Mostrar" : "Ocultar";

        const sheetDiv = btn.closest("[data-sheet-card]") as HTMLElement | null;
        if (sheetDiv) {
          if (nextHidden) {
            sheetDiv.classList.add("opacity-70");
          } else {
            sheetDiv.classList.remove("opacity-70");
          }

          const badge = sheetDiv.querySelector(
            ".sheet-status-badge",
          ) as HTMLElement | null;
          if (badge) {
            badge.innerHTML = `<span class="w-1.5 h-1.5 rounded-full shrink-0 ${nextHidden ? "bg-amber-500" : "bg-emerald-500"}"></span> ${nextHidden ? "OCULTA" : "VISIBLE"}`;
            badge.className = `sheet-status-badge inline-flex items-center gap-1.5 px-2.5 py-1 text-[11px] font-semibold rounded-full border transition-colors shrink-0 ${nextHidden ? "bg-amber-600/20 text-amber-400 border-amber-600/30" : "bg-emerald-600/20 text-emerald-400 border-emerald-600/30"}`;
          }

          btn.className = `toggle-sheet-btn inline-flex items-center justify-center shrink-0 transition-all cursor-pointer font-semibold shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-offset-global-bg active:scale-95 disabled:opacity-50 disabled:cursor-not-allowed px-3 py-1.5 text-xs rounded-lg gap-1.5 ${nextHidden ? "bg-emerald-600/20 text-emerald-400 border border-emerald-600/30 hover:bg-emerald-600/30" : "bg-amber-600/20 text-amber-400 border border-amber-600/30 hover:bg-amber-600/30"}`;
          btn.innerHTML = nextHidden ? "Mostrar" : "Ocultar";
        }

        if (visibleCountEl && hiddenCountEl) {
          let vc = parseInt(visibleCountEl.textContent || "0", 10);
          let hc = parseInt(hiddenCountEl.textContent || "0", 10);
          if (nextHidden) {
            vc--;
            hc++;
          } else {
            vc++;
            hc--;
          }
          visibleCountEl.textContent = String(Math.max(0, vc));
          hiddenCountEl.textContent = String(Math.max(0, hc));
        }

        if (out?.counts) {
          if (visibleCountEl)
            visibleCountEl.textContent = String(out.counts.visible);
          if (hiddenCountEl)
            hiddenCountEl.textContent = String(out.counts.hidden);
        }
      } catch (err) {
        console.error(err);
        btn.disabled = false;
        alert(err instanceof Error ? err.message : "Error desconocido");
      }
    }

    const deleteBtn = target.closest(
      ".delete-sheet-btn",
    ) as HTMLButtonElement | null;
    if (deleteBtn) {
      const btn = deleteBtn;
      const sheetId = Number(btn.getAttribute("data-sheet-id"));
      showDeleteModal(sheetId, btn);
    }
  });

  courseInput?.addEventListener("input", () => {
    if (qInput) qInput.value = "";
    scheduleSearch();
  });

  qInput?.addEventListener("input", () => {
    if (courseInput) courseInput.value = "";
    scheduleSearch();
  });

  refreshBtn?.addEventListener("click", () => loadSheets(page));

  paginationEl?.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest("button");
    if (!btn || btn.disabled) return;
    if (btn.id === "sheets-prev") loadSheets(page - 1);
    else if (btn.id === "sheets-next") loadSheets(page + 1);
  });

  const escapeHtml = (value: string) =>
    String(value)
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");

  async function loadSheets(nextPage: number = 1) {
    page = nextPage;
    listEl.innerHTML =
      "<div class='text-sm text-global-text-muted'>Cargando...</div>";
    paginationEl.innerHTML = "";

    const course = (courseInput?.value || "").trim();
    const q = (qInput?.value || "").trim();

    const res = await fetch("/api/admin/sheets", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      credentials: "include",
      body: JSON.stringify({ page, pageSize, course, q }),
    });

    const data = await res.json().catch(() => null);

    if (!res.ok || !data?.ok) {
      listEl.innerHTML =
        "<div class='text-sm text-red-400'>No se pudo cargar planchas</div>";
      return;
    }

    if (visibleCountEl)
      visibleCountEl.textContent = String(data?.counts?.visible ?? 0);
    if (hiddenCountEl)
      hiddenCountEl.textContent = String(data?.counts?.hidden ?? 0);

    const sheets: AdminSheet[] = data.sheets || [];

    if (!sheets.length) {
      listEl.innerHTML =
        "<div class='text-sm text-global-text-muted'>No hay planchas para mostrar.</div>";
    } else {
      listEl.innerHTML = sheets
        .map((s) => {
          const courseLabel = s.course_code
            ? `${escapeHtml(s.course_code)}${s.course_name ? ` - ${escapeHtml(s.course_name)}` : ""}`
            : "Curso";
          const meta =
            `${escapeHtml(s.exam_type || "")}${s.cycle ? ` · ${escapeHtml(s.cycle)}` : ""}`.trim();
          const hint = s.teacher_hint ? escapeHtml(s.teacher_hint) : "";
          const badgeClass = s.is_hidden
            ? "bg-amber-600/20 text-amber-400 border-amber-600/30"
            : "bg-emerald-600/20 text-emerald-400 border-emerald-600/30";
          const toggleClass = s.is_hidden
            ? "bg-emerald-600/20 text-emerald-400 border border-emerald-600/30 hover:bg-emerald-600/30"
            : "bg-amber-600/20 text-amber-400 border border-amber-600/30 hover:bg-amber-600/30";
          const toggleLabel = s.is_hidden ? "Mostrar" : "Ocultar";

          return `
                        <div class="rounded-xl bg-global-bg border border-global-border p-4 flex flex-col md:flex-row md:items-center justify-between gap-3 ${s.is_hidden ? "opacity-70" : ""}" data-sheet-card="${s.id}">
                            <!-- Info de la plancha (Diseño original limpio) -->
                            <div class="min-w-0 flex-1">
                                <div class="text-sm text-global-text-muted truncate" title="${courseLabel}">
                                    ${courseLabel}
                                </div>
                                <div class="text-base font-semibold text-global-text truncate" title="${meta}">
                                    ${meta}
                                </div>
                                ${hint ? `<div class="text-xs text-global-text-muted truncate mt-0.5">Docente: ${hint}</div>` : ""}
                            </div>

                            <!-- Estado y Botones de acción -->
                            <div class="flex items-center justify-between md:justify-end gap-2.5 shrink-0 pt-2 md:pt-0">
                                <span class="sheet-status-badge inline-flex items-center gap-1.5 px-2.5 py-1 text-[11px] font-semibold rounded-full border transition-colors shrink-0 ${badgeClass}">
                                    <span class="w-1.5 h-1.5 rounded-full shrink-0 ${s.is_hidden ? "bg-amber-500" : "bg-emerald-500"}"></span>
                                    ${s.is_hidden ? "OCULTA" : "VISIBLE"}
                                </span>

                                <div class="flex items-center gap-1.5">
                                    <button
                                        type="button"
                                        class="toggle-sheet-btn inline-flex items-center justify-center shrink-0 transition-all cursor-pointer font-semibold shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-offset-global-bg active:scale-95 disabled:opacity-50 disabled:cursor-not-allowed px-3 py-1.5 text-xs rounded-lg gap-1.5 ${toggleClass}"
                                        data-sheet-id="${s.id}"
                                        data-next-hidden="${s.is_hidden ? "false" : "true"}"
                                        title="${toggleLabel}"
                                        aria-label="${toggleLabel}"
                                    >
                                        ${toggleLabel}
                                    </button>
                                    <a
                                        href="/exams/${s.id}"
                                        class="inline-flex items-center justify-center shrink-0 transition-all cursor-pointer font-semibold shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-offset-global-bg active:scale-95 disabled:opacity-50 disabled:cursor-not-allowed px-3 py-1.5 text-xs rounded-lg gap-1.5 bg-gray-800 text-global-text hover:bg-gray-700 border border-gray-600 focus:ring-gray-500"
                                        target="_blank"
                                        rel="noreferrer"
                                        title="Ver detalles"
                                        aria-label="Ver detalles"
                                    >
                                        Ver
                                    </a>
                                    <button
                                        type="button"
                                        class="delete-sheet-btn inline-flex items-center justify-center shrink-0 transition-all cursor-pointer font-semibold shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-offset-global-bg active:scale-95 disabled:opacity-50 disabled:cursor-not-allowed px-3 py-1.5 text-xs rounded-lg gap-1.5 bg-red-600/20 text-red-400 border border-red-600/30 hover:bg-red-600/30"
                                        data-sheet-id="${s.id}"
                                        title="Eliminar permanentemente"
                                        aria-label="Eliminar permanentemente"
                                    >
                                        Eliminar
                                    </button>
                                </div>
                            </div>
                        </div>
                    `;
        })
        .join("");

      const totalPages = Number(data?.pagination?.totalPages || 0);

      if (totalPages > 1) {
        const prevDisabled = page <= 1;
        const nextDisabled = page >= totalPages;

        paginationEl.innerHTML = `
                <div class="text-sm text-global-text-muted">Página ${page} de ${totalPages}</div>
                <div class="flex gap-2">
                    <button
                        ${prevDisabled ? "disabled" : ""}
                        id="sheets-prev"
                        class="rounded-lg bg-global-card border border-global-border px-3 py-2 text-sm font-medium text-global-text transition hover:bg-global-border cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
                    >
                        Anterior
                    </button>
                    <button
                        ${nextDisabled ? "disabled" : ""}
                        id="sheets-next"
                        class="rounded-lg bg-global-card border border-global-border px-3 py-2 text-sm font-medium text-global-text transition hover:bg-global-border cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
                    >
                        Siguiente
                    </button>
                </div>
            `;
      }
    }
  }

  void loadSheets(1);
</script>
