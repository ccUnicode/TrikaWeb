        if (!res.ok || !data?.ok) {
          if (courseSearchInput)
            courseSearchInput.placeholder = "No se pudieron cargar cursos";
          return;
        }

        allCourses = data.courses || [];

        if (!allCourses.length) {
          if (courseSearchInput)
            courseSearchInput.placeholder = "No hay cursos disponibles";
          return;
        }

        if (courseSearchInput) {
          courseSearchInput.placeholder = "Buscar curso (ej. Física, BFI01)...";
          courseSearchInput.removeAttribute("disabled");
