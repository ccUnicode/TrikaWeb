    /**
     * Flujo de subida completo:
     * 1. Obtener URL firmada via /api/admin/upload-url
     * 2. Generar miniatura con PDF.js (si es plancha)
     * 3. Subir PDF(s) a Storage (PUT a signed URL)
     * 4. Subir miniatura a Storage
     * 5. Registrar metadatos en DB via /api/admin/upload
     * 6. Resetear formulario y mostrar resultado
     */

    type ResourceKind = "PLANCHA" | "SOLUCIONARIO" | "AMBOS";

    interface UploadUrlResponse {
      ok?: boolean;
      error?: string;
      signedUrl?: string;
      solutionSignedUrl?: string;
      thumbSignedUrl?: string;
      thumbPath?: string;
      uploadSessionId?: string | null;
    }

    interface UploadRegistrationResponse {
      ok?: boolean;
      error?: string;
      message?: string;
    }

    /**
     * Sube un objeto utilizando una URL firmada.
     *
     * Los errores se convierten en false para permitir que, en AMBOS,
     * se invoque upload.ts y el servidor limpie la sesión incompleta.
     */
    async function uploadToSignedUrl(
      signedUrl: string,
      file: Blob,
      contentType: string,
    ): Promise<boolean> {
      try {
        const response = await fetch(signedUrl, {
          method: "PUT",
          headers: {
            "Content-Type": contentType,
          },
          body: file,
        });

        if (!response.ok) {
          const errorText = await response.text().catch(() => "");

          console.error("Error al subir archivo a Storage:", {
            status: response.status,
            errorText,
          });

          return false;
        }

        return true;
      } catch (error) {
        console.error("Error de red al subir archivo a Storage:", error);

        return false;
      }
    }

    uploadForm?.addEventListener("submit", async (e) => {
      e.preventDefault();

      const formData = new FormData(uploadForm);
      const courseId = Number(formData.get("course_id") ?? 0);
      const cycle = String(formData.get("cycle") ?? "").trim();
      const evaluationId = Number(formData.get("evaluation_id") ?? 0);
      const teacherId = Number(formData.get("teacher_id") ?? 0);
      const isTeacherSpecific = teacherSpecificCheckbox?.checked ?? false;
      const rawFile = formData.get("file");
      const rawSolutionFile = formData.get("solution_file");

      const file = rawFile instanceof File && rawFile.size > 0 ? rawFile : null;
      const solutionFile =
        rawSolutionFile instanceof File && rawSolutionFile.size > 0
          ? rawSolutionFile
          : null;

      const hasPlancha = file !== null;
      const hasSolution = solutionFile !== null;

      let resourceKind: ResourceKind = "PLANCHA";

      if (hasPlancha && hasSolution) {
        resourceKind = "AMBOS";
      } else if (hasPlancha) {
        resourceKind = "PLANCHA";
      } else if (hasSolution) {
        resourceKind = "SOLUCIONARIO";
      }

      if (
        !Number.isSafeInteger(courseId) ||
        courseId <= 0 ||
        !cycle ||
        !Number.isSafeInteger(evaluationId) ||
        evaluationId <= 0
      ) {
        alert(
          "Por favor completa los metadatos del curso, ciclo y evaluación.",
        );
        return;
      }

      if (!hasPlancha && !hasSolution) {
        alert(
          "Debes seleccionar al menos un archivo (PDF de la plancha o del solucionario).",
        );
        return;
      }

      // Validar teacher_id cuando se activa la plancha específica.
      if (
        isTeacherSpecific &&
        (!Number.isSafeInteger(teacherId) || teacherId <= 0)
      ) {
        alert(
          "Debes seleccionar un docente válido para una plancha de profesor específico.",
        );

        teacherSearchInput?.focus();

        return;
      }

      submitBtn?.setAttribute("disabled", "true");

      try {
        // Step 1: Get signed upload URL
        setUploadUI("Obteniendo URL de subida...", 10);

        const urlRes = await fetch("/api/admin/upload-url", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            course_id: courseId,
            cycle,
            evaluation_id: evaluationId,
            resource_kind: resourceKind,
            teacher_id: isTeacherSpecific ? teacherId : null,
            is_teacher_specific: isTeacherSpecific,
          }),
        });

        const urlData = (await urlRes
          .json()
          .catch(() => null)) as UploadUrlResponse | null;

        if (!urlRes.ok || !urlData?.ok) {
          setUploadUI(
            `❌ ${urlData?.error ?? "No se pudo preparar la subida"}`,
            0,
            false,
          );

          submitBtn?.removeAttribute("disabled");
          return;
        }

        if (typeof urlData.signedUrl !== "string") {
          console.error(
            "upload-url no devolvió una URL principal válida:",
            urlData,
          );

          setUploadUI("❌ No se recibió una URL de subida válida", 0, false);

          submitBtn?.removeAttribute("disabled");
          return;
        }

        const uploadSessionId =
          resourceKind === "AMBOS" &&
          typeof urlData.uploadSessionId === "string"
            ? urlData.uploadSessionId
            : null;

        if (
          resourceKind === "AMBOS" &&
          (!uploadSessionId || typeof urlData.solutionSignedUrl !== "string")
        ) {
          console.error("Contrato inválido para una subida conjunta:", urlData);

          setUploadUI("❌ No se pudo inicializar la subida conjunta", 0, false);

          submitBtn?.removeAttribute("disabled");
          return;
        }

        // Step 1.5: Generate Thumbnail (if PLANCHA or AMBOS)
        let thumbBlob: Blob | null = null;
        if (resourceKind === "PLANCHA" || resourceKind === "AMBOS") {
          setUploadUI("Generando miniatura de la 1ª página...", 20);
          if (file) {
            thumbBlob = await generatePdfThumbnail(file);
          }
        }

        // Step 2: Upload plancha PDF directly to Storage (If present)
        let combinedUploadHadFailure = false;
        if (resourceKind === "PLANCHA" || resourceKind === "AMBOS") {
          setUploadUI("Subiendo plancha a Storage...", 40);

          const planchaUploaded =
            file instanceof File &&
            (await uploadToSignedUrl(
              urlData.signedUrl,
              file,
              "application/pdf",
            ));

          if (!planchaUploaded) {
            if (resourceKind === "AMBOS") {
              /*
               * No se retorna todavía. upload.ts comprobará que la sesión
               * está incompleta y eliminará sus objetos temporales.
               */
              combinedUploadHadFailure = true;
            } else {
              setUploadUI("❌ Error al subir la plancha a Storage", 40, false);

              submitBtn?.removeAttribute("disabled");
              return;
            }
          }
        }

        // Step 2.5: Upload Solution PDF if present
        if (
          !combinedUploadHadFailure &&
          (resourceKind === "SOLUCIONARIO" || resourceKind === "AMBOS")
        ) {
          setUploadUI("Subiendo solucionario a Storage...", 50);

          const solutionSignedUrl =
            resourceKind === "AMBOS"
              ? urlData.solutionSignedUrl
              : urlData.signedUrl;

          const solutionUploaded =
            typeof solutionSignedUrl === "string" &&
            solutionFile !== null &&
            (await uploadToSignedUrl(
              solutionSignedUrl,
              solutionFile,
              "application/pdf",
            ));

          if (!solutionUploaded) {
            if (resourceKind === "AMBOS") {
              combinedUploadHadFailure = true;
            } else {
              setUploadUI("❌ Error al subir el solucionario", 50, false);

              submitBtn?.removeAttribute("disabled");
              return;
            }
          }
        }

        // Step 2.8: Upload Thumbnail
        let thumbnailUploaded = false;

        if (
          !combinedUploadHadFailure &&
          (resourceKind === "PLANCHA" || resourceKind === "AMBOS") &&
          thumbBlob &&
          typeof urlData.thumbSignedUrl === "string"
        ) {
          setUploadUI("Subiendo miniatura...", 60);

          thumbnailUploaded = await uploadToSignedUrl(
            urlData.thumbSignedUrl,
            thumbBlob,
            "image/jpeg",
          );

          if (!thumbnailUploaded) {
            console.error(
              "No se pudo subir la miniatura. La operación continuará sin ella.",
            );
          }
        }

        // Step 3: Register metadata in DB
        setUploadUI(
          combinedUploadHadFailure
            ? "Validando y limpiando la subida incompleta..."
            : "Registrando en la base de datos...",
          80,
        );

        const regRes = await fetch("/api/admin/upload", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            course_id: courseId,
            cycle,
            evaluation_id: evaluationId,
            resource_kind: resourceKind,

            upload_session_id:
              resourceKind === "AMBOS" ? uploadSessionId : undefined,

            has_thumb_upload: thumbnailUploaded,

            teacher_id: isTeacherSpecific ? teacherId : null,

            is_teacher_specific: isTeacherSpecific,
          }),
        });

        const regData = (await regRes
          .json()
          .catch(() => null)) as UploadRegistrationResponse | null;

        if (!regRes.ok || !regData?.ok) {
          setUploadUI(
            `⚠️ ${
              regData?.error ?? "No se pudo completar el registro de la subida"
            }`,
            80,
            false,
          );

          submitBtn?.removeAttribute("disabled");
          return;
        }

        // Success!
        setUploadUI(`${regData.message}`, 100, false);
        uploadForm.reset();
        if (fileNameEl) fileNameEl.textContent = "Sin archivo";
        if (solutionFileNameEl) solutionFileNameEl.textContent = "Sin archivo";

        // Reset fields
        resetTeacherSelection("Ingresa un curso primero");
        lastFetchedCode = "";
        activeCourseId = null;
        resetEvaluationSelection("Selecciona primero un curso");
        if (courseSearchInput) courseSearchInput.value = "";
        // Reset year/term UI
        yearHidden.value = "";
        yearDisplay.value = "";
        yearCustom.value = "";
        yearCustom.classList.add("hidden");
        termHidden.value = "";
        termDisplay.value = "";
        cycleCodeHidden.value = "";

        if (courseIdHidden) courseIdHidden.value = "";
        if (courseCodeHidden) courseCodeHidden.value = "";
        courseDropdown?.classList.add("hidden");

        // Reset toggle UI after form reset
        updateTeacherSpecificUI();

        // Auto-hide success message after 4 seconds
        setTimeout(() => resetUploadUI(), 4000);
      } catch (err) {
        console.error("Upload error:", err);
        setUploadUI(`Error de red: ${err}`, 0, false);
        submitBtn?.removeAttribute("disabled");
      }
    });
  </script>

  <script>
    /*
    RF-04: Carga y muestra las planchas más solicitadas (solucionarios pedidos).
    Permite al admin ver el ranking de solicitudes y reiniciar contadores.
    */
    import { supabaseClient } from "../../lib/supabase.client";

    const interestsList = document.getElementById("interests-list");
    const interestsLoading = document.getElementById("interests-loading");
    const interestsEmpty = document.getElementById("interests-empty");
    const refreshInterestsBtn = document.getElementById(
      "refresh-interests-btn",
    );

    async function loadTopInterests() {
      if (interestsLoading) interestsLoading.classList.remove("hidden");
      if (interestsEmpty) interestsEmpty.classList.add("hidden");
      if (interestsList) {
        // Keep only the loading div
        const children = Array.from(interestsList.children);
        children.forEach((child) => {
          if (child.id !== "interests-loading") child.remove();
        });
      }

      try {
        const { data, error } = await supabaseClient
          .from("sheets")
          .select(
            "id, exam_type, cycle, interest_count, solution_kind, courses:course_id (code, name)",
          )
          .is("solution_kind", null)
          .gt("interest_count", 0)
          .order("interest_count", { ascending: false })
          .limit(10);

        if (interestsLoading) interestsLoading.classList.add("hidden");

        if (error) {
          console.error("Error loading interests:", error);
          if (interestsList) {
            const errorMessage = document.createElement("div");
            errorMessage.className = "text-center text-red-400 py-4 text-sm";
            errorMessage.textContent =
              "No se pudieron cargar las solicitudes de solucionario.";
            interestsList.appendChild(errorMessage);
          }
          return;
        }

        if (!data || data.length === 0) {
          if (interestsEmpty) interestsEmpty.classList.remove("hidden");
          return;
        }

        interface InterestSheet {
          id: number;
          exam_type: string;
          cycle: string;
          interest_count: number;
          solution_kind: string | null;
          courses:
            { code: string; name: string } | { code: string; name: string }[];
        }

        // Render the list
        if (interestsList) {
          // Remove all children except loading
          const children = Array.from(interestsList.children);
          children.forEach((child) => {
            if (child.id !== "interests-loading") child.remove();
          });

          (data as InterestSheet[]).forEach((sheet, index: number) => {
            const course = Array.isArray(sheet.courses)
              ? sheet.courses[0]
              : sheet.courses;
            const courseCode = course?.code ?? "N/A";
            const courseName = course?.name ?? "";
            const count = sheet.interest_count ?? 0;

            // Container
            const container = document.createElement("div");
            container.className =
              "flex items-center gap-4 p-3 rounded-xl bg-global-bg border border-global-border group";

            // Link
            const link = document.createElement("a");
            link.href = `/exams/${sheet.id}`;
            link.target = "_blank";
            link.className =
              "flex items-center gap-4 flex-1 min-w-0 hover:opacity-80 transition-opacity";

            // Rank badge
            const rankBadge = document.createElement("span");
            rankBadge.className =
              "flex items-center justify-center w-8 h-8 rounded-full bg-global-primary/10 text-global-primary font-bold text-sm shrink-0";
            rankBadge.textContent = String(index + 1);

            // Text div
            const textDiv = document.createElement("div");
            textDiv.className = "flex-1 min-w-0";

            const titleP = document.createElement("p");
            titleP.className =
              "text-sm font-semibold text-global-text group-hover:text-global-primary transition-colors truncate";
            titleP.textContent = `${courseCode} — ${sheet.exam_type} ${sheet.cycle}`;

            const nameP = document.createElement("p");
            nameP.className = "text-xs text-global-text-muted truncate";
            nameP.textContent = courseName;

            textDiv.appendChild(titleP);
            textDiv.appendChild(nameP);
            link.appendChild(rankBadge);
            link.appendChild(textDiv);
            container.appendChild(link);

            // Right section
            const rightDiv = document.createElement("div");
            rightDiv.className = "flex items-center gap-3 shrink-0";

            // Count badge
            const countDiv = document.createElement("div");
            countDiv.className = "flex items-center gap-1.5";

            const countSvg = document.createElementNS(
              "http://www.w3.org/2000/svg",
              "svg",
            );
            countSvg.setAttribute("class", "h-4 w-4 text-global-primary");
            countSvg.setAttribute("viewBox", "0 0 24 24");
            countSvg.setAttribute("fill", "none");
            countSvg.setAttribute("stroke", "currentColor");
            countSvg.setAttribute("stroke-width", "2");
            countSvg.setAttribute("stroke-linecap", "round");
            countSvg.setAttribute("stroke-linejoin", "round");
            const countPath1 = document.createElementNS(
              "http://www.w3.org/2000/svg",
              "path",
            );
            countPath1.setAttribute(
              "d",
              "M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2",
            );
            const countPath2 = document.createElementNS(
              "http://www.w3.org/2000/svg",
              "rect",
            );
            countPath2.setAttribute("x", "8");
            countPath2.setAttribute("y", "2");
            countPath2.setAttribute("width", "8");
            countPath2.setAttribute("height", "4");
            countPath2.setAttribute("rx", "1");
            countPath2.setAttribute("ry", "1");
            const countPath3 = document.createElementNS(
              "http://www.w3.org/2000/svg",
              "path",
            );
            countPath3.setAttribute("d", "m9 14 2 2 4-4");
            countSvg.appendChild(countPath1);
            countSvg.appendChild(countPath2);
            countSvg.appendChild(countPath3);

            const countSpan = document.createElement("span");
            countSpan.className = "text-sm font-bold text-global-primary";
            countSpan.textContent = String(count);

            countDiv.appendChild(countSvg);
            countDiv.appendChild(countSpan);

            // Reset button
            const resetBtn = document.createElement("button");
            resetBtn.type = "button";
            resetBtn.dataset.resetSheetId = String(sheet.id);
            resetBtn.title = "Reiniciar contador";
            resetBtn.className =
              "p-1.5 rounded-lg text-global-text-muted hover:text-red-400 hover:bg-red-400/10 transition-colors cursor-pointer opacity-0 group-hover:opacity-100";

            const resetSvg = document.createElementNS(
              "http://www.w3.org/2000/svg",
              "svg",
            );
            resetSvg.setAttribute("class", "h-4 w-4");
            resetSvg.setAttribute("viewBox", "0 0 24 24");
            resetSvg.setAttribute("fill", "none");
            resetSvg.setAttribute("stroke", "currentColor");
            resetSvg.setAttribute("stroke-width", "2");
            resetSvg.setAttribute("stroke-linecap", "round");
            resetSvg.setAttribute("stroke-linejoin", "round");
            const rp1 = document.createElementNS(
              "http://www.w3.org/2000/svg",
              "path",
            );
            rp1.setAttribute("d", "M3 6h18");
            const rp2 = document.createElementNS(
              "http://www.w3.org/2000/svg",
              "path",
            );
            rp2.setAttribute("d", "M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2");
            const rp3 = document.createElementNS(
              "http://www.w3.org/2000/svg",
              "path",
            );
            rp3.setAttribute("d", "M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6");
            resetSvg.appendChild(rp1);
            resetSvg.appendChild(rp2);
            resetSvg.appendChild(rp3);
            resetBtn.appendChild(resetSvg);

            rightDiv.appendChild(countDiv);
            rightDiv.appendChild(resetBtn);
            container.appendChild(rightDiv);
            interestsList.appendChild(container);

            // Attach reset handler
            resetBtn.addEventListener("click", async (e) => {
              e.preventDefault();
              e.stopPropagation();
              const sheetId = (resetBtn as HTMLElement).dataset.resetSheetId;
              if (
                !sheetId ||
                !confirm(
                  "¿Reiniciar el contador de solicitudes para esta plancha?",
                )
              )
                return;

              resetBtn.disabled = true;
              try {
                const res = await fetch("/api/admin/reset-interest", {
                  method: "POST",
                  headers: { "Content-Type": "application/json" },
                  body: JSON.stringify({ sheet_id: Number(sheetId) }),
                });
                if (!res.ok) throw new Error(`HTTP ${res.status}`);
                const data = await res.json();
                if (data.ok) {
                  loadTopInterests();
                } else {
                  alert(data.error || "Error al reiniciar");
                }
              } catch (err) {
                console.error("Reset error:", err);
                alert("Error de red al reiniciar contador");
              }
            });
          });
        }
      } catch (err) {
        if (interestsLoading) interestsLoading.classList.add("hidden");
        console.error("Error:", err);
      }
    }

    refreshInterestsBtn?.addEventListener("click", loadTopInterests);
    loadTopInterests();
  </script>
</Layout>
