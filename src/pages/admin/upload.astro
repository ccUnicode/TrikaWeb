        }
      }, 150);
    });

    document.addEventListener("DOMContentLoaded", () => {
      loadCourseOptions();
      loadCycles();
    });

    // Load PDF.js dynamically
    async function loadPdfJs() {
      if ((window as any).pdfjsLib) return (window as any).pdfjsLib;
      return new Promise((resolve, reject) => {
        const script = document.createElement("script");
        script.src =
          "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js";
        script.onload = () => {
          const pdfjsLib = (window as any).pdfjsLib;
          pdfjsLib.GlobalWorkerOptions.workerSrc =
            "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js";
          resolve(pdfjsLib);
        };
        script.onerror = reject;
        document.head.appendChild(script);
      });
    }

    async function generatePdfThumbnail(file: File): Promise<Blob | null> {
      try {
        const pdfjsLib = await loadPdfJs();
        const arrayBuffer = await file.arrayBuffer();
        const pdf = await pdfjsLib.getDocument(arrayBuffer).promise;
        const page = await pdf.getPage(1);

        // Adjust scale as needed for quality vs size (1.5 gives good resolution)
        const viewport = page.getViewport({ scale: 1.5 });

        const canvas = document.createElement("canvas");
        const ctx = canvas.getContext("2d");
        if (!ctx) return null;

        canvas.height = viewport.height;
        canvas.width = viewport.width;

        await page.render({ canvasContext: ctx, viewport }).promise;

        return new Promise((resolve) => {
          canvas.toBlob((blob) => resolve(blob), "image/jpeg", 0.85);
        });
      } catch (e) {
        console.error("Error generating thumbnail:", e);
        return null;
      }
    }

    function setUploadUI(msg: string, pct: number, showSpinner = true) {
      uploadStatus?.classList.remove("hidden");
      if (uploadMessage) uploadMessage.textContent = msg;
      if (uploadProgress) uploadProgress.style.width = `${pct}%`;
      if (showSpinner) {
        uploadSpinner?.classList.remove("hidden");
      } else {
        uploadSpinner?.classList.add("hidden");
      }
    }

    function resetUploadUI() {
      uploadStatus?.classList.add("hidden");
      if (uploadProgress) uploadProgress.style.width = "0%";
      submitBtn?.removeAttribute("disabled");
    }

    uploadForm?.addEventListener("submit", async (e) => {
      e.preventDefault();

      const formData = new FormData(uploadForm);
      const courseId = Number(formData.get("course_id") ?? 0);
      const courseCode = String(formData.get("course_code") ?? "").trim();
      const cycle = String(formData.get("cycle") ?? "").trim();
      const evaluationId = Number(formData.get("evaluation_id") ?? 0);
      const teacherHint = String(formData.get("teacher_hint") ?? "").trim();
      const isTeacherSpecific = teacherSpecificCheckbox?.checked ?? false;
      const file = (formData.get("file") as File) || null;
      const solutionFile = (formData.get("solution_file") as File) || null;

      console.log({
        courseId,
        courseCode,
        cycle,
        evaluationId,
        teacherHint,
        isTeacherSpecific,
        file,
        fileName: file?.name,
        fileSize: file?.size,
      });

      let resourceKind = "PLANCHA";
      const hasPlancha = file && file.size > 0;
      const hasSolution = solutionFile && solutionFile.size > 0;

      if (hasPlancha && hasSolution) {
        resourceKind = "AMBOS";
      } else if (hasPlancha) {
        resourceKind = "PLANCHA";
      } else if (hasSolution) {
        resourceKind = "SOLUCIONARIO";
      }

      if (!courseId || !courseCode || !cycle || !evaluationId) {
        alert(
          "Por favor completa los metadatos del curso, ciclo y evaluación.",
        );
        return;
      }

      if (!hasPlancha && !hasSolution) {
        alert(
          "Debes seleccionar al menos un archivo (PDF de la plancha o del solucionario).",
        );
        return;
      }

      // Validate teacher_hint when teacher-specific is enabled
      if (isTeacherSpecific && !teacherHint) {
        alert(
          "Debes indicar el docente para una plancha de profesor específico.",
        );
        teacherSearchInput?.focus();
        return;
      }

      submitBtn?.setAttribute("disabled", "true");

      try {
        // Step 1: Get signed upload URL
        setUploadUI("Obteniendo URL de subida...", 10);

        const urlRes = await fetch("/api/admin/upload-url", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            course_id: courseId,
            course_code: courseCode,
            cycle,
            evaluation_id: evaluationId,
            resource_kind: resourceKind,
            teacher_hint: teacherHint,
            is_teacher_specific: isTeacherSpecific,
          }),
        });

        const urlData = await urlRes.json();
        if (!urlData.ok) {
          setUploadUI(`❌ ${urlData.error}`, 0, false);
          submitBtn?.removeAttribute("disabled");
          return;
        }

        // Step 1.5: Generate Thumbnail (if PLANCHA or AMBOS)
        let thumbBlob: Blob | null = null;
        if (resourceKind === "PLANCHA" || resourceKind === "AMBOS") {
          setUploadUI("Generando miniatura de la 1ª página...", 20);
          thumbBlob = await generatePdfThumbnail(file);
        }

        // Step 2: Upload plancha PDF directly to Storage (If present)
        if (resourceKind === "PLANCHA" || resourceKind === "AMBOS") {
          setUploadUI("Subiendo plancha a Storage...", 40);

          const uploadRes = await fetch(urlData.signedUrl, {
            method: "PUT",
            headers: { "Content-Type": "application/pdf" },
            body: file,
          });

          if (!uploadRes.ok) {
            const errText = await uploadRes.text();
            console.error("Storage upload failed:", errText);
            setUploadUI("❌ Error al subir la plancha a Storage", 40, false);
            submitBtn?.removeAttribute("disabled");
            return;
          }
        }

        // Step 2.5: Upload Solution PDF if present
        if (resourceKind === "SOLUCIONARIO" || resourceKind === "AMBOS") {
          const solUrl =
            resourceKind === "AMBOS"
              ? urlData.solutionSignedUrl
              : urlData.signedUrl;

          if (solUrl && solutionFile) {
            setUploadUI("Subiendo solucionario a Storage...", 50);

            const solutionUploadRes = await fetch(solUrl, {
              method: "PUT",
              headers: { "Content-Type": "application/pdf" },
              body: solutionFile,
            });

            if (!solutionUploadRes.ok) {
              console.error("Solution upload failed");
              setUploadUI("❌ Error al subir el solucionario", 50, false);
              submitBtn?.removeAttribute("disabled");
              return;
            }
          }
        }

        // Step 2.8: Upload Thumbnail
        let uploadedThumbPath: string | null = null;

        if (
          (resourceKind === "PLANCHA" || resourceKind === "AMBOS") &&
          thumbBlob &&
          urlData.thumbSignedUrl &&
          urlData.thumbPath
        ) {
          setUploadUI("Subiendo miniatura...", 60);

          const thumbRes = await fetch(urlData.thumbSignedUrl, {
            method: "PUT",
            headers: { "Content-Type": "image/jpeg" },
            body: thumbBlob,
          });

          if (!thumbRes.ok) {
            const t = await thumbRes.text().catch(() => "");
            console.error("Thumb upload failed:", thumbRes.status, t);
            uploadedThumbPath = null;
          } else {
            uploadedThumbPath = urlData.thumbPath;
          }
        }

        // Step 3: Register metadata in DB
        setUploadUI("Registrando en la base de datos...", 80);

        const regRes = await fetch("/api/admin/upload", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            course_id: urlData.courseId,
            cycle,
            evaluation_id: evaluationId,
            exam_type: urlData.examType,
            resource_kind: resourceKind,
            storage_path: urlData.path,
            teacher_hint: teacherHint,
            thumb_storage_path: uploadedThumbPath,
            solution_storage_path: urlData.solutionPath,
            is_teacher_specific: isTeacherSpecific,
          }),
        });

        const regData = await regRes.json();

        if (!regData.ok) {
          setUploadUI(`⚠️ Archivo subido, pero: ${regData.error}`, 80, false);
          submitBtn?.removeAttribute("disabled");
          return;
        }

        // Success!
        setUploadUI(`✅ ${regData.message}`, 100, false);
        uploadForm.reset();
        if (fileNameEl) fileNameEl.textContent = "Sin archivo";
        if (solutionFileNameEl) solutionFileNameEl.textContent = "Sin archivo";

        // Reset fields
        resetTeacherSelection("Ingresa un curso primero");
        lastFetchedCode = "";
        resetEvaluationSelection("Selecciona primero un curso");
        if (courseSearchInput) courseSearchInput.value = "";
        if (courseIdHidden) courseIdHidden.value = "";
        if (courseCodeHidden) courseCodeHidden.value = "";
        courseDropdown?.classList.add("hidden");

        if (cycleSearchInput) cycleSearchInput.value = "";
        if (cycleCodeHidden) cycleCodeHidden.value = "";
        cycleDropdown?.classList.add("hidden");

        // Reset toggle UI after form reset
        updateTeacherSpecificUI();

        // Auto-hide success message after 4 seconds
        setTimeout(() => resetUploadUI(), 4000);
      } catch (err) {
        console.error("Upload error:", err);
        setUploadUI(`❌ Error de red: ${err}`, 0, false);
        submitBtn?.removeAttribute("disabled");
      }
    });
  </script>

  <script>
    // RF-04: Load most requested solucionarios
    import { supabaseClient } from "../../lib/supabase.client";

    const interestsList = document.getElementById("interests-list");
    const interestsLoading = document.getElementById("interests-loading");
    const interestsEmpty = document.getElementById("interests-empty");
    const refreshInterestsBtn = document.getElementById(
      "refresh-interests-btn",
    );

    async function loadTopInterests() {
      if (interestsLoading) interestsLoading.classList.remove("hidden");
      if (interestsEmpty) interestsEmpty.classList.add("hidden");
      if (interestsList) {
        // Keep only the loading div
        const children = Array.from(interestsList.children);
        children.forEach((child) => {
          if (child.id !== "interests-loading") child.remove();
        });
      }

      try {
        const { data, error } = await supabaseClient
          .from("sheets")
          .select(
            "id, exam_type, cycle, interest_count, solution_kind, courses:course_id (code, name)",
          )
          .is("solution_kind", null)
          .gt("interest_count", 0)
          .order("interest_count", { ascending: false })
          .limit(10);

        if (interestsLoading) interestsLoading.classList.add("hidden");

        if (error) {
          console.error("Error loading interests:", error);
          if (interestsList) {
            interestsList.innerHTML = `<div class="text-center text-red-400 py-4 text-sm">${error.message}</div>`;
          }
          return;
        }

        if (!data || data.length === 0) {
          if (interestsEmpty) interestsEmpty.classList.remove("hidden");
          return;
        }

        // Render the list
        const html = data
          .map((sheet: any, index: number) => {
            const course = Array.isArray(sheet.courses)
              ? sheet.courses[0]
              : sheet.courses;
            const courseCode = course?.code ?? "N/A";
            const courseName = course?.name ?? "";
            const count = sheet.interest_count ?? 0;

            return `
            <div class="flex items-center gap-4 p-3 rounded-xl bg-global-bg border border-global-border group">
              <a href="/exams/${sheet.id}" target="_blank"
                 class="flex items-center gap-4 flex-1 min-w-0 hover:opacity-80 transition-opacity">
                <span class="flex items-center justify-center w-8 h-8 rounded-full bg-global-primary/10 text-global-primary font-bold text-sm shrink-0">
                  ${index + 1}
                </span>
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-semibold text-global-text group-hover:text-global-primary transition-colors truncate">
                    ${courseCode} — ${sheet.exam_type} ${sheet.cycle}
                  </p>
                  <p class="text-xs text-global-text-muted truncate">${courseName}</p>
                </div>
              </a>
              <div class="flex items-center gap-3 shrink-0">
                <div class="flex items-center gap-1.5">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-global-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2" />
                    <rect x="8" y="2" width="8" height="4" rx="1" ry="1" />
                    <path d="m9 14 2 2 4-4" />
                  </svg>
                  <span class="text-sm font-bold text-global-primary">${count}</span>
                </div>
                <button
                  type="button"
                  data-reset-sheet-id="${sheet.id}"
                  title="Reiniciar contador"
                  class="p-1.5 rounded-lg text-global-text-muted hover:text-red-400 hover:bg-red-400/10 transition-colors cursor-pointer opacity-0 group-hover:opacity-100"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 6h18" />
                    <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6" />
                  </svg>
                </button>
              </div>
            </div>
          `;
          })
          .join("");

        if (interestsList) {
          interestsList.innerHTML = html;

          // Attach reset handlers
          interestsList
            .querySelectorAll("[data-reset-sheet-id]")
            .forEach((btn) => {
              btn.addEventListener("click", async (e) => {
                e.preventDefault();
                e.stopPropagation();
                const sheetId = (btn as HTMLElement).dataset.resetSheetId;
                if (
                  !sheetId ||
                  !confirm(
                    "¿Reiniciar el contador de solicitudes para esta plancha?",
                  )
                )
                  return;

                (btn as HTMLButtonElement).disabled = true;
                try {
                  const res = await fetch("/api/admin/reset-interest", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ sheet_id: Number(sheetId) }),
                  });
                  if (!res.ok) throw new Error(`HTTP ${res.status}`);
                  const data = await res.json();
                  if (data.ok) {
                    loadTopInterests(); // Refresh the list
                  } else {
                    alert(data.error || "Error al reiniciar");
                  }
                } catch (err) {
                  console.error("Reset error:", err);
                  alert("Error de red al reiniciar contador");
                }
              });
            });
        }
      } catch (err) {
        if (interestsLoading) interestsLoading.classList.add("hidden");
        console.error("Error:", err);
      }
    }

    refreshInterestsBtn?.addEventListener("click", loadTopInterests);
    loadTopInterests();
  </script>
</Layout>
