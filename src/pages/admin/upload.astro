    ) {
      if (evaluationIdHidden) evaluationIdHidden.value = "";
      if (evaluationSearchInput) {
        evaluationSearchInput.value = "";
        evaluationSearchInput.placeholder = placeholder;
        evaluationSearchInput.setAttribute("disabled", "true");
      }
      if (evaluationDropdown) {
        evaluationDropdown.innerHTML = "";
        evaluationDropdown.classList.add("hidden");
      }
      allEvaluations = [];
    }

