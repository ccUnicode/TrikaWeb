    function updateTeacherSpecificUI() {
      const isActive = teacherSpecificCheckbox?.checked ?? false;

      // Show/hide info alert
      if (isActive) {
        teacherSpecificInfo?.classList.remove("hidden");
        teacherToggleWrapper?.classList.add("border-global-primary/50");
        teacherToggleWrapper?.classList.remove("border-global-border");
      } else {
        teacherSpecificInfo?.classList.add("hidden");
        teacherToggleWrapper?.classList.remove("border-global-primary/50");
        teacherToggleWrapper?.classList.add("border-global-border");
      }

      // Update teacher field required state and label
      if (teacherSearchInput) {
        teacherSearchInput.required = isActive;
        if (isActive) {
          teacherSearchInput.classList.add("border-global-primary/50");
        } else {
          teacherSearchInput.classList.remove("border-global-primary/50");
        }
      }
      if (teacherOptionalLabel) {
        teacherOptionalLabel.textContent = isActive
          ? "(requerido)"
          : "(opcional)";
        if (isActive) {
          teacherOptionalLabel.classList.add("text-global-primary");
          teacherOptionalLabel.classList.remove("text-global-text-muted");
        } else {
          teacherOptionalLabel.classList.remove("text-global-primary");
          teacherOptionalLabel.classList.add("text-global-text-muted");
        }
      }
    }

