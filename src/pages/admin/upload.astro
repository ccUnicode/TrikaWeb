        renderTeacherDropdown(allTeachers);
        teacherDropdown?.classList.remove("hidden");
      }
    });

    teacherSearchInput?.addEventListener("blur", () => {
      setTimeout(() => {
        if (teacherHintInput && !teacherHintInput.value) {
          teacherSearchInput.value = "";
