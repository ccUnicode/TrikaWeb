    let allCycles: string[] = [];

    async function loadCycles() {
      try {
        const res = await fetch("/api/admin/cycles");
        const data = await res.json();

        if (data.ok) {
          allCycles = data.cycles.map((c: any) => c.cycle_code);
        }
      } catch (e) {
        console.error("Error cargando ciclos:", e);
      }
    }

    async function loadCourseOptions() {
      try {
        const res = await fetch("/api/admin/course-options", {
          method: "GET",
          credentials: "include",
        });

        const data = await res.json().catch(() => null);

        if (!res.ok || !data?.ok) {
          if (courseSearchInput)
            courseSearchInput.placeholder = "No se pudieron cargar cursos";
          return;
        }

        allCourses = data.courses || [];

        if (!allCourses.length) {
          if (courseSearchInput)
            courseSearchInput.placeholder = "No hay cursos disponibles";
          return;
        }

        if (courseSearchInput) {
          courseSearchInput.placeholder = "Buscar curso (ej. Física, BFI01)...";
          courseSearchInput.removeAttribute("disabled");
        }
      } catch (e) {
        console.error(e);
        if (courseSearchInput)
          courseSearchInput.placeholder = "Error cargando cursos";
      }
    }

    async function loadEvaluationOptions(courseId: number) {
      if (!evaluationSearchInput) return;

      resetEvaluationSelection("Cargando evaluaciones...");

      try {
        const res = await fetch(
          `/api/admin/course-evaluations?course_id=${courseId}`,
          {
            method: "GET",
            credentials: "include",
          },
        );

        const data = await res.json().catch(() => null);

        if (!res.ok || !data?.ok) {
          resetEvaluationSelection("No se pudieron cargar evaluaciones");
          return;
        }

        const evaluations: EvaluationOption[] = data.evaluations || [];
        allEvaluations = evaluations;

        if (!evaluations.length) {
          resetEvaluationSelection(
            "Este curso no tiene evaluaciones registradas",
          );
          return;
        }

        evaluationSearchInput.removeAttribute("disabled");
        evaluationSearchInput.placeholder = "Buscar evaluación...";
        renderEvaluationDropdown(allEvaluations);
      } catch (error) {
        console.error("Error cargando evaluaciones:", error);
        resetEvaluationSelection("Error cargando evaluaciones");
      }
    }

    function renderCycleDropdown(cycles: string[]) {
      if (!cycleDropdown) return;

      cycleDropdown.innerHTML = "";

      cycles.forEach((cycle) => {
        const li = document.createElement("li");
        li.textContent = cycle;
        li.className =
          "px-4 py-2.5 hover:bg-black/30 hover:text-white cursor-pointer text-sm text-global-text transition-colors";

        li.addEventListener("click", () => {
          cycleCodeHidden.value = cycle;
          cycleSearchInput.value = cycle;
          cycleDropdown.classList.add("hidden");
        });

        cycleDropdown.appendChild(li);
      });
    }

    function renderCourseDropdown(coursesToRender: CourseOption[]) {
      if (!courseDropdown) return;
      if (coursesToRender.length === 0) {
        courseDropdown.innerHTML = `<li class="px-4 py-3 text-sm text-global-text-muted text-center cursor-default">No se encontraron cursos.</li>`;
        return;
      }

      courseDropdown.innerHTML = coursesToRender
        .map((c) => {
          const label = `${c.code} - ${c.name}`;
          return `<li data-id="${c.id}" data-code="${c.code}" data-label="${label}" class="px-4 py-2.5 hover:bg-black/30 hover:text-white cursor-pointer text-sm text-global-text transition-colors">${label}</li>`;
        })
        .join("");

      const items = courseDropdown.querySelectorAll("li[data-code]");
      items.forEach((item) => {
        item.addEventListener("click", () => {
          const id = Number(item.getAttribute("data-id") || "0");
          const code = item.getAttribute("data-code") || "";
          const label = item.getAttribute("data-label") || "";

          if (courseIdHidden) courseIdHidden.value = String(id);
          if (courseCodeHidden) courseCodeHidden.value = code;
          if (courseSearchInput) courseSearchInput.value = label;

          if (id > 0) {
            loadEvaluationOptions(id);
          }

          courseDropdown.classList.add("hidden");
          loadTeachersByCourse(code);
        });
      });
    }

    function renderEvaluationDropdown(evaluationsToRender: EvaluationOption[]) {
      if (!evaluationDropdown) return;

      if (evaluationsToRender.length === 0) {
        evaluationDropdown.innerHTML = `<li class="px-4 py-3 text-sm text-global-text-muted text-center cursor-default">No se encontraron evaluaciones.</li>`;
        return;
      }

      evaluationDropdown.innerHTML = evaluationsToRender
        .map((ev) => {
          const label = `${ev.evaluation_abr} - ${ev.evaluation_name}`;
          return `<li data-id="${ev.evaluation_id}" data-label="${label}" class="px-4 py-2.5 hover:bg-black/30 hover:text-white cursor-pointer text-sm text-global-text transition-colors">${label}</li>`;
        })
        .join("");

      const items = evaluationDropdown.querySelectorAll("li[data-id]");
      items.forEach((item) => {
        item.addEventListener("click", () => {
          const id = Number(item.getAttribute("data-id") || "0");
          const label = item.getAttribute("data-label") || "";

          if (evaluationIdHidden) evaluationIdHidden.value = String(id);
          if (evaluationSearchInput) evaluationSearchInput.value = label;

          evaluationDropdown.classList.add("hidden");
        });
      });
    }

    function resetEvaluationSelection(
