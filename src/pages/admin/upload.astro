          courseSearchInput.value = "";
        }
      }, 150);
    });

    evaluationSearchInput?.addEventListener("input", (e) => {
      const query = (e.target as HTMLInputElement).value.toLowerCase();

      if (evaluationIdHidden) evaluationIdHidden.value = "";

      const filtered = allEvaluations.filter(
        (ev) =>
          ev.evaluation_abr.toLowerCase().includes(query) ||
          ev.evaluation_name.toLowerCase().includes(query),
      );

      renderEvaluationDropdown(filtered);
