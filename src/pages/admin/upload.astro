---
/*
Panel de subida de material (admin).
Permite:
  - Subir planchas, solucionarios o ambos simultáneamente
  - Seleccionar curso mediante combobox con búsqueda
  - Seleccionar ciclo (año + término)
  - Seleccionar tipo de evaluación (PC1, EP, EF, etc.)
  - Indicar docente específico (is_teacher_specific)
  - Generar miniatura automática de la 1ª página del PDF
  - Visualizar planchas más solicitadas (intereses) y reiniciar contadores
*/
import Layout from "../../layouts/Layout.astro";
import AdminHeader from "../../components/AdminHeader.astro";
import { validateAdminSession } from "../../lib/adminAuth";

const isAdmin = await validateAdminSession(Astro.cookies);
if (!isAdmin) {
  return Astro.redirect("/admin/login");
}

const currentYear = new Date().getFullYear();
const years = Array.from({ length: 5 }, (_, i) => currentYear - i);
---

<Layout title="Admin – Subir material | TrikaWeb">
  <div class="min-h-screen py-8">
    <div class="mx-auto w-full max-w-3xl px-4">
      <!-- Header Section -->
      <AdminHeader
        title="Panel de subida"
        description="Sube PDFs de planchas y solucionarios"
      />

      <!-- Upload Form Card -->
      <section
        class="rounded-2xl bg-global-surface border border-global-border p-6 mb-6"
      >
        <h2 class="text-lg font-semibold text-global-text mb-4">
          Subir archivo
        </h2>

        <form id="upload-form" class="space-y-4">
          <!-- Row 1: Course Code & Cycle -->
          <div class="grid gap-4 sm:grid-cols-2 items-start">
            <div class="relative" id="course-combobox-container">
              <label
                class="block text-sm font-medium text-global-text-muted mb-1.5"
                for="course-search"
              >
                Curso
              </label>
              <div class="relative">
                <input type="hidden" id="course-id" name="course_id" required />

                <input
                  type="hidden"
                  id="course-code"
                  name="course_code"
                  required
                />
                <input
                  type="text"
                  id="course-search"
                  autocomplete="off"
                  class="w-full rounded-xl border border-global-border bg-global-card px-3 py-2.5 text-sm text-global-text outline-none focus:border-global-primary focus:ring-1 focus:ring-global-primary transition-colors placeholder-gray-500"
                  placeholder="Cargando cursos..."
                  required
                />
                <div
                  class="absolute inset-y-0 right-3 flex items-center pointer-events-none"
                >
                  <svg
                    class="h-4 w-4 text-global-text-muted"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M19 9l-7 7-7-7"></path>
                  </svg>
                </div>
                <ul
                  id="course-dropdown"
                  class="teacher-scroll absolute z-10 top-full left-0 mt-1 w-full max-h-60 overflow-auto rounded-xl border border-global-border bg-global-surface shadow-lg hidden"
                >
                </ul>
              </div>
            </div>
            <div class="flex gap-2 items-start">
              <div class="w-1/2 relative" id="year-combobox-container">
                <label
                  class="block text-sm font-medium text-global-text-muted mb-1.5"
                  for="year-display"
                >
                  Año
                </label>
                <div class="relative">
                  <input type="hidden" id="year-hidden" />
                  <input
                    type="text"
                    id="year-display"
                    readonly
                    class="w-full rounded-xl border border-global-border bg-global-card px-3 py-2.5 text-sm text-global-text outline-none focus:border-global-primary focus:ring-1 focus:ring-global-primary transition-colors cursor-pointer placeholder-gray-500"
                    placeholder="Selecciona"
                    required
                  />
                  <div
                    class="pointer-events-none absolute inset-y-0 right-3 flex items-center"
                  >
                    <svg
                      class="h-4 w-4 text-global-text-muted"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M19 9l-7 7-7-7"></path>
                    </svg>
                  </div>
                  <ul
                    id="year-dropdown"
                    class="teacher-scroll absolute z-10 top-full left-0 mt-1 w-full max-h-60 overflow-auto rounded-xl border border-global-border bg-global-surface shadow-lg hidden"
                  >
                    {
                      years.map((y) => (
                        <li
                          data-value={y}
                          class="px-4 py-2.5 hover:bg-black/30 hover:text-white cursor-pointer text-sm text-global-text transition-colors"
                        >
                          {y}
                        </li>
                      ))
                    }
                    <li
                      data-value="otro"
                      class="px-4 py-2.5 hover:bg-black/30 cursor-pointer text-sm font-medium text-global-primary transition-colors border-t border-global-border"
                    >
                      Otro
                    </li>
                  </ul>
                </div>

                <input
                  type="number"
                  id="year-custom"
                  placeholder="Ingresar año"
                  class="hidden mt-2 w-full rounded-xl border border-global-border bg-global-card px-3 py-2.5 text-sm text-global-text outline-none focus:border-global-primary focus:ring-1 focus:ring-global-primary transition-colors placeholder-gray-500"
                />
              </div>

              <div class="w-1/2 relative" id="term-combobox-container">
                <label
                  class="block text-sm font-medium text-global-text-muted mb-1.5"
                  for="term-display"
                >
                  Semestre
                </label>
                <div class="relative">
                  <input type="hidden" id="term-hidden" />
                  <input
                    type="text"
                    id="term-display"
                    readonly
                    class="w-full rounded-xl border border-global-border bg-global-card px-3 py-2.5 text-sm text-global-text outline-none focus:border-global-primary focus:ring-1 focus:ring-global-primary transition-colors cursor-pointer placeholder-gray-500"
                    placeholder="Selecciona"
                    required
                  />
                  <div
                    class="pointer-events-none absolute inset-y-0 right-3 flex items-center"
                  >
                    <svg
                      class="h-4 w-4 text-global-text-muted"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M19 9l-7 7-7-7"></path>
                    </svg>
                  </div>
                  <ul
                    id="term-dropdown"
                    class="teacher-scroll absolute z-10 top-full left-0 mt-1 w-full max-h-60 overflow-auto rounded-xl border border-global-border bg-global-surface shadow-lg hidden"
                  >
                    <li
                      data-value="I"
                      class="px-4 py-2.5 hover:bg-black/30 hover:text-white cursor-pointer text-sm text-global-text transition-colors"
                    >
                      I
                    </li>
                    <li
                      data-value="II"
                      class="px-4 py-2.5 hover:bg-black/30 hover:text-white cursor-pointer text-sm text-global-text transition-colors"
                    >
                      II
                    </li>
                    <li
                      data-value="III"
                      class="px-4 py-2.5 hover:bg-black/30 hover:text-white cursor-pointer text-sm text-global-text transition-colors"
                    >
                      III
                    </li>
                  </ul>
                </div>
              </div>

              <input type="hidden" id="cycle-code" name="cycle" required />
            </div>
          </div>

          <!-- Row 2: Evaluation Type & Teacher -->
          <div class="grid gap-4 sm:grid-cols-2">
            <!-- Col 1: Evaluation -->
            <div class="relative" id="evaluation-combobox-container">
              <label
                class="block text-sm font-medium text-global-text-muted mb-1.5"
                for="evaluation-search"
              >
                Evaluación
              </label>

              <div class="relative">
                <input
                  type="hidden"
                  id="evaluation-id"
                  name="evaluation_id"
                  required
                />

                <input
                  type="text"
                  id="evaluation-search"
                  autocomplete="off"
                  disabled
                  class="w-full rounded-xl border border-global-border bg-global-card px-3 py-2.5 text-sm text-global-text outline-none focus:border-global-primary focus:ring-1 focus:ring-global-primary transition-colors placeholder-gray-500 disabled:opacity-60 disabled:cursor-not-allowed"
                  placeholder="Selecciona primero un curso"
                  required
                />

                <div
                  class="absolute inset-y-0 right-3 flex items-center pointer-events-none"
                >
                  <svg
                    class="h-4 w-4 text-global-text-muted"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M19 9l-7 7-7-7"></path>
                  </svg>
                </div>
              </div>

              <ul
                id="evaluation-dropdown"
                class="teacher-scroll absolute z-10 top-full left-0 mt-1 w-full max-h-60 overflow-auto rounded-xl border border-global-border bg-global-surface shadow-lg hidden"
              >
              </ul>
            </div>

            <!-- Col 2: Docente -->
            <div class="relative" id="teacher-combobox-container">
              <label
                class="block text-sm font-medium text-global-text-muted mb-1.5"
                for="teacher-search"
              >
                Docente <span
                  id="teacher-optional-label"
                  class="text-global-text-muted">(opcional)</span
                >
              </label>

              <div class="relative">
                <input type="hidden" id="teacher-id" name="teacher_id" />

                <input
                  type="text"
                  id="teacher-search"
                  autocomplete="off"
                  disabled
                  class="w-full rounded-xl border border-global-border bg-global-card px-3 py-2.5 text-sm text-global-text outline-none focus:border-global-primary focus:ring-1 focus:ring-global-primary transition-colors placeholder-gray-500 disabled:opacity-60 disabled:cursor-not-allowed"
                  placeholder="Ingresa un curso primero"
                />

                <div
                  class="absolute inset-y-0 right-3 flex items-center pointer-events-none"
                >
                  <svg
                    class="h-4 w-4 text-global-text-muted"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M19 9l-7 7-7-7"></path>
                  </svg>
                </div>
              </div>

              <ul
                id="teacher-dropdown"
                class="teacher-scroll absolute z-10 top-full left-0 mt-1 w-full max-h-60 overflow-auto rounded-xl border border-global-border bg-global-surface shadow-lg hidden"
              >
              </ul>

              <p
                id="teacher-loading"
                class="hidden mt-1 text-xs text-global-text-muted"
              >
                Cargando profesores...
              </p>
            </div>
          </div>

          <!-- Toggle: Plancha de profesor específico -->
          <div
            id="teacher-specific-toggle"
            class="flex items-start gap-3 rounded-xl border border-global-border bg-global-bg p-3 transition-all duration-300"
          >
            <label
              class="relative inline-flex items-center cursor-pointer shrink-0 mt-0.5"
            >
              <input
                id="is-teacher-specific"
                name="is_teacher_specific"
                type="checkbox"
                class="sr-only peer"
              />
              <div
                class="w-9 h-5 bg-global-border rounded-full peer-checked:bg-global-primary transition-colors after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:after:translate-x-full"
              >
              </div>
            </label>
            <div>
              <p class="text-sm font-medium text-global-text">
                Plancha de profesor específico
              </p>
              <p class="text-xs text-global-text-muted mt-0.5">
                Activa esto si la plancha pertenece a un profesor en particular
                y no es la práctica general del curso.
              </p>
            </div>
          </div>

          <!-- Info alert (shown when toggle is active) -->
          <div
            id="teacher-specific-info"
            class="hidden rounded-xl border border-amber-500/30 bg-amber-500/10 p-3 text-xs text-amber-200"
          >
            <strong>📋 Nota:</strong> Esta plancha se guardará como específica del
            docente indicado. Puedes tener la plancha general <em>y</em> las de profesores
            específicos para el mismo curso, ciclo y evaluación.
          </div>

          <!-- Row 3: Archivos -->
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label
                class="block text-sm font-medium text-global-text-muted mb-1.5"
                for="file"
              >
                PDF de la Plancha
              </label>
              <label
                for="file"
                class="flex justify-between items-center gap-3 w-full rounded-xl border border-global-border bg-global-card px-3 py-2 cursor-pointer hover:border-global-primary transition-colors"
              >
                <span
                  class="inline-flex items-center rounded-lg bg-global-primary px-3 py-1 text-sm font-semibold text-black whitespace-nowrap"
                >
                  Seleccionar
                </span>
                <span
                  id="file-name"
                  class="text-sm text-global-text-muted truncate"
                >
                  Sin archivo
                </span>
              </label>
              <input
                id="file"
                name="file"
                type="file"
                accept="application/pdf"
                class="hidden"
              />
            </div>

            <div>
              <label
                class="block text-sm font-medium text-global-text-muted mb-1.5"
                for="solution-file"
              >
                PDF del Solucionario
                <span class="text-global-text-muted">(opcional)</span>
              </label>
              <label
                for="solution-file"
                class="flex justify-between items-center gap-3 w-full rounded-xl border border-global-border bg-global-card px-3 py-2 cursor-pointer hover:border-global-primary transition-colors"
              >
                <span
                  class="inline-flex items-center rounded-lg bg-global-primary px-3 py-1 text-sm font-semibold text-black whitespace-nowrap"
                >
                  Seleccionar
                </span>
                <span
                  id="solution-file-name"
                  class="text-sm text-global-text-muted truncate"
                >
                  Sin archivo
                </span>
              </label>
              <input
                id="solution-file"
                name="solution_file"
                type="file"
                accept="application/pdf"
                class="hidden"
              />
            </div>
          </div>

          <!-- Upload Status -->
          <div id="upload-status" class="hidden">
            <div class="flex items-center gap-2 text-sm">
              <div
                id="upload-spinner"
                class="animate-spin h-4 w-4 border-2 border-global-primary border-t-transparent rounded-full"
              >
              </div>
              <span id="upload-message" class="text-global-text-muted"
                >Preparando subida...</span
              >
            </div>
            <div
              class="mt-2 w-full bg-global-border rounded-full h-1.5 overflow-hidden"
            >
              <div
                id="upload-progress"
                class="h-full bg-global-primary rounded-full transition-all duration-300"
                style="width: 0%"
              >
              </div>
            </div>
          </div>

          <!-- Submit Button -->
          <button
            id="upload-submit-btn"
            type="submit"
            class="w-full inline-flex items-center justify-center gap-2 rounded-xl bg-global-primary px-6 py-2.5 text-sm font-semibold text-black shadow-lg shadow-green-500/20 transition hover:bg-global-primary-hover cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
          >
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"
              ></path>
            </svg>
            Subir archivo
          </button>
        </form>
      </section>

      <!-- Drive Sync Card -->
      <section
        class="rounded-2xl bg-global-surface border border-global-border p-6"
      >
        <div
          class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-4"
        >
          <div>
            <h2 class="text-lg font-semibold text-global-text">
              Sincronización con Drive
            </h2>
            <p class="mt-0.5 text-sm text-global-text-muted">
              Importa automáticamente desde Google Drive
            </p>
          </div>
        </div>

        <div class="flex flex-wrap gap-4 justify-center">
          <button
            id="sync-exams-btn"
            type="button"
            class="inline-flex items-center gap-2 rounded-xl border border-global-border bg-global-card px-4 py-2.5 text-sm font-medium text-global-text transition hover:bg-global-border cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
          >
            <svg
              class="w-4 h-4 text-global-primary"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
              ></path>
            </svg>
            Sincronizar Exámenes
          </button>
          <button
            id="sync-solutions-btn"
            type="button"
            class="inline-flex items-center gap-2 rounded-xl border border-global-border bg-global-card px-4 py-2.5 text-sm font-medium text-global-text transition hover:bg-global-border cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
          >
            <svg
              class="w-4 h-4 text-global-primary"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            Sincronizar Solucionarios
          </button>
          <button
            id="sync-all-btn"
            type="button"
            class="inline-flex items-center gap-2 rounded-xl bg-global-primary px-4 py-2.5 text-sm font-semibold text-black transition hover:bg-global-primary-hover cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
          >
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
              ></path>
            </svg>
            Sincronizar Todo
          </button>
        </div>

        <!-- Status Display -->
        <div id="sync-status" class="mt-4 hidden">
          <div class="flex items-center gap-2 text-sm">
            <div
              id="sync-spinner"
              class="animate-spin h-4 w-4 border-2 border-global-primary border-t-transparent rounded-full"
            >
            </div>
            <span id="sync-message" class="text-global-text-muted"
              >Iniciando sincronización...</span
            >
          </div>
        </div>

        <!-- Results Display -->
        <div id="sync-results" class="mt-4 hidden">
          <pre
            class="text-xs text-global-text-muted bg-global-bg p-3 rounded-lg overflow-x-auto max-h-48 overflow-y-auto border border-global-border">
          </pre>
        </div>

        <div
          class="mt-4 rounded-lg bg-global-bg/50 border border-global-border p-3"
        >
          <p class="text-xs text-global-text-muted">
            <strong class="text-global-text">Nota:</strong> La sincronización se ejecuta
            localmente en tu computadora. Usa el comando: <code
              class="bg-global-card px-1.5 py-0.5 rounded border border-global-border"
              >npm run drive:sync-solutions</code
            >
          </p>
        </div>
      </section>

      <!-- RF-04: Solucionarios más solicitados -->
      <section
        class="rounded-2xl bg-global-surface border border-global-border p-6 mt-6"
      >
        <div class="flex items-center justify-between mb-4">
          <div>
            <h2 class="text-lg font-semibold text-global-text">
              Solucionarios más solicitados
            </h2>
            <p class="mt-0.5 text-sm text-global-text-muted">
              Planchas sin solucionario con más solicitudes
            </p>
          </div>
          <button
            id="refresh-interests-btn"
            type="button"
            class="inline-flex items-center gap-2 rounded-lg border border-global-border bg-global-card px-3 py-1.5 text-sm text-global-text transition hover:bg-global-border cursor-pointer"
          >
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
              ></path>
            </svg>
            Actualizar
          </button>
        </div>

        <div id="interests-list" class="space-y-3">
          <!-- Loading -->
          <div id="interests-loading" class="text-center py-6">
            <div
              class="animate-spin h-6 w-6 border-2 border-global-primary border-t-transparent rounded-full mx-auto mb-2"
            >
            </div>
            <p class="text-sm text-global-text-muted">Cargando...</p>
          </div>
        </div>

        <div id="interests-empty" class="hidden text-center py-6">
          <p class="text-global-text-muted text-sm">
            No hay planchas con solicitudes de solucionario aún.
          </p>
        </div>
      </section>
    </div>
  </div>

  <script>
    /*
    Script principal del panel de subida.
    Maneja:
      - Sincronización con Google Drive (syncExams/syncSolutions/syncAll)
      - Combobox de curso con búsqueda y carga dinámica de profesores
      - Combobox de evaluación vinculado al curso seleccionado
      - Selección de ciclo (año + término)
      - PDF.js para generar miniatura de la 1ª página
      - Subida secuencial: upload-url → miniatura → Storage → metadatos DB
    */
    import * as pdfjsLib from "pdfjs-dist";
    import pdfjsWorker from "pdfjs-dist/build/pdf.worker.mjs?url";
    import { initTeacherDropdown } from "../../scripts/course-teacher-dropdown";
    pdfjsLib.GlobalWorkerOptions.workerSrc = pdfjsWorker;

    const syncExamsBtn = document.getElementById("sync-exams-btn");
    const syncSolutionsBtn = document.getElementById("sync-solutions-btn");
    const syncAllBtn = document.getElementById("sync-all-btn");
    const syncStatus = document.getElementById("sync-status");
    const syncMessage = document.getElementById("sync-message");
    const syncResults = document.getElementById("sync-results");
    const syncResultsPre = syncResults?.querySelector("pre");

    async function runSync(type: string) {
      // Disable all buttons
      [syncExamsBtn, syncSolutionsBtn, syncAllBtn].forEach((btn) => {
        btn?.setAttribute("disabled", "true");
      });

      // Show status
      syncStatus?.classList.remove("hidden");
      syncResults?.classList.add("hidden");
      document.getElementById("sync-spinner")?.classList.remove("hidden");
      if (syncMessage) syncMessage.textContent = `Sincronizando ${type}...`;

      try {
        const res = await fetch("/api/admin/drive-sync", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ type }),
        });

        if (!res.ok) {
          if (syncMessage)
            syncMessage.textContent = `❌ Error del servidor (${res.status})`;
          return;
        }

        const data = await res.json();

        if (syncResultsPre) {
          syncResultsPre.textContent = JSON.stringify(data, null, 2);
        }
        syncResults?.classList.remove("hidden");

        if (data.ok) {
          if (syncMessage)
