---
import Layout from "../../layouts/Layout.astro";
import AdminHeader from "../../components/AdminHeader.astro";
import { validateAdminSession } from "../../lib/adminAuth";

const isAdmin = await validateAdminSession(Astro.cookies);
if (!isAdmin) {
    return Astro.redirect("/admin/login");
}
---

<Layout title="Gestionar Cursos | TrikaWeb Admin">
    <div class="min-h-screen py-8">
        <div class="mx-auto w-full max-w-4xl px-4">
            <!-- Header Section -->
            <AdminHeader 
                title="Gestionar Cursos" 
                description="Agrega cursos y revisa el listado existente" 
            />

            <!-- Create Course -->
            <section class="rounded-2xl bg-global-surface border border-global-border p-6 mb-6">
                <h2 class="text-lg font-semibold text-global-text mb-4">Agregar curso</h2>

                <form id="add-course-form" class="grid gap-4 sm:grid-cols-3">
                    <div>
                        <label
                            class="block text-sm font-medium text-global-text-muted mb-1.5"
                            for="course-code"
                        >
                            Código
                        </label>
                        <input
                            id="course-code"
                            type="text"
                            class="w-full rounded-xl border border-global-border bg-global-bg px-4 py-2.5 text-sm text-global-text outline-none focus:border-global-primary focus:ring-1 focus:ring-global-primary transition-colors placeholder-gray-500"
                            placeholder="MAT01"
                            required
                        />
                    </div>
                    <div class="sm:col-span-2">
                        <label
                            class="block text-sm font-medium text-global-text-muted mb-1.5"
                            for="course-name"
                        >
                            Nombre
                        </label>
                        <input
                            id="course-name"
                            type="text"
                            class="w-full rounded-xl border border-global-border bg-global-bg px-4 py-2.5 text-sm text-global-text outline-none focus:border-global-primary focus:ring-1 focus:ring-global-primary transition-colors placeholder-gray-500"
                            placeholder="Cálculo I"
                            required
                        />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-global-text-muted mb-1.5" for="course-credits">
                            Créditos
                        </label>
                        <input
                            id="course-credits"
                            type="number"
                            min="1"
                            step="1"
                            class="w-full rounded-xl border border-global-border bg-global-bg px-4 py-2.5 text-sm text-global-text outline-none focus:border-global-primary focus:ring-1 focus:ring-global-primary transition-colors placeholder-gray-500"
                            placeholder="4"
                            required
                        />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-global-text-muted mb-1.5">
                            Sistema de evaluación
                        </label>
                        <select
                            id="course-system"
                            class="w-full rounded-xl border border-global-border bg-global-bg px-4 py-2.5 text-sm text-global-text"
                            required
                        >
                            <option value="">Seleccionar...</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-global-text-muted mb-1.5">
                            Subsistema
                        </label>
                        <select
                            id="course-subsystem"
                            class="w-full rounded-xl border border-global-border bg-global-bg px-4 py-2.5 text-sm text-global-text"
                            disabled
                        >
                            <option value="">Seleccionar...</option>
                        </select>
                    </div>
                    <div id="evaluation-config-wrapper" class="sm:col-span-3 hidden">
                        <label class="block text-sm font-medium text-global-text-muted mb-1.5">
                            Evaluaciones del curso
                        </label>
                        <div
                            id="evaluation-config-help"
                            class="mb-2 text-xs text-global-text-muted"
                        ></div>
                        <div
                            id="evaluation-options"
                            class="grid gap-2 sm:grid-cols-2"
                        ></div>
                    </div>
                    <div class="sm:col-span-3 flex items-center gap-3">
                        <button
                            type="submit"
                            id="add-course-btn"
                            class="rounded-xl bg-global-primary px-5 py-2.5 text-sm font-semibold text-black transition hover:bg-global-primary-hover cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
                        >
                            Agregar
                        </button>
                        <span id="add-course-feedback" class="text-sm"></span>
                    </div>
                </form>
            </section>

            <!-- Courses List -->
            <section class="rounded-2xl bg-global-surface border border-global-border p-6">
                <div class="flex flex-row items-start justify-between gap-4 flex-wrap mb-4">
                    <div>
                        <h2 class="text-lg font-semibold text-global-text">Cursos</h2>
                        <p class="text-sm text-global-text-muted">
                            <span id="visible-count" class="font-semibold text-global-text">0</span> visibles ·
                            <span id="hidden-count" class="font-semibold text-global-text">0</span> ocultos
                        </p>
                    </div>
                    <div class="flex items-center gap-3 flex-wrap">
                        <input
                            id="courses-search"
                            type="text"
                            class="w-full sm:w-[280px] rounded-xl border border-global-border bg-global-bg px-4 py-2.5 text-sm text-global-text outline-none focus:border-global-primary focus:ring-1 focus:ring-global-primary transition-colors"
                            placeholder="Buscar por código o nombre..."
                        />
                        <button
                            id="courses-refresh"
                            type="button"
                            class="rounded-xl bg-global-card border border-global-border px-4 py-2.5 text-sm font-medium text-global-text transition hover:bg-global-border cursor-pointer"
                        >
                            Recargar
                        </button>
                    </div>
                </div>

                <div id="courses-list" class="space-y-3"></div>

                <div id="courses-pagination" class="mt-6 flex items-center justify-between gap-3"></div>
            </section>
        </div>
    </div>
</Layout>

<script>

    let cachedSubsystems: Array<{ subsystem_id: number; subsystem_cod: string; practices_quantity: number }> = [];
    let cachedVariableEvaluations: Array<{ evaluation_id: number; evaluation_name: string }> = [];

    type Course = { id: number; code: string; name: string; credits: number; is_hidden: boolean };

    const listEl = document.getElementById("courses-list") as HTMLDivElement;
    const paginationEl = document.getElementById("courses-pagination") as HTMLDivElement;
    const searchInput = document.getElementById("courses-search") as HTMLInputElement;
    const refreshBtn = document.getElementById("courses-refresh") as HTMLButtonElement;
    const visibleCountEl = document.getElementById("visible-count") as HTMLSpanElement;
    const hiddenCountEl = document.getElementById("hidden-count") as HTMLSpanElement;

    const addForm = document.getElementById("add-course-form") as HTMLFormElement;
    const addBtn = document.getElementById("add-course-btn") as HTMLButtonElement;
    const addFeedback = document.getElementById("add-course-feedback") as HTMLSpanElement;
    const codeInput = document.getElementById("course-code") as HTMLInputElement;
    const nameInput = document.getElementById("course-name") as HTMLInputElement;
    const creditsInput = document.getElementById("course-credits") as HTMLInputElement;

    const systemSelect = document.getElementById("course-system") as HTMLSelectElement;
    const subsystemSelect = document.getElementById("course-subsystem") as HTMLSelectElement;

    const evaluationConfigWrapper = document.getElementById("evaluation-config-wrapper") as HTMLDivElement;
    const evaluationConfigHelp = document.getElementById("evaluation-config-help") as HTMLDivElement;
    const evaluationOptions = document.getElementById("evaluation-options") as HTMLDivElement;

    let page = 1;
    let pageSize = 30;

    const setFeedback = (message: string, kind: "ok" | "error" = "ok") => {
        addFeedback.textContent = message;
        addFeedback.className = kind === "ok" ? "text-sm text-green-400" : "text-sm text-red-400";
    };

    const escapeHtml = (value: string) =>
        value
            .replaceAll("&", "&amp;")
            .replaceAll("<", "&lt;")
            .replaceAll(">", "&gt;")
            .replaceAll('"', "&quot;")
            .replaceAll("'", "&#039;");

    function renderEvaluationOptions() {
        const subsystem_id = Number(subsystemSelect.value);
        const subsystem = cachedSubsystems.find((s) => s.subsystem_id === subsystem_id);

        const requires = systemSelect.selectedOptions[0]?.getAttribute("data-requires") === "true";

        if (!requires || !subsystem) {
            evaluationOptions.innerHTML = "";
            evaluationConfigHelp.textContent = "";
            evaluationConfigWrapper.classList.add("hidden");
            return;
        }

        evaluationConfigWrapper.classList.remove("hidden");
        evaluationConfigHelp.textContent = `Selecciona exactamente ${subsystem.practices_quantity} evaluaciones.`;

        evaluationOptions.innerHTML = cachedVariableEvaluations
            .map(
                (ev) => `
                    <label class="flex items-center gap-3 rounded-xl border border-global-border bg-global-bg px-4 py-3 text-sm text-global-text">
                        <input
                            type="checkbox"
                            class="course-evaluation-checkbox"
                            value="${ev.evaluation_id}"
                            data-evaluation-name="${escapeHtml(ev.evaluation_name)}"
                        />
                        <span>${escapeHtml(ev.evaluation_name)}</span>
                    </label>
                `
            )
            .join("");

        const checkboxes = Array.from(
            document.querySelectorAll(".course-evaluation-checkbox")
        ) as HTMLInputElement[];

        for (const checkbox of checkboxes) {
            checkbox.addEventListener("change", () => {
                const allCheckboxes = Array.from(
                    document.querySelectorAll(".course-evaluation-checkbox")
                ) as HTMLInputElement[];

                if (checkbox.checked) {
                    const allowed = canCheckEvaluation(checkbox, allCheckboxes);

                    if (!allowed) {
                        checkbox.checked = false;
                        setFeedback("Debes seleccionar las evaluaciones en orden.", "error");
                        return;
                    }
                } else {
                    uncheckFollowingEvaluations(checkbox, allCheckboxes);
                }

                setFeedback("", "ok");
                updateEvaluationCheckboxLimits();
            });
        }

        updateEvaluationCheckboxLimits();
    }

    function parseEvaluationLabel(label: string) {
    const match = label.match(/^(.*?)(\d+)$/);

    if (!match) {
        return {
            baseName: label.trim(),
            order: null as number | null,
        };
    }

    return {
        baseName: match[1].trim(),
        order: Number(match[2]),
    };
}

    function canCheckEvaluation(target: HTMLInputElement, checkboxes: HTMLInputElement[]) {
        const label = target.dataset.evaluationName || "";
        const parsed = parseEvaluationLabel(label);

        if (parsed.order === null || parsed.order <= 1) {
            return true;
        }

        for (let i = 1; i < parsed.order; i++) {
            const required = checkboxes.find((cb) => {
                const current = parseEvaluationLabel(cb.dataset.evaluationName || "");
                return current.baseName === parsed.baseName && current.order === i;
            });

            if (!required || !required.checked) {
                return false;
            }
        }

        return true;
    }

    function uncheckFollowingEvaluations(target: HTMLInputElement, checkboxes: HTMLInputElement[]) {
        const label = target.dataset.evaluationName || "";
        const parsed = parseEvaluationLabel(label);

        if (parsed.order === null) return;

        for (const cb of checkboxes) {
            const current = parseEvaluationLabel(cb.dataset.evaluationName || "");

            if (
                current.baseName === parsed.baseName &&
                current.order !== null &&
                current.order > parsed.order
            ) {
                cb.checked = false;
            }
        }
    }

    function updateEvaluationCheckboxLimits() {
        const subsystem_id = Number(subsystemSelect.value);
        const subsystem = cachedSubsystems.find((s) => s.subsystem_id === subsystem_id);

        if (!subsystem) return;

        const max = subsystem.practices_quantity;

        const checkboxes = Array.from(
            document.querySelectorAll(".course-evaluation-checkbox")
        ) as HTMLInputElement[];

        const checkedCount = checkboxes.filter((cb) => cb.checked).length;

        for (const checkbox of checkboxes) {
            if (!checkbox.checked) {
                checkbox.disabled = checkedCount >= max;
            } else {
                checkbox.disabled = false;
            }
        }

        evaluationConfigHelp.textContent = `Selecciona exactamente ${max} evaluaciones. Actualmente: ${checkedCount}/${max}.`;
    }

    async function loadCourses(nextPage: number = 1) {
        page = nextPage;
        listEl.innerHTML = "<div class='text-sm text-global-text-muted'>Cargando...</div>";
        paginationEl.innerHTML = "";

        const search = (searchInput?.value || "").trim();

        const res = await fetch("/api/admin/courses", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ page, pageSize, search }),
        });

        const data = await res.json().catch(() => null);

        if (!res.ok || !data?.ok) {
            listEl.innerHTML =
                "<div class='text-sm text-red-400'>No se pudo cargar cursos</div>";
            return;
        }

        const courses: Course[] = data.courses || [];

        if (visibleCountEl) {
            visibleCountEl.textContent = String(data?.counts?.visible ?? 0);
        }
        if (hiddenCountEl) {
            hiddenCountEl.textContent = String(data?.counts?.hidden ?? 0);
        }

        if (!courses.length) {
            listEl.innerHTML =
                "<div class='text-sm text-global-text-muted'>No hay cursos para mostrar.</div>";
        } else {
            listEl.innerHTML = courses
                .map(
                    (c) => `
                    <div class="rounded-xl bg-global-bg border border-global-border p-4 ${c.is_hidden ? "opacity-70" : ""}" data-course-id="${c.id}">
                        <div class="flex items-center justify-between gap-4">
                            <div class="min-w-0 flex-1">
                                <div class="text-sm text-global-text-muted truncate">${escapeHtml(c.code)}</div>
                                <div class="text-base font-semibold text-global-text truncate">${escapeHtml(c.name)}</div>
                                <div class="text-xs text-global-text-muted">Créditos: ${c.credits}</div>
                            </div>
                            <div class="flex items-center gap-3 shrink-0">
                                <span class="inline-flex items-center justify-center w-[68px] px-2 py-0.5 text-[10px] font-bold uppercase rounded-full border tracking-wide ${c.is_hidden ? 'bg-yellow-500/10 border-yellow-500/30 text-yellow-400' : 'bg-green-500/10 border-green-500/30 text-green-400'}">
                                    ${c.is_hidden ? 'Oculto' : 'Visible'}
                                </span>
                                <button
                                    type="button"
                                    class="toggle-course-btn w-[72px] rounded-lg border px-3 py-1.5 text-xs font-medium transition cursor-pointer ${c.is_hidden ? "bg-green-600/20 border-green-600/30 text-green-400 hover:bg-green-600/30" : "bg-yellow-600/20 border-yellow-600/30 text-yellow-400 hover:bg-yellow-600/30"}"
                                    data-course-id="${c.id}"
                                    data-next-hidden="${c.is_hidden ? "false" : "true"}"
                                >
                                    ${c.is_hidden ? "Mostrar" : "Ocultar"}
                                </button>
                                <div class="text-xs text-global-text-muted w-10 text-right">ID: ${c.id}</div>
                            </div>
                        </div>
                    </div>
                `,
                )
                .join("");
        }

        const pagination = data.pagination;
        const totalPages = Number(pagination?.totalPages || 0);

        if (totalPages > 1) {
            const prevDisabled = page <= 1;
            const nextDisabled = page >= totalPages;

            paginationEl.innerHTML = `
                <div class="text-sm text-global-text-muted">Página ${page} de ${totalPages}</div>
                <div class="flex gap-2">
                    <button
                        ${prevDisabled ? "disabled" : ""}
                        id="courses-prev"
                        class="rounded-lg bg-global-card border border-global-border px-3 py-2 text-sm font-medium text-global-text transition hover:bg-global-border cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
                    >
                        Anterior
                    </button>
                    <button
                        ${nextDisabled ? "disabled" : ""}
                        id="courses-next"
                        class="rounded-lg bg-global-card border border-global-border px-3 py-2 text-sm font-medium text-global-text transition hover:bg-global-border cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
                    >
                        Siguiente
                    </button>
                </div>
            `;

            const prevBtn = document.getElementById("courses-prev") as HTMLButtonElement;
            const nextBtn = document.getElementById("courses-next") as HTMLButtonElement;

            prevBtn?.addEventListener("click", () => {
                if (page > 1) loadCourses(page - 1);
            });
            nextBtn?.addEventListener("click", () => {
                if (page < totalPages) loadCourses(page + 1);
            });
        }
    }

    async function loadEvaluationOptions() {
        const system_id = Number(systemSelect.value);

        if (!Number.isInteger(system_id) || system_id <= 0) {
            cachedVariableEvaluations = [];
            evaluationOptions.innerHTML = "";
            evaluationConfigWrapper.classList.add("hidden");
            return;
        }

        try {
            const res = await fetch("/api/admin/course-evaluation-options", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ system_id }),
            });

            const text = await res.text();
            let result: any = null;

            try {
                result = JSON.parse(text);
            } catch (err) {
                console.error("Respuesta no JSON:", text);
                throw new Error("El endpoint no devolvió JSON válido");
            }

            if (!res.ok || !result?.ok) {
                cachedVariableEvaluations = [];
                evaluationOptions.innerHTML = "";
                evaluationConfigWrapper.classList.add("hidden");
                return;
            }

            cachedVariableEvaluations = result.evaluations || [];
            renderEvaluationOptions();
        } catch (err) {
            console.error("Error cargando evaluaciones:", err);
            cachedVariableEvaluations = [];
            evaluationOptions.innerHTML = "";
            evaluationConfigWrapper.classList.add("hidden");
        }
    }

    listEl?.addEventListener("click", async (e) => {
        const target = e.target as HTMLElement;
        const btn = target.closest(".toggle-course-btn") as HTMLButtonElement | null;

        if (!btn) return;

        const courseId = Number(btn.getAttribute("data-course-id"));
        const nextHidden = btn.getAttribute("data-next-hidden") === "true";

        if (!Number.isFinite(courseId) || courseId <= 0) return;

        btn.disabled = true;

        try {
            const res = await fetch("/api/admin/toggle-course", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                credentials: "include",
                body: JSON.stringify({
                    course_id: courseId,
                    is_hidden: nextHidden
                }),
            });

            const out = await res.json().catch(() => null);

            if (!res.ok || !out?.ok) {
                throw new Error(out?.error || "No se pudo actualizar");
            }

            const card = btn.closest("[data-course-id]");
            if (card) {
                card.classList.toggle("opacity-70", nextHidden);
            }

            btn.textContent = nextHidden ? "Mostrar" : "Ocultar";
            btn.setAttribute("data-next-hidden", String(!nextHidden));

        } catch (err) {
            console.error(err);
        } finally {
            btn.disabled = false;
        }
    });

    async function loadSystems() {
    const res = await fetch("/api/admin/evaluation-systems");
    const systems = await res.json();

    systemSelect.innerHTML =
        `<option value="">Seleccionar...</option>` +
        systems.map((s: any) => `
            <option 
                value="${s.system_id}" 
                data-requires="${s.requires_subsystem}"
            >
                ${s.system_cod} - ${s.system_description}
            </option>
        `).join("");
    }

    async function loadSubsystems() {
        try {
            const res = await fetch("/api/admin/evaluation-subsystems", {
                credentials: "include"
            });

            const result = await res.json();

            if (!result.ok) {
                console.error("Error:", result.error);
                return;
            }

            const subsystems = result.subsystems;
            cachedSubsystems = subsystems;

            subsystemSelect.innerHTML =
                `<option value="">Seleccionar...</option>` +
                subsystems.map((s: any) => `
                    <option value="${s.subsystem_id}">
                        ${s.subsystem_cod} (${s.practices_quantity})
                    </option>
                `).join("");

        } catch (err) {
            console.error("Error cargando subsistemas:", err);
        }
    }

    systemSelect.addEventListener("change", async () => {
        const selected = systemSelect.selectedOptions[0];
        const requires = selected?.getAttribute("data-requires") === "true";

        if (requires) {
            subsystemSelect.disabled = false;
            subsystemSelect.classList.remove("opacity-60", "cursor-not-allowed");

            if (subsystemSelect.options.length > 0) {
                subsystemSelect.options[0].text = "Seleccionar...";
            }
        } else {
            subsystemSelect.disabled = true;
            subsystemSelect.value = "";
            subsystemSelect.classList.add("opacity-60", "cursor-not-allowed");

            if (subsystemSelect.options.length > 0) {
                subsystemSelect.options[0].text = "No aplica";
            }
        }

        evaluationOptions.innerHTML = "";
        evaluationConfigHelp.textContent = "";
        evaluationConfigWrapper.classList.add("hidden");
        cachedVariableEvaluations = [];

        await loadEvaluationOptions();
    });

    subsystemSelect.addEventListener("change", () => {
        renderEvaluationOptions();
    });

    addForm?.addEventListener("submit", async (e) => {

        if (addBtn.disabled) return;

        e.preventDefault();

        const code = (codeInput?.value || "").trim();
        const name = (nameInput?.value || "").trim();
        const credits = Number((creditsInput?.value || "").trim());
        const system_id = Number(systemSelect.value) || null;
        const subsystem_id = subsystemSelect.value ? Number(subsystemSelect.value) : null;
        const selected_evaluations = Array.from(
            document.querySelectorAll(".course-evaluation-checkbox:checked")
        ).map((el) => Number((el as HTMLInputElement).value)).filter((id) => Number.isInteger(id) && id > 0);

        console.log("SYSTEM:", system_id);
        console.log("SUBSYSTEM:", subsystemSelect.value);

        if (!Number.isInteger(credits) || credits <= 0) {
        setFeedback("Créditos inválidos (entero mayor a 0).", "error");
        addBtn.disabled = false;
        return;
        }

        const selectedOption = systemSelect.selectedOptions[0];
        const requires = selectedOption?.getAttribute("data-requires") === "true";
        const selectedSubsystem = cachedSubsystems.find((s) => s.subsystem_id === subsystem_id);

        if (requires && selectedSubsystem && selected_evaluations.length !== selectedSubsystem.practices_quantity) {
            setFeedback(`Debes seleccionar exactamente ${selectedSubsystem.practices_quantity} evaluaciones.`, "error");
            addBtn.disabled = false;
            return;
        }

        addBtn.disabled = true;
        setFeedback("Guardando...", "ok");

        const res = await fetch("/api/admin/add-course", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
                code,
                name,
                credits,
                system_id,
                subsystem_id,
                selected_evaluations
            }),
        });

        const data = await res.json().catch(() => null);

        addBtn.disabled = false;

        if (!res.ok || !data?.ok) {
            setFeedback(data?.error || "Error al agregar curso", "error");
            return;
        }

        setFeedback("Curso agregado.", "ok");
        codeInput.value = "";
        nameInput.value = "";
        searchInput.value = "";
        creditsInput.value = "";
        systemSelect.value = "";
        subsystemSelect.value = "";
        subsystemSelect.disabled = true;
        await loadCourses(1);
    });

    let searchTimer: any;
    searchInput?.addEventListener("input", () => {
        clearTimeout(searchTimer);
        searchTimer = setTimeout(() => {
            loadCourses(1);
        }, 250);
    });

    refreshBtn?.addEventListener("click", () => loadCourses(page));

    document.addEventListener("DOMContentLoaded", async () => {
        await Promise.all([
            loadSystems(),
            loadSubsystems(),
            loadCourses(1)
        ]);
    });
</script>
