---
import Layout from "../../layouts/Layout.astro";
import AdminHeader from "../../components/AdminHeader.astro";
import { validateAdminSession } from "../../lib/adminAuth";

const isAdmin = await validateAdminSession(Astro.cookies);
if (!isAdmin) {
    return Astro.redirect("/admin/login");
}
---

<Layout title="Gestionar Cursos | TrikaWeb Admin">
    <div class="min-h-screen py-8">
        <div class="mx-auto w-full max-w-4xl px-4">
            <!-- Header Section -->
            <AdminHeader 
                title="Gestionar Cursos" 
                description="Agrega cursos y revisa el listado existente" 
            />

            <!-- Create Course -->
            <section class="rounded-2xl bg-global-surface border border-global-border p-6 mb-6">
                <h2 class="text-lg font-semibold text-global-text mb-4">Agregar curso</h2>

                <form id="add-course-form" class="grid gap-4 sm:grid-cols-3">
                    <div>
                        <label
                            class="block text-sm font-medium text-global-text-muted mb-1.5"
                            for="course-code"
                        >
                            Código
                        </label>
                        <input
                            id="course-code"
                            type="text"
                            class="w-full rounded-xl border border-global-border bg-global-bg px-4 py-2.5 text-sm text-global-text outline-none focus:border-global-primary focus:ring-1 focus:ring-global-primary transition-colors placeholder-gray-500"
                            placeholder="MAT01"
                            required
                        />
                    </div>
                    <div class="sm:col-span-2">
                        <label
                            class="block text-sm font-medium text-global-text-muted mb-1.5"
                            for="course-name"
                        >
                            Nombre
                        </label>
                        <input
                            id="course-name"
                            type="text"
                            class="w-full rounded-xl border border-global-border bg-global-bg px-4 py-2.5 text-sm text-global-text outline-none focus:border-global-primary focus:ring-1 focus:ring-global-primary transition-colors placeholder-gray-500"
                            placeholder="Cálculo I"
                            required
                        />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-global-text-muted mb-1.5" for="course-credits">
                            Créditos
                        </label>
                        <input
                            id="course-credits"
                            type="number"
                            min="1"
                            step="1"
                            class="w-full rounded-xl border border-global-border bg-global-bg px-4 py-2.5 text-sm text-global-text outline-none focus:border-global-primary focus:ring-1 focus:ring-global-primary transition-colors placeholder-gray-500"
                            placeholder="4"
                            required
                        />
                    </div>
                    <div class="sm:col-span-3 flex items-center gap-3">
                        <button
                            type="submit"
                            id="add-course-btn"
                            class="rounded-xl bg-global-primary px-5 py-2.5 text-sm font-semibold text-black transition hover:bg-global-primary-hover cursor-pointer"
                        >
                            Agregar
                        </button>
                        <span id="add-course-feedback" class="text-sm"></span>
                    </div>
                </form>
            </section>

            <!-- Courses List -->
            <section class="rounded-2xl bg-global-surface border border-global-border p-6">
                <div class="flex flex-row items-start justify-between gap-4 flex-wrap mb-4">
                    <div>
                        <h2 class="text-lg font-semibold text-global-text">Cursos</h2>
                        <p class="text-sm text-global-text-muted">
                            <span id="visible-count" class="font-semibold text-global-text">0</span> visibles ·
                            <span id="hidden-count" class="font-semibold text-global-text">0</span> ocultos
                        </p>
                    </div>
                    <div class="flex items-center gap-3 flex-wrap">
                        <input
                            id="courses-search"
                            type="text"
                            class="w-full sm:w-[280px] rounded-xl border border-global-border bg-global-bg px-4 py-2.5 text-sm text-global-text outline-none focus:border-global-primary focus:ring-1 focus:ring-global-primary transition-colors"
                            placeholder="Buscar por código o nombre..."
                        />
                        <button
                            id="courses-refresh"
                            type="button"
                            class="rounded-xl bg-global-card border border-global-border px-4 py-2.5 text-sm font-medium text-global-text transition hover:bg-global-border cursor-pointer"
                        >
                            Recargar
                        </button>
                    </div>
                </div>

                <div id="courses-list" class="space-y-3"></div>

                <div id="courses-pagination" class="mt-6 flex items-center justify-between gap-3"></div>
            </section>
        </div>
    </div>
</Layout>

<script>
    type Course = { id: number; code: string; name: string; credits: number; is_hidden: boolean };

    const listEl = document.getElementById("courses-list") as HTMLDivElement;
    const paginationEl = document.getElementById("courses-pagination") as HTMLDivElement;
    const searchInput = document.getElementById("courses-search") as HTMLInputElement;
    const refreshBtn = document.getElementById("courses-refresh") as HTMLButtonElement;
    const visibleCountEl = document.getElementById("visible-count") as HTMLSpanElement;
    const hiddenCountEl = document.getElementById("hidden-count") as HTMLSpanElement;

    const addForm = document.getElementById("add-course-form") as HTMLFormElement;
    const addBtn = document.getElementById("add-course-btn") as HTMLButtonElement;
    const addFeedback = document.getElementById("add-course-feedback") as HTMLSpanElement;
    const codeInput = document.getElementById("course-code") as HTMLInputElement;
    const nameInput = document.getElementById("course-name") as HTMLInputElement;
    const creditsInput = document.getElementById("course-credits") as HTMLInputElement;

    let page = 1;
    let pageSize = 30;

    const setFeedback = (message: string, kind: "ok" | "error" = "ok") => {
        addFeedback.textContent = message;
        addFeedback.className = kind === "ok" ? "text-sm text-green-400" : "text-sm text-red-400";
    };

    const escapeHtml = (value: string) =>
        value
            .replaceAll("&", "&amp;")
            .replaceAll("<", "&lt;")
            .replaceAll(">", "&gt;")
            .replaceAll('"', "&quot;")
            .replaceAll("'", "&#039;");

    async function loadCourses(nextPage: number = 1) {
        page = nextPage;
        listEl.innerHTML = "<div class='text-sm text-global-text-muted'>Cargando...</div>";
        paginationEl.innerHTML = "";

        const search = (searchInput?.value || "").trim();

        const res = await fetch("/api/admin/courses", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ page, pageSize, search }),
        });

        const data = await res.json().catch(() => null);

        if (!res.ok || !data?.ok) {
            listEl.innerHTML =
                "<div class='text-sm text-red-400'>No se pudo cargar cursos</div>";
            return;
        }

        const courses: Course[] = data.courses || [];

        if (visibleCountEl) {
            visibleCountEl.textContent = String(data?.counts?.visible ?? 0);
        }
        if (hiddenCountEl) {
            hiddenCountEl.textContent = String(data?.counts?.hidden ?? 0);
        }

        if (!courses.length) {
            listEl.innerHTML =
                "<div class='text-sm text-global-text-muted'>No hay cursos para mostrar.</div>";
        } else {
            listEl.innerHTML = courses
                .map(
                    (c) => `
                    <div class="rounded-xl bg-global-bg border border-global-border p-4 ${c.is_hidden ? "opacity-70" : ""}" data-course-id="${c.id}">
                        <div class="flex items-center justify-between gap-4">
                            <div class="min-w-0 flex-1">
                                <div class="text-sm text-global-text-muted truncate">${escapeHtml(c.code)}</div>
                                <div class="text-base font-semibold text-global-text truncate">${escapeHtml(c.name)}</div>
                                <div class="text-xs text-global-text-muted">Créditos: ${c.credits}</div>
                            </div>
                            <div class="flex items-center gap-3 shrink-0">
                                <span class="inline-flex items-center justify-center w-[68px] px-2 py-0.5 text-[10px] font-bold uppercase rounded-full border tracking-wide ${c.is_hidden ? 'bg-yellow-500/10 border-yellow-500/30 text-yellow-400' : 'bg-green-500/10 border-green-500/30 text-green-400'}">
                                    ${c.is_hidden ? 'Oculto' : 'Visible'}
                                </span>
                                <button
                                    type="button"
                                    class="toggle-course-btn w-[72px] rounded-lg border px-3 py-1.5 text-xs font-medium transition cursor-pointer ${c.is_hidden ? "bg-green-600/20 border-green-600/30 text-green-400 hover:bg-green-600/30" : "bg-yellow-600/20 border-yellow-600/30 text-yellow-400 hover:bg-yellow-600/30"}"
                                    data-course-id="${c.id}"
                                    data-next-hidden="${c.is_hidden ? "false" : "true"}"
                                >
                                    ${c.is_hidden ? "Mostrar" : "Ocultar"}
                                </button>
                                <div class="text-xs text-global-text-muted w-10 text-right">ID: ${c.id}</div>
                            </div>
                        </div>
                    </div>
                `,
                )
                .join("");

            document.querySelectorAll('.toggle-course-btn').forEach((btn) => {
                btn.addEventListener('click', async () => {
                    const b = btn as HTMLButtonElement;
                    const courseId = Number(b.getAttribute('data-course-id'));
                    const nextHidden = b.getAttribute('data-next-hidden') === 'true';

                    b.disabled = true;
                    try {
                        const res = await fetch('/api/admin/toggle-course', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            credentials: 'include',
                            body: JSON.stringify({ course_id: courseId, is_hidden: nextHidden }),
                        });
                        const out = await res.json().catch(() => null);
                        if (!res.ok || !out?.ok) {
                            throw new Error(out?.error || 'No se pudo actualizar');
                        }
                        await loadCourses(page);
                    } catch (e) {
                        console.error(e);
                        b.disabled = false;
                        alert(e instanceof Error ? e.message : 'Error desconocido');
                    }
                });
            });
        }

        const pagination = data.pagination;
        const totalPages = Number(pagination?.totalPages || 0);

        if (totalPages > 1) {
            const prevDisabled = page <= 1;
            const nextDisabled = page >= totalPages;

            paginationEl.innerHTML = `
                <div class="text-sm text-global-text-muted">Página ${page} de ${totalPages}</div>
                <div class="flex gap-2">
                    <button
                        ${prevDisabled ? "disabled" : ""}
                        id="courses-prev"
                        class="rounded-lg bg-global-card border border-global-border px-3 py-2 text-sm font-medium text-global-text transition hover:bg-global-border cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
                    >
                        Anterior
                    </button>
                    <button
                        ${nextDisabled ? "disabled" : ""}
                        id="courses-next"
                        class="rounded-lg bg-global-card border border-global-border px-3 py-2 text-sm font-medium text-global-text transition hover:bg-global-border cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
                    >
                        Siguiente
                    </button>
                </div>
            `;

            const prevBtn = document.getElementById("courses-prev") as HTMLButtonElement;
            const nextBtn = document.getElementById("courses-next") as HTMLButtonElement;

            prevBtn?.addEventListener("click", () => {
                if (page > 1) loadCourses(page - 1);
            });
            nextBtn?.addEventListener("click", () => {
                if (page < totalPages) loadCourses(page + 1);
            });
        }
    }

    addForm?.addEventListener("submit", async (e) => {
        e.preventDefault();

        const code = (codeInput?.value || "").trim();
        const name = (nameInput?.value || "").trim();
        const credits = Number((creditsInput?.value || "").trim());

        if (!Number.isInteger(credits) || credits <= 0) {
        setFeedback("Créditos inválidos (entero mayor a 0).", "error");
        addBtn.disabled = false;
        return;
        }

        addBtn.disabled = true;
        setFeedback("Guardando...", "ok");

        const res = await fetch("/api/admin/add-course", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ code, name, credits }),
        });

        const data = await res.json().catch(() => null);

        addBtn.disabled = false;

        if (!res.ok || !data?.ok) {
            setFeedback(data?.error || "Error al agregar curso", "error");
            return;
        }

        setFeedback("Curso agregado.", "ok");
        codeInput.value = "";
        nameInput.value = "";
        searchInput.value = "";
        creditsInput.value = "";
        await loadCourses(1);
    });

    let searchTimer: any;
    searchInput?.addEventListener("input", () => {
        clearTimeout(searchTimer);
        searchTimer = setTimeout(() => {
            loadCourses(1);
        }, 250);
    });

    refreshBtn?.addEventListener("click", () => loadCourses(page));

    document.addEventListener("DOMContentLoaded", () => {
        loadCourses(1);
    });
</script>
