---
export const prerender = false;

import Layout from "../../../../layouts/Layout.astro";
import CurriculumBuilder from "../../../../components/Malla/CurriculumBuilder";
import { supabaseAdmin } from "../../../../lib/supabaseAdmin";

const { id } = Astro.params;

// Validar que el parámetro id tenga formato de UUID válido
const uuidRegex = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
if (!id || !uuidRegex.test(id)) {
    return Astro.redirect("/admin/mallas");
}

// Validar que el ID de la malla existe
const { data: plan, error: planError } = await supabaseAdmin
    .from("study_plans")
    .select(`
        id,
        year,
        grid_rows,
        is_current,
        specialty_id,
        specialties (
            id,
            name
        )
    `)
    .eq("id", id)
    .single();

if (planError || !plan) {
    console.error("Error fetching study plan:", planError);
    return Astro.redirect("/admin/mallas");
}

// Extraer el nombre de la especialidad de manera segura (por si viene como objeto o array de objetos)
const specialtyData = Array.isArray(plan.specialties) ? plan.specialties[0] : plan.specialties;
const specialtyName = specialtyData?.name || "Especialidad Desconocida";

const formattedPlan = {
    id: plan.id,
    year: plan.year,
    grid_rows: plan.grid_rows,
    is_current: plan.is_current,
    specialties: {
        name: specialtyName
    }
};

// Obtener la lista completa de cursos existentes
const { data: courses, error: coursesError } = await supabaseAdmin
    .from("courses")
    .select("id, code, name, credits")
    .order("name", { ascending: true });

if (coursesError) {
    console.error("Error fetching courses:", coursesError);
}

// Obtener los cursos ya asignados a esta malla
const { data: planCourses, error: planCoursesError } = await supabaseAdmin
    .from("plan_courses")
    .select("course_id, cycle, row_index, courses (id, code, name, credits)")
    .eq("plan_id", id);

if (planCoursesError) {
    console.error("Error fetching plan courses:", planCoursesError);
}

const initialPlacedCourses = planCourses ? planCourses.map((pc: any) => ({
    id: pc.courses?.id,
    code: pc.courses?.code || "",
    name: pc.courses?.name || "",
    credits: pc.courses?.credits,
    cycle: pc.cycle,
    row_index: pc.row_index
})).filter(c => c.id !== undefined) : [];
---

<Layout title={`Constructor de Malla (${specialtyName} - ${plan.year}) | TrikaWeb Admin`}>
    <div class="min-h-screen py-8">
        <div class="mx-auto w-full max-w-[1600px] px-4">
            <!-- Header Section -->
            <div class="mb-6 flex flex-row items-center justify-between gap-4 flex-wrap">
                <div>
                    <div class="flex items-center gap-2 text-sm text-global-text-muted mb-1">
                        <a href="/admin/mallas" class="hover:text-global-primary transition-colors font-medium flex items-center gap-1">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                            Volver a Mallas
                        </a>
                        <span>/</span>
                        <span class="text-global-text-muted">Constructor Visual</span>
                    </div>
                    <div class="flex items-center gap-3">
                        <h1 class="text-2xl font-bold text-global-text">
                            Edición de Malla
                        </h1>
                        <span class="px-2.5 py-1 text-xs font-semibold rounded-md bg-global-primary/10 text-global-primary border border-global-primary/20">
                            {specialtyName} - {plan.year}
                        </span>
                    </div>
                </div>
                <div>
                    <button id="trigger-save-malla" class="bg-global-primary hover:bg-global-primary-hover text-white px-4 py-2 rounded-lg text-sm font-semibold shadow-md shadow-global-primary/10 transition-all active:scale-95 cursor-pointer">
                        {initialPlacedCourses.length > 0 ? "Actualizar Malla" : "Guardar Malla"}
                    </button>
                </div>
            </div>

            <!-- Canvas Container -->
            <div class="w-full">
                <CurriculumBuilder client:load planId={formattedPlan.id} plan={formattedPlan} initialCourses={courses || []} initialPlacedCourses={initialPlacedCourses} />
            </div>
        </div>
    </div>
</Layout>
