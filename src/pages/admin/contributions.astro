---
import AdminLayout from "../../components/AdminLayout.astro";
import Layout from "../../layouts/Layout.astro";
import ModalConfirm from "../../components/ModalConfirm.astro";
import { validateAdminSession } from "../../lib/adminAuth";

const isAdmin = await validateAdminSession(Astro.cookies);
if (!isAdmin) {
  return Astro.redirect("/admin/login");
}
---

<Layout 
  title="Moderación de Aportes | TrikaWeb Admin"
  variant="admin"
  >
  <AdminLayout
    title="Aportes de Alumnos"
    description="Revisa, aprueba o descarta las donaciones de planchas y solucionarios enviadas por los estudiantes."
  >
    <!-- Sección Principal -->
    <section
      class="rounded-2xl bg-global-surface border border-global-border p-4 sm:p-6 shadow-xl"
    >
      <div class="flex items-center justify-between gap-4 flex-wrap mb-6">
        <div
          class="flex gap-1 rounded-xl bg-global-bg p-1 border border-global-border"
        >
          <button
            id="btn-filter-pending"
            class="filter-tab rounded-lg px-4 py-2 text-xs sm:text-sm font-semibold transition-all cursor-pointer bg-global-surface text-global-text shadow-sm flex items-center justify-center gap-1.5"
            data-status="pending"
          >
            <span>Pendientes</span>
            <span
              id="pending-count-badge"
              class="hidden ml-1 px-1.5 py-0.5 text-[10px] font-bold bg-red-500 text-white rounded-full min-w-[18px] text-center"
            >0</span>
          </button>
          <button
            id="btn-filter-history"
            class="filter-tab rounded-lg px-4 py-2 text-xs sm:text-sm font-semibold transition-all cursor-pointer text-global-text-muted hover:text-global-text flex items-center justify-center gap-1.5"
            data-status="history"
          >
            Historial
          </button>
        </div>

        <button
          id="btn-refresh"
          class="rounded-xl bg-global-card border border-global-border px-4 py-2 text-xs sm:text-sm font-semibold text-global-text hover:bg-global-border active:scale-95 transition-all cursor-pointer inline-flex items-center gap-2"
          title="Actualizar aportes"
        >
          <svg class="w-4 h-4 text-global-text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
          </svg>
          <span>Actualizar</span>
        </button>
      </div>

      <div id="loading" class="py-16 text-center text-global-text-muted">
        <div
          class="animate-spin h-8 w-8 border-2 border-global-primary border-t-transparent rounded-full mx-auto mb-3"
        >
        </div>
        <p class="text-sm font-medium">Cargando aportes...</p>
      </div>

      <div
        id="empty-state"
        class="hidden py-16 text-center text-global-text-muted"
      >
        <svg class="w-12 h-12 mx-auto mb-3 text-global-text-muted/60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
        </svg>
        <p class="text-base font-semibold text-global-text">No hay aportes para mostrar</p>
        <p class="text-xs text-global-text-muted mt-1">Todos los aportes han sido procesados o no hay registros.</p>
      </div>

      <div id="contributions-list" class="space-y-3.5"></div>
    </section>
  </AdminLayout>

  <!-- Modal de Revisión (Aprobación/Rechazo) -->
  <div
    id="review-modal"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/75 backdrop-blur-md p-4 transition-opacity duration-300"
  >
    <div
      class="bg-[#161F2C] border border-[#253245] rounded-3xl p-5 sm:p-6 max-w-lg w-full shadow-2xl transform scale-95 transition-transform duration-300 relative overflow-hidden text-left"
      id="review-modal-box"
    >
      <!-- Modal Header -->
      <div class="flex items-center justify-between pb-4 border-b border-[#253245] mb-5">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl bg-[#22c55e]/10 border border-[#22c55e]/25 flex items-center justify-center text-[#22c55e]">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
          </div>
          <div>
            <h3 id="modal-title" class="text-lg font-bold text-white leading-tight">Revisar Aporte</h3>
            <p class="text-xs text-gray-400">Revisa la donación enviada por el estudiante</p>
          </div>
        </div>

        <button
          id="close-modal-btn"
          class="w-8 h-8 rounded-full bg-[#1C2534] hover:bg-[#253245] text-gray-400 hover:text-white flex items-center justify-center transition-colors cursor-pointer"
          aria-label="Cerrar modal"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-4 w-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <div class="space-y-4">
        <!-- Structured Metadata Grid -->
        <div
          class="grid grid-cols-1 sm:grid-cols-2 gap-3 p-4 rounded-2xl bg-[#111722] border border-[#222E40] text-sm"
        >
          <div class="sm:col-span-2 flex flex-col gap-0.5">
            <span class="text-[10px] font-bold uppercase tracking-wider text-gray-400">Estudiante</span>
            <div class="flex items-center gap-2">
              <svg class="w-3.5 h-3.5 text-gray-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
              </svg>
              <span id="info-student" class="font-semibold text-white truncate"></span>
            </div>
          </div>
          <div class="flex flex-col gap-0.5">
            <span class="text-[10px] font-bold uppercase tracking-wider text-gray-400">Curso</span>
            <span id="info-course" class="font-medium text-gray-200 truncate"></span>
          </div>
          <div class="flex flex-col gap-0.5">
            <span class="text-[10px] font-bold uppercase tracking-wider text-gray-400">Evaluación y Ciclo</span>
            <span id="info-eval" class="font-medium text-gray-200"></span>
          </div>
          <div class="flex flex-col gap-0.5 sm:col-span-2 pt-2 border-t border-[#222E40]/60">
            <span class="text-[10px] font-bold uppercase tracking-wider text-gray-400">Tipo de Documento</span>
            <span id="info-type" class="font-bold text-[#22c55e]"></span>
          </div>
        </div>

        <!-- Botón para ver archivo borrador -->
        <a
          id="btn-view-draft"
          href="#"
          target="_blank"
          class="w-full inline-flex items-center justify-center gap-2.5 rounded-xl bg-blue-500/10 hover:bg-blue-500/20 border border-blue-500/25 py-3 text-sm font-semibold text-blue-400 hover:text-blue-300 transition-all shadow-sm group cursor-pointer"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-4 w-4 group-hover:translate-y-0.5 transition-transform"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
            ></path>
          </svg>
          Descargar / Ver Borrador del Alumno
        </a>

        <!-- Formulario de Aprobación/Rechazo -->
        <form
          id="review-form"
          class="space-y-4 pt-4 border-t border-[#253245]"
        >
          <input type="hidden" name="contribution_id" id="modal-contrib-id" />

          <div>
            <label
              class="block text-xs font-bold text-gray-300 uppercase tracking-wider mb-2"
            >
              Decisión de Moderación
            </label>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
              <label
                class="flex items-center gap-2.5 p-3 rounded-xl border border-[#22c55e]/30 bg-[#22c55e]/10 text-emerald-300 cursor-pointer hover:bg-[#22c55e]/15 transition-all"
              >
                <input
                  type="radio"
                  name="action"
                  value="approve"
                  checked
                  id="action-approve-radio"
                  class="w-4 h-4 accent-[#22c55e]"
                />
                <span id="action-approve-label" class="text-xs font-bold">Aprobar aporte</span>
              </label>

              <label
                class="flex items-center gap-2.5 p-3 rounded-xl border border-red-500/30 bg-red-500/10 text-red-300 cursor-pointer hover:bg-red-500/15 transition-all"
              >
                <input
                  type="radio"
                  name="action"
                  value="reject"
                  id="action-reject-radio"
                  class="w-4 h-4 accent-red-500"
                />
                <span class="text-xs font-bold">Rechazar aporte</span>
              </label>
            </div>
          </div>

          <div>
            <label
              for="admin_notes"
              class="block text-xs font-bold text-gray-300 uppercase tracking-wider mb-1.5"
            >
              Notas / Retroalimentación para el Estudiante
            </label>
            <textarea
              name="admin_notes"
              id="admin_notes"
              rows="2"
              placeholder="Ej: Aprobado correctamente / Archivo borroso o incompleto..."
              class="w-full rounded-xl border border-[#253245] bg-[#111722] p-3 text-sm text-gray-200 placeholder-gray-500 focus:border-[#22c55e] focus:ring-1 focus:ring-[#22c55e] outline-none resize-none transition-colors"
            ></textarea>
          </div>

          <div
            id="modal-status"
            class="hidden p-3 text-xs rounded-xl border text-center font-medium"
          >
          </div>

          <div class="flex items-center justify-end gap-3 pt-3">
            <button
              type="button"
              id="btn-cancel-modal"
              class="rounded-xl border border-[#253245] bg-[#1C2534] hover:bg-[#253245] px-4 py-2.5 text-xs font-semibold text-gray-300 hover:text-white transition-colors cursor-pointer"
            >
              Cancelar
            </button>
            <button
              type="submit"
              id="btn-submit-modal"
              class="rounded-xl bg-[#22c55e] hover:bg-[#1eb355] px-5 py-2.5 text-xs font-bold text-black shadow-[0_0_15px_rgba(34,197,94,0.2)] transition-all cursor-pointer"
            >
              Guardar Revisión
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Modal de Confirmación para Eliminar Archivo (Procesado) -->
  <ModalConfirm
    id="mark-used-modal"
    title="¿Eliminar archivo?"
    message="Esta acción es permanente. Se eliminará el archivo del servidor para liberar espacio de almacenamiento, manteniendo el aporte como procesado en el historial del estudiante."
    confirmText="Eliminar"
    confirmId="confirm-mark-used-btn"
    cancelId="cancel-mark-used-btn"
    feedbackId="mark-used-error"
  />
</Layout>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    let currentFilter: "pending" | "history" = "pending";
    let allContributions: any[] = [];

    function escapeHTML(str: string): string {
      if (!str) return "";
      return String(str)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }

    const listContainer = document.getElementById("contributions-list")!;
    const loadingEl = document.getElementById("loading")!;
    const emptyStateEl = document.getElementById("empty-state")!;
    const btnPending = document.getElementById("btn-filter-pending")!;
    const btnHistory = document.getElementById("btn-filter-history")!;
    const btnRefresh = document.getElementById("btn-refresh")!;

    const modal = document.getElementById("review-modal")!;
    const modalBox = document.getElementById("review-modal-box")!;
    const closeModalBtn = document.getElementById("close-modal-btn")!;
    const btnCancelModal = document.getElementById("btn-cancel-modal")!;
    const btnSubmitModal = document.getElementById("btn-submit-modal") as HTMLButtonElement;
    const reviewForm = document.getElementById("review-form") as HTMLFormElement;
    const modalStatus = document.getElementById("modal-status")!;
    const actionApproveLabel = document.getElementById("action-approve-label")!;

    const modalContribId = document.getElementById("modal-contrib-id") as HTMLInputElement;
    const infoStudent = document.getElementById("info-student")!;
    const infoCourse = document.getElementById("info-course")!;
    const infoEval = document.getElementById("info-eval")!;
    const infoType = document.getElementById("info-type")!;
    const btnViewDraft = document.getElementById("btn-view-draft") as HTMLAnchorElement;

    async function loadContributions() {
      loadingEl.classList.remove("hidden");
      listContainer.classList.add("hidden");
      emptyStateEl.classList.add("hidden");

      try {
        const res = await fetch("/api/admin/contributions/list");
        const data = await res.json();
        if (!res.ok) throw new Error(data.error);

        allContributions = data.contributions ?? [];
        renderContributions();
      } catch (err: any) {
        console.error("Error loading contributions:", err);
        listContainer.innerHTML = `<div class="p-4 text-center text-red-400 border border-red-500/20 bg-red-500/10 rounded-xl">Error: ${err.message || "No se pudieron cargar los aportes."}</div>`;
        listContainer.classList.remove("hidden");
      } finally {
        loadingEl.classList.add("hidden");
      }
    }

    function renderContributions() {
      listContainer.innerHTML = "";
      emptyStateEl.classList.add("hidden");

      const pendingCount = allContributions.filter((c) => c.status === "pending").length;
      const pendingBadge = document.getElementById("pending-count-badge");
      if (pendingBadge) {
        pendingBadge.textContent = String(pendingCount);
        pendingBadge.classList.toggle("hidden", pendingCount <= 0);
      }

      const filtered = allContributions.filter((c) => {
        if (currentFilter === "pending") {
          return c.status === "pending";
        } else {
          return c.status !== "pending";
        }
      });

      if (filtered.length === 0) {
        emptyStateEl.classList.remove("hidden");
        return;
      }

      filtered.forEach((contrib) => {
        const isPending = contrib.status === "pending";
        const isApproved = contrib.status === "approved";

        const card = document.createElement("div");
        card.className =
          "rounded-2xl border border-global-border bg-global-card hover:border-global-primary/30 p-4 sm:p-5 flex flex-col md:flex-row md:items-center justify-between gap-4 transition-all duration-200 shadow-sm group";

        const typeBadge =
          contrib.contribution_type === "sheet"
            ? `<span class="inline-flex items-center gap-1 text-[10px] font-bold uppercase tracking-wider text-emerald-400 bg-emerald-600/20 border border-emerald-600/30 px-2 py-0.5 rounded-md">Plancha</span>`
            : `<span class="inline-flex items-center gap-1 text-[10px] font-bold uppercase tracking-wider text-orange-400 bg-orange-500/15 border border-orange-500/30 px-2 py-0.5 rounded-md">Solucionario</span>`;

        const evalBadge = `
          <span class="inline-flex items-center gap-1.5 text-xs font-medium text-gray-300 bg-[#1E2533] border border-[#2B3548] px-2.5 py-0.5 rounded-md shadow-xs">
            <svg class="w-3.5 h-3.5 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
            <span class="font-semibold text-white">${escapeHTML(contrib.exam_type || "Examen")}</span>
            ${contrib.cycle ? `<span class="text-gray-500">•</span><span class="text-gray-300">${escapeHTML(contrib.cycle)}</span>` : ""}
          </span>
        `;

        card.innerHTML = `
          <div class="min-w-0 flex-1 flex flex-col gap-2">
            <div class="flex flex-wrap items-center gap-2">
              ${evalBadge}
              ${typeBadge}
            </div>
            <h3 class="text-base font-bold text-white group-hover:text-global-primary transition-colors leading-snug">
              ${escapeHTML(contrib.courses?.code ? `[${contrib.courses.code}] ` : "")}${escapeHTML(contrib.courses?.name || "Sin nombre de curso")}
            </h3>
            <div class="flex flex-wrap items-center gap-2 text-xs text-global-text-muted">
              <div class="flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 text-global-text-muted shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                </svg>
                <span>Aporte de <strong class="text-global-text font-medium">${escapeHTML(contrib.user_name || "Estudiante")}</strong></span>
              </div>
              ${contrib.user_email ? `<span class="text-global-border">•</span><span class="text-global-text-muted">${escapeHTML(contrib.user_email)}</span>` : ""}
            </div>
            ${contrib.admin_notes ? `
              <div class="text-xs mt-1.5 bg-white/5 border border-white/5 px-3.5 py-2 rounded-lg flex items-start gap-2 text-global-text-muted">
                <span class="font-medium text-global-text shrink-0">Nota Admin:</span>
                <span class="italic text-global-text/80">${escapeHTML(contrib.admin_notes)}</span>
              </div>
            ` : ""}
          </div>
          <div class="flex items-center justify-end gap-3 shrink-0 pt-2 md:pt-0 border-t md:border-t-0 border-global-border/40">
            ${(() => {
              if (isPending) {
                return `<button class="btn-review inline-flex items-center justify-center shrink-0 transition-all cursor-pointer font-semibold shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-offset-global-bg active:scale-95 disabled:opacity-50 disabled:cursor-not-allowed px-3.5 py-1.5 text-xs rounded-lg gap-1.5 bg-global-primary text-black hover:bg-global-primary-hover focus-visible:ring-global-primary" data-id="${contrib.id}" title="Revisar aporte" aria-label="Revisar aporte">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                      <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                      <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
                    </svg>
                    Revisar
                  </button>`;
              }
              
              if (isApproved) {
                if (contrib.contribution_type === 'sheet') {
                  return `<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-semibold border transition-colors shrink-0 bg-emerald-600/20 text-emerald-400 border-emerald-600/30">
                    <span class="w-1.5 h-1.5 rounded-full shrink-0 bg-emerald-500"></span>
                    Publicado automáticamente
                  </span>`;
                } else {
                  if (contrib.file_storage_path && contrib.file_storage_path !== "") {
                    return `
                      <a href="${contrib.signedUrl || '#'}" target="_blank" class="inline-flex items-center justify-center shrink-0 transition-all cursor-pointer font-semibold shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-offset-global-bg active:scale-95 disabled:opacity-50 disabled:cursor-not-allowed px-3 py-1.5 text-xs rounded-lg gap-1.5 bg-blue-600/20 text-blue-400 border border-blue-600/30 hover:bg-blue-600/30 focus-visible:ring-blue-500" title="Descargar archivo" aria-label="Descargar archivo">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                        Descargar
                      </a>
                      <button class="btn-mark-used inline-flex items-center justify-center shrink-0 transition-all cursor-pointer font-semibold shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-offset-global-bg active:scale-95 disabled:opacity-50 disabled:cursor-not-allowed px-3 py-1.5 text-xs rounded-lg gap-1.5 bg-red-600/20 text-red-400 border border-red-600/30 hover:bg-red-600/30 focus-visible:ring-red-500" data-id="${contrib.id}" title="Eliminar archivo del servidor" aria-label="Eliminar archivo del servidor">
                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18" /><path d="M8 6V4h8v2" /><path d="M19 6l-1 14H6L5 6" /><path d="M10 11v5" /><path d="M14 11v5" /></svg>
                        Eliminar archivo
                      </button>
                    `;
                  } else {
                    return `<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-semibold border transition-colors shrink-0 bg-emerald-600/20 text-emerald-400 border-emerald-600/30">
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                      Solucionario Procesado
                    </span>`;
                  }
                }
              }

              // Rejected
              return `<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-semibold border transition-colors shrink-0 bg-red-600/20 text-red-400 border-red-600/30">
                <span class="w-1.5 h-1.5 rounded-full shrink-0 bg-red-500"></span>
                Rechazado
              </span>`;
            })()}
          </div>
        `;
        listContainer.appendChild(card);
      });
      listContainer.classList.remove("hidden");
      document.querySelectorAll(".btn-review").forEach((btn) => {
        btn.addEventListener("click", () => {
          const id = Number(btn.getAttribute("data-id"));
          openReviewModal(id);
        });
      });

      document.querySelectorAll(".btn-mark-used").forEach((btn) => {
        btn.addEventListener("click", () => {
          const id = Number(btn.getAttribute("data-id"));
          openMarkUsedModal(id);
        });
      });
    }

    // Modal de Revisión
    function openReviewModal(id: number) {
      const contrib = allContributions.find((c) => c.id === id);
      if (!contrib) return;
      modalContribId.value = String(contrib.id);
      infoStudent.textContent = `${contrib.user_name || "Estudiante"} (${contrib.user_email || "Sin correo"})`;
      infoCourse.textContent = `[${contrib.courses?.code || ""}] ${contrib.courses?.name || ""}`;
      infoEval.textContent = `${contrib.exam_type || ""} · ${contrib.cycle || ""}`;
      infoType.textContent = contrib.contribution_type === "sheet" ? "Plancha (Examen)" : "Solucionario";
      btnViewDraft.href = contrib.signedUrl || "#";
      actionApproveLabel.textContent = "Aprobar aporte";
      reviewForm.reset();
      modalStatus.classList.add("hidden");
      btnSubmitModal.disabled = false;
      btnSubmitModal.textContent = "Guardar Revisión";
      modal.classList.remove("hidden");
      modal.classList.add("flex");
      setTimeout(() => {
        modalBox.classList.remove("scale-95");
        modalBox.classList.add("scale-100");
      }, 10);
    }

    function closeReviewModal() {
      modalBox.classList.remove("scale-100");
      modalBox.classList.add("scale-95");
      setTimeout(() => {
        modal.classList.add("hidden");
        modal.classList.remove("flex");
      }, 150);
    }

    closeModalBtn.addEventListener("click", closeReviewModal);
    btnCancelModal.addEventListener("click", closeReviewModal);
    modal.addEventListener("click", (e) => { if (e.target === modal) closeReviewModal(); });

    // Modal de Eliminar Archivo (Procesado)
    const markUsedModal = document.getElementById("mark-used-modal")!;
    const markUsedModalBox = document.getElementById("mark-used-modal-box")!;
    const cancelMarkUsedBtn = document.getElementById("cancel-mark-used-btn")!;
    const confirmMarkUsedBtn = document.getElementById("confirm-mark-used-btn") as HTMLButtonElement;
    const markUsedError = document.getElementById("mark-used-error")!;
    let targetMarkUsedId: number | null = null;

    function openMarkUsedModal(id: number) {
      targetMarkUsedId = id;
      markUsedError.classList.add("hidden");
      confirmMarkUsedBtn.disabled = false;
      confirmMarkUsedBtn.textContent = "Eliminar";
      markUsedModal.classList.remove("hidden");
      markUsedModal.classList.add("flex");
      setTimeout(() => {
        if (markUsedModalBox) {
          markUsedModalBox.classList.remove("scale-95");
          markUsedModalBox.classList.add("scale-100");
        }
      }, 10);
    }

    function closeMarkUsedModal() {
      targetMarkUsedId = null;
      if (markUsedModalBox) {
        markUsedModalBox.classList.remove("scale-100");
        markUsedModalBox.classList.add("scale-95");
      }
      setTimeout(() => {
        markUsedModal.classList.add("hidden");
        markUsedModal.classList.remove("flex");
      }, 150);
    }

    cancelMarkUsedBtn?.addEventListener("click", closeMarkUsedModal);
    markUsedModal?.addEventListener("click", (e) => { if (e.target === markUsedModal) closeMarkUsedModal(); });

    confirmMarkUsedBtn?.addEventListener("click", async () => {
      if (!targetMarkUsedId) return;
      confirmMarkUsedBtn.disabled = true;
      confirmMarkUsedBtn.innerHTML = `
        <div class="animate-spin h-3.5 w-3.5 border-2 border-red-400 border-t-transparent rounded-full"></div>
        <span>Eliminando...</span>
      `;
      markUsedError.classList.add("hidden");

      try {
        const fd = new FormData();
        fd.append("contribution_id", String(targetMarkUsedId));
        const res = await fetch("/api/admin/contributions/mark-used", { method: "POST", body: fd });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || "Error al procesar el aporte.");

        closeMarkUsedModal();
        loadContributions();
        window.dispatchEvent(new CustomEvent("refresh-contributions-badges"));
      } catch (err: any) {
        markUsedError.textContent = err.message || "Error al procesar el aporte.";
        markUsedError.classList.remove("hidden");
        confirmMarkUsedBtn.disabled = false;
        confirmMarkUsedBtn.textContent = "Reintentar";
      }
    });

    reviewForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      btnSubmitModal.disabled = true;
      btnSubmitModal.textContent = "Guardando...";
      modalStatus.className = "p-3 text-xs rounded-xl border bg-global-primary/10 border-global-primary/20 text-global-primary";
      modalStatus.textContent = "Actualizando el aporte...";
      modalStatus.classList.remove("hidden");
      const formData = new FormData(reviewForm as HTMLFormElement);
      const action = formData.get("action");

      if (action === "approve") {
        modalStatus.className = "p-3 text-xs rounded-xl border bg-emerald-600/10 border-emerald-600/20 text-emerald-400";
        modalStatus.textContent = "Aprobando aporte...";
      } else {
        modalStatus.className = "p-3 text-xs rounded-xl border bg-red-600/10 border-red-600/20 text-red-400";
        modalStatus.textContent = "Rechazando aporte...";
      }

      try {
        const res = await fetch("/api/admin/contributions/review", { method: "POST", body: formData });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error);
        modalStatus.className = "p-3 text-xs rounded-xl border bg-emerald-600/10 border-emerald-600/20 text-emerald-400";
        modalStatus.textContent = "¡Aporte procesado con éxito!";
        window.dispatchEvent(new CustomEvent("refresh-contributions-badges"));
        setTimeout(() => { closeReviewModal(); loadContributions(); }, 1500);
      } catch (err: any) {
        modalStatus.className = "p-3 text-xs rounded-xl border bg-red-600/10 border-red-600/20 text-red-400";
        modalStatus.textContent = err.message || "Error al procesar el aporte.";
        btnSubmitModal.disabled = false;
        btnSubmitModal.textContent = "Guardar Revisión";
      }
    });

    btnPending.addEventListener("click", () => {
      currentFilter = "pending";
      btnPending.className = "filter-tab rounded-lg px-4 py-2 text-xs sm:text-sm font-semibold transition-all cursor-pointer bg-global-surface text-global-text shadow-sm flex items-center justify-center gap-1.5";
      btnHistory.className = "filter-tab rounded-lg px-4 py-2 text-xs sm:text-sm font-semibold transition-all cursor-pointer text-global-text-muted hover:text-global-text flex items-center justify-center gap-1.5";
      renderContributions();
    });

    btnHistory.addEventListener("click", () => {
      currentFilter = "history";
      btnHistory.className = "filter-tab rounded-lg px-4 py-2 text-xs sm:text-sm font-semibold transition-all cursor-pointer bg-global-surface text-global-text shadow-sm flex items-center justify-center gap-1.5";
      btnPending.className = "filter-tab rounded-lg px-4 py-2 text-xs sm:text-sm font-semibold transition-all cursor-pointer text-global-text-muted hover:text-global-text flex items-center justify-center gap-1.5";
      renderContributions();
    });

    btnRefresh.addEventListener("click", () => {
      loadContributions();
      window.dispatchEvent(new CustomEvent("refresh-contributions-badges"));
    });

    loadContributions();
  });
</script>
