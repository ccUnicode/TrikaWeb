---
import Layout from "../../layouts/Layout.astro";
import AdminLayout from "../../components/AdminLayout.astro";
import { supabaseAdmin } from "../../lib/supabaseAdmin";
import ModalConfirm from "../../components/ModalConfirm.astro";
import { validateAdminSession } from "../../lib/adminAuth";

const isValid = await validateAdminSession(Astro.cookies);
if (!isValid) {
  return Astro.redirect("/admin/login");
}
// Obtener especialidades para el select
const { data: specialties, error: specError } = await supabaseAdmin
  .from("specialties")
  .select("id, name")
  .order("name");

if (specError) {
  console.error("Error fetching specialties:", specError);
}
---

<Layout 
  title="Gestionar Mallas Curriculares | TrikaWeb Admin"
  variant="admin"
  >
  <AdminLayout
    title="Gestionar Mallas"
    description="Administra los planes de estudio y sus configuraciones"
  >
    <!-- Main Content -->
    <section class="space-y-6">
      <!-- Add Malla Form -->
      <div
        class="rounded-2xl bg-global-surface border border-global-border p-6"
      >
        <h2 class="text-lg font-semibold text-global-text mb-4">
          Agregar nueva malla
        </h2>
        <div class="space-y-4">
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            <div>
              <label
                class="block text-sm font-medium text-global-text-muted mb-1.5"
                >Especialidad *</label
              >
              <div class="relative" id="custom-select-container">
                <!-- Hidden Input to preserve functionality -->
                <input type="hidden" id="specialty-select" value="" />

                <!-- Trigger Button -->
                <button
                  type="button"
                  id="custom-select-trigger"
                  class="w-full flex items-center justify-between rounded-xl border border-global-border bg-global-bg px-4 py-2 text-sm text-global-text-muted outline-none focus:border-global-primary focus:ring-1 focus:ring-global-primary transition-all cursor-pointer"
                >
                  <span id="custom-select-label">Seleccione una carrera</span>
                  <svg
                    id="custom-select-chevron"
                    class="h-4 w-4 text-gray-400 transition-transform"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    ><path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M19 9l-7 7-7-7"></path></svg
                  >
                </button>

                <!-- Dropdown List -->
                <div
                  id="custom-select-dropdown"
                  class="absolute z-50 left-0 right-0 mt-1.5 max-h-60 overflow-y-auto rounded-xl border border-global-border bg-global-card p-1 shadow-2xl hidden custom-select-scrollbar"
                >
                  <div
                    class="px-4 py-2 text-sm text-global-text-muted hover:bg-[#222938] hover:text-white rounded-lg cursor-pointer transition-colors"
                    data-value=""
                  >
                    Seleccione una carrera
                  </div>
                  {
                    specialties?.map((spec: any) => (
                      <div
                        class="px-4 py-2 text-sm text-global-text hover:bg-[#222938] hover:text-white rounded-lg cursor-pointer transition-colors"
                        data-value={spec.id}
                      >
                        {spec.name}
                      </div>
                    ))
                  }
                </div>
              </div>
            </div>
            <div>
              <label
                class="block text-sm font-medium text-global-text-muted mb-1.5"
                for="malla-year">Año de Publicación *</label
              >
              <div class="relative">
                <svg
                  class="absolute left-3 top-2.5 h-4 w-4 text-gray-400 pointer-events-none"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                  ></path></svg
                >
                <input
                  id="malla-year"
                  type="number"
                  placeholder="Ej: 2021"
                  class="w-full rounded-xl border border-global-border bg-global-bg pl-10 pr-4 py-2 text-sm text-global-text outline-none focus:border-global-primary focus:ring-1 focus:ring-global-primary transition-colors"
                />
              </div>
            </div>
            <div class="flex flex-col justify-center mt-2 sm:mt-0">
              <label class="flex items-center gap-3 cursor-pointer mt-5 group">
                <div class="relative flex items-center justify-center">
                  <input
                    type="checkbox"
                    id="malla-current"
                    class="peer appearance-none w-5 h-5 rounded-md border border-gray-600 bg-gray-800 checked:bg-green-500 checked:border-green-500 focus:ring-2 focus:ring-green-500 focus:ring-offset-2 focus:ring-offset-[#161b22] transition-all cursor-pointer"
                  />
                  <svg
                    class="absolute w-3.5 h-3.5 text-black pointer-events-none opacity-0 peer-checked:opacity-100 transition-opacity"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    ><path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="3"
                      d="M5 13l4 4L19 7"></path></svg
                  >
                </div>
                <span
                  class="text-sm font-medium text-global-text group-hover:text-white transition-colors"
                  >¿Es la malla actual?</span
                >
              </label>
            </div>
          </div>
          <div class="flex gap-3 items-center">
            <button
              id="add-malla-btn"
              type="button"
              class="rounded-xl bg-global-primary px-6 py-2 text-sm font-semibold text-black transition hover:bg-global-primary-hover cursor-pointer inline-flex items-center gap-2 shadow-lg shadow-global-primary/20 active:scale-95"
            >
              <svg
                class="w-4 h-4"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                stroke-width="2.5"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 5v14m7-7H5"></path></svg
              >
              Añadir malla
            </button>
            <span id="add-feedback" class="text-sm hidden"></span>
          </div>
        </div>
      </div>

      <!-- Mallas List -->
      <div
        class="rounded-2xl bg-global-surface border border-global-border p-6"
      >
        <div
          class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-4"
        >
          <h2 class="text-lg font-semibold text-global-text">
            Lista de mallas
          </h2>
          <div class="flex gap-2">
            <button
              id="refresh-btn"
              type="button"
              class="rounded-lg border border-global-border bg-global-card px-3 py-2 text-sm text-global-text transition hover:bg-global-border cursor-pointer"
            >
              <svg
                class="w-4 h-4"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
                ></path></svg
              >
            </button>
          </div>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm text-global-text-muted">
            <thead class="bg-global-bg/50 text-xs uppercase text-global-text">
              <tr>
                <th scope="col" class="px-6 py-3">Especialidad</th>
                <th scope="col" class="px-6 py-3 text-center">Año</th>
                <th scope="col" class="px-6 py-3 text-center">Cursos</th>
                <th scope="col" class="px-6 py-3 text-center">Estado</th>
                <th scope="col" class="px-6 py-3 text-center">Visibilidad</th>
                <th scope="col" class="px-6 py-3 text-center">Acciones</th>
              </tr>
            </thead>
            <tbody id="mallas-list" class="divide-y divide-global-border">
              <!-- Filas dinámicas -->
            </tbody>
          </table>
        </div>

        <div id="loading-state" class="text-center py-8">
          <div
            class="animate-spin h-8 w-8 border-2 border-global-primary border-t-transparent rounded-full mx-auto mb-3"
          >
          </div>
          <p class="text-sm text-global-text-muted">Cargando mallas...</p>
        </div>

        <div id="empty-state" class="hidden text-center py-8">
          <p class="text-global-text font-medium">No hay mallas registradas</p>
        </div>

        <!-- Pagination -->
        <div
          id="pagination"
          class="hidden flex items-center justify-center gap-4 py-4 mt-4"
        >
          <button
            id="prev-btn"
            class="rounded-lg border border-global-border bg-global-card px-4 py-2 text-sm text-global-text hover:bg-global-border disabled:opacity-50 cursor-pointer disabled:cursor-not-allowed"
            >← Anterior</button
          >
          <span id="page-info" class="text-sm text-global-text-muted"
            >Página 1</span
          >
          <button
            id="next-btn"
            class="rounded-lg border border-global-border bg-global-card px-4 py-2 text-sm text-global-text hover:bg-global-border disabled:opacity-50 cursor-pointer disabled:cursor-not-allowed"
            >Siguiente →</button
          >
        </div>
      </div>
    </section>

    <!-- Edit Modal -->
    <div
      id="edit-modal"
      class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 backdrop-blur-sm p-4 animate-modal-backdrop"
    >
      <div
        class="w-full max-w-md rounded-2xl bg-[#1e2430] border border-gray-800 p-6 shadow-2xl animate-modal-content"
      >
        <div class="flex items-center justify-between mb-6">
          <h3 class="text-xl font-bold text-white">Editar Malla</h3>
          <button
            id="close-edit-modal-btn"
            class="text-gray-400 hover:text-white transition-colors cursor-pointer"
          >
            <svg
              class="w-6 h-6"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M6 18L18 6M6 6l12 12"></path></svg
            >
          </button>
        </div>
        <div class="flex flex-col gap-4">
          <input type="hidden" id="edit-malla-id" />
          <input type="hidden" id="edit-specialty-id" />
          <div>
            <label
              class="block text-sm font-medium text-global-text-muted mb-1.5"
              for="edit-malla-year">Año *</label
            >
            <input
              id="edit-malla-year"
              type="number"
              class="w-full rounded-xl border border-global-border bg-global-bg px-4 py-2 text-sm text-global-text outline-none focus:border-global-primary focus:ring-1 focus:ring-global-primary transition-colors"
            />
          </div>
          <label class="flex items-center gap-3 cursor-pointer mt-2 group">
            <div class="relative flex items-center justify-center">
              <input
                type="checkbox"
                id="edit-malla-current"
                class="peer appearance-none w-5 h-5 rounded-md border border-gray-600 bg-gray-800 checked:bg-green-500 checked:border-green-500 focus:ring-2 focus:ring-green-500 transition-all cursor-pointer"
              />
              <svg
                class="absolute w-3.5 h-3.5 text-black pointer-events-none opacity-0 peer-checked:opacity-100 transition-opacity"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="3"
                  d="M5 13l4 4L19 7"></path></svg
              >
            </div>
            <span
              class="text-sm font-medium text-global-text group-hover:text-white transition-colors"
              >¿Es la malla actual (Vigente)?</span
            >
          </label>
          <div class="flex justify-end gap-3 mt-4">
            <button
              id="cancel-edit-btn"
              class="px-4 py-2 rounded-xl text-sm font-medium text-global-text bg-gray-800 hover:bg-gray-700 transition-colors cursor-pointer"
              >Cancelar</button
            >
            <button
              id="save-edit-btn"
              class="px-4 py-2 rounded-xl text-sm font-medium text-black bg-global-primary hover:bg-global-primary-hover transition-colors shadow-lg shadow-global-primary/20 cursor-pointer"
              >Guardar Cambios</button
            >
          </div>
          <span id="edit-feedback" class="text-sm hidden text-center"></span>
        </div>
      </div>
    </div>

    <!-- Delete Modal -->
    <input type="hidden" id="delete-malla-id" />
    <ModalConfirm
      id="delete-modal"
      title="¿Eliminar malla?"
      message="Esta acción borrará la malla y todos sus cursos posicionados. Esta acción no se puede deshacer."
      confirmId="confirm-delete-btn"
      cancelId="cancel-delete-btn"
      feedbackId="delete-feedback"
    />
  </AdminLayout>
</Layout>
<script>
  let currentPage = 1;
  const pageSize = 15;

  const mallasList = document.getElementById("mallas-list");
  const emptyState = document.getElementById("empty-state");
  const loadingState = document.getElementById("loading-state");
  const refreshBtn = document.getElementById("refresh-btn");
  const pagination = document.getElementById("pagination");
  const prevBtn = document.getElementById("prev-btn") as HTMLButtonElement;
  const nextBtn = document.getElementById("next-btn") as HTMLButtonElement;
  const pageInfo = document.getElementById("page-info");
  const addFeedback = document.getElementById("add-feedback");

  // Modal Elements
  const editModal = document.getElementById("edit-modal");
  const deleteModal = document.getElementById("delete-modal");

  // Inputs
  const addMallaBtn = document.getElementById("add-malla-btn");
  const specSelect = document.getElementById(
    "specialty-select",
  ) as HTMLInputElement;
  const yearInput = document.getElementById("malla-year") as HTMLInputElement;
  const currentCheck = document.getElementById(
    "malla-current",
  ) as HTMLInputElement;

  // Custom Select Elements
  const customSelectContainer = document.getElementById(
    "custom-select-container",
  );
  const customSelectTrigger = document.getElementById("custom-select-trigger");
  const customSelectDropdown = document.getElementById(
    "custom-select-dropdown",
  );
  const customSelectLabel = document.getElementById("custom-select-label");
  const customSelectChevron = document.getElementById("custom-select-chevron");

  async function loadMallas(page: number = 1) {
    currentPage = page;
    loadingState?.classList.remove("hidden");
    emptyState?.classList.add("hidden");
    pagination?.classList.add("hidden");
    if (mallasList) mallasList.innerHTML = "";

    try {
      const res = await fetch("/api/admin/mallas", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        credentials: "include",
        body: JSON.stringify({ page, pageSize }),
      });
      const data = await res.json();

      if (!data.ok) throw new Error(data.error);

      if (data.plans.length === 0) {
        emptyState?.classList.remove("hidden");
      } else {
        renderMallas(data.plans);
        if (data.pagination.totalPages > 1) {
          pagination?.classList.remove("hidden");
          if (pageInfo)
            pageInfo.textContent = `Página ${data.pagination.page} de ${data.pagination.totalPages}`;
          if (prevBtn) prevBtn.disabled = data.pagination.page <= 1;
          if (nextBtn)
            nextBtn.disabled =
              data.pagination.page >= data.pagination.totalPages;
        }
      }
    } catch (err: any) {
      console.error(err);
      if (mallasList)
        mallasList.innerHTML = `<tr><td colspan="6" class="text-center text-red-400 py-4">${err.message}</td></tr>`;
    } finally {
      loadingState?.classList.add("hidden");
    }
  }

  function renderMallas(plans: any[]) {
    if (!mallasList) return;
    mallasList.innerHTML = plans
      .map((p) => {
        const isCurrentBadge = p.is_current
          ? '<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-semibold border transition-colors shrink-0 bg-[#22c55e]/10 text-[#22c55e] border-[#22c55e]/20 shadow-[0_0_10px_rgba(34,197,94,0.1)]">Vigente</span>'
          : '<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-semibold border transition-colors shrink-0 bg-gray-500/10 text-gray-400 border-gray-500/20">Histórica</span>';

        const isPublishedBadge = p.is_published
          ? `<button onclick="toggleMallaState('${p.id}')" class="inline-flex items-center justify-center shrink-0 transition-all cursor-pointer font-semibold focus:outline-none disabled:opacity-50 disabled:cursor-not-allowed px-2.5 py-1 text-[11px] rounded-full gap-1.5 bg-blue-500/10 text-blue-400 border border-blue-500/30 hover:bg-blue-500/20" title="Clic para ocultar del público"><svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>Público</button>`
          : `<button onclick="toggleMallaState('${p.id}')" class="inline-flex items-center justify-center shrink-0 transition-all cursor-pointer font-semibold focus:outline-none disabled:opacity-50 disabled:cursor-not-allowed px-2.5 py-1 text-[11px] rounded-full gap-1.5 bg-gray-500/10 text-gray-400 border border-gray-500/30 hover:bg-gray-500/20" title="Clic para publicar al público"><svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /><path d="M3 3l18 18" /></svg>Oculto</button>`;

        const coursesCount = p.plan_courses?.[0]?.count || 0;
        const coursesBadge =
          coursesCount > 0
            ? `<span class="font-medium text-white">${coursesCount}</span>`
            : `<span class="text-gray-500">0</span>`;

        const escapedPlan = JSON.stringify({
          id: p.id,
          specialty_id: p.specialties?.id,
          year: p.year,
          is_current: p.is_current,
        }).replace(/"/g, "&quot;");

        return `
                    <tr class="hover:bg-global-bg/50 transition-colors">
                        <td class="px-6 py-4 font-medium text-global-text">${p.specialties?.name || "Desconocida"}</td>
                        <td class="px-6 py-4 text-center text-white">${p.year}</td>
                        <td class="px-6 py-4 text-center">${coursesBadge}</td>
                        <td class="px-6 py-4 text-center">${isCurrentBadge}</td>
                        <td class="px-6 py-4 text-center">${isPublishedBadge}</td>
                        <td class="px-6 py-4 text-right">
                            <div class="flex items-center justify-end gap-2">
                                <a href="/admin/mallas/builder/${p.id}" class="inline-flex items-center justify-center shrink-0 transition-all cursor-pointer font-semibold shadow-sm focus:outline-none active:scale-95 disabled:opacity-50 disabled:cursor-not-allowed px-3 py-1.5 rounded-full gap-0 bg-[#22c55e] text-black hover:bg-[#1eb355] border border-transparent shadow-md shadow-[#22c55e]/20" title="Armar Malla">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                                </a>
                                <button onclick="openEditModal(${escapedPlan})" class="inline-flex items-center justify-center shrink-0 transition-all cursor-pointer font-semibold shadow-sm focus:outline-none active:scale-95 disabled:opacity-50 disabled:cursor-not-allowed px-3 py-1.5 rounded-full gap-0 bg-blue-500/10 text-blue-400 border border-blue-500/30 hover:bg-blue-500/20" title="Editar Configuración">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" /></svg>
                                </button>
                                <button onclick="openDeleteModal('${p.id}')" class="inline-flex items-center justify-center shrink-0 transition-all cursor-pointer font-semibold shadow-sm focus:outline-none active:scale-95 disabled:opacity-50 disabled:cursor-not-allowed px-3 py-1.5 rounded-full gap-0 bg-red-500/10 text-red-400 border border-red-500/30 hover:bg-red-500/20" title="Eliminar Malla">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M3 6h18" /><path d="M8 6V4h8v2" /><path d="M19 6l-1 14H6L5 6" /><path d="M10 11v5" /><path d="M14 11v5" /></svg>
                                </button>
                            </div>
                        </td>
                    </tr>
                `;
      })
      .join("");
  }

  // Toggle de publicar/ocultar malla
  (window as any).toggleMallaState = async function (planId: string) {
    try {
      const res = await fetch("/api/admin/toggle-malla", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        credentials: "include",
        body: JSON.stringify({ planId }),
      });
      const data = await res.json();

      if (data.ok) {
        showFeedback(
          data.is_published ? "Malla publicada" : "Malla ocultada",
          "success",
        );
        loadMallas(currentPage);
      } else {
        showFeedback(data.error || "Error al cambiar estado", "error");
      }
    } catch (err) {
      showFeedback("Error de conexión", "error");
    }
  };

  async function addMalla() {
    const specialty_id = specSelect?.value;
    const year = parseInt(yearInput?.value);
    const is_current = currentCheck?.checked;

    if (!specialty_id || !year) {
      showFeedback("Llene los campos obligatorios", "error");
      return;
    }

    addMallaBtn?.classList.add("opacity-50", "pointer-events-none");
    showFeedback("Guardando...", "info");

    try {
      const res = await fetch("/api/admin/add-malla", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        credentials: "include",
        body: JSON.stringify({ specialty_id, year, is_current }),
      });
      const data = await res.json();

      if (data.ok) {
        showFeedback("Malla guardada correctamente", "success");
        yearInput.value = "";
        currentCheck.checked = false;
        if (specSelect) specSelect.value = "";
        if (customSelectLabel) {
          customSelectLabel.textContent = "Seleccione una carrera";
          customSelectLabel.classList.add("text-global-text-muted");
          customSelectLabel.classList.remove("text-white");
        }
        loadMallas(1);
      } else {
        showFeedback(data.error || "Error al guardar", "error");
      }
    } catch (err: any) {
      showFeedback("Error de conexión", "error");
    } finally {
      addMallaBtn?.classList.remove("opacity-50", "pointer-events-none");
    }
  }

  function showFeedback(msg: string, type: string) {
    if (!addFeedback) return;
    addFeedback.textContent = msg;
    addFeedback.className = "text-sm";
    if (type === "success") addFeedback.classList.add("text-green-400");
    else if (type === "error") addFeedback.classList.add("text-red-400");
    else addFeedback.classList.add("text-global-text-muted");

    if (type !== "info")
      setTimeout(() => addFeedback.classList.add("hidden"), 4000);
    else addFeedback.classList.remove("hidden");
  }

  // --- Modals Logic ---

  // Editar Malla
  const editId = document.getElementById("edit-malla-id") as HTMLInputElement;
  const editSpecId = document.getElementById(
    "edit-specialty-id",
  ) as HTMLInputElement;
  const editYear = document.getElementById(
    "edit-malla-year",
  ) as HTMLInputElement;
  const editCurrent = document.getElementById(
    "edit-malla-current",
  ) as HTMLInputElement;
  const editFeedback = document.getElementById("edit-feedback");

  (window as any).openEditModal = function (plan: any) {
    editId.value = plan.id;
    editSpecId.value = plan.specialty_id;
    editYear.value = plan.year;
    editCurrent.checked = plan.is_current;

    if (editFeedback) editFeedback.classList.add("hidden");
    editModal?.classList.remove("hidden");
    editModal?.classList.add("flex");
  };

  function closeEditModal() {
    editModal?.classList.add("hidden");
    editModal?.classList.remove("flex");
  }

  async function submitEditMalla() {
    const id = editId.value;
    const specialty_id = editSpecId.value;
    const year = parseInt(editYear.value);
    const is_current = editCurrent.checked;

    if (!year) return;

    const saveBtn = document.getElementById("save-edit-btn");
    saveBtn?.classList.add("opacity-50", "pointer-events-none");
    if (editFeedback) {
      editFeedback.textContent = "Guardando...";
      editFeedback.className = "text-sm text-global-text-muted mt-4 block";
    }

    try {
      const res = await fetch("/api/admin/edit-malla", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        credentials: "include",
        body: JSON.stringify({ id, specialty_id, year, is_current }),
      });
      const data = await res.json();

      if (data.ok) {
        closeEditModal();
        showFeedback("Malla actualizada correctamente", "success");
        loadMallas(currentPage);
      } else {
        if (editFeedback) {
          editFeedback.textContent = data.error || "Error al actualizar";
          editFeedback.className = "text-sm text-red-400 mt-4 block";
        }
      }
    } catch (err) {
      if (editFeedback) {
        editFeedback.textContent = "Error de conexión";
        editFeedback.className = "text-sm text-red-400 mt-4 block";
      }
    } finally {
      saveBtn?.classList.remove("opacity-50", "pointer-events-none");
    }
  }

  // Eliminar Malla
  const deleteId = document.getElementById(
    "delete-malla-id",
  ) as HTMLInputElement;
  const deleteFeedback = document.getElementById("delete-feedback");

  (window as any).openDeleteModal = function (id: string) {
    deleteId.value = id;
    if (deleteFeedback) deleteFeedback.classList.add("hidden");
    deleteModal?.classList.remove("hidden");
    deleteModal?.classList.add("flex");
  };

  function closeDeleteModal() {
    deleteModal?.classList.add("hidden");
    deleteModal?.classList.remove("flex");
  }

  async function submitDeleteMalla() {
    const id = deleteId.value;
    const confBtn = document.getElementById("confirm-delete-btn");
    confBtn?.classList.add("opacity-50", "pointer-events-none");

    if (deleteFeedback) {
      deleteFeedback.textContent = "Eliminando...";
      deleteFeedback.className =
        "text-sm text-global-text-muted mt-3 block text-left";
    }

    try {
      const res = await fetch("/api/admin/delete-malla", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        credentials: "include",
        body: JSON.stringify({ id }),
      });
      const data = await res.json();

      if (data.ok) {
        closeDeleteModal();
        showFeedback("Malla eliminada correctamente", "success");
        loadMallas(currentPage);
      } else {
        if (deleteFeedback) {
          deleteFeedback.textContent = data.error || "Error al eliminar";
          deleteFeedback.className =
            "text-sm text-red-400 mt-3 block text-left";
        }
      }
    } catch (err) {
      if (deleteFeedback) {
        deleteFeedback.textContent = "Error de conexión";
        deleteFeedback.className = "text-sm text-red-400 mt-3 block text-left";
      }
    } finally {
      confBtn?.classList.remove("opacity-50", "pointer-events-none");
    }
  }

  // Event Listeners para Modales
  document
    .getElementById("close-edit-modal-btn")
    ?.addEventListener("click", closeEditModal);
  document
    .getElementById("cancel-edit-btn")
    ?.addEventListener("click", closeEditModal);
  document
    .getElementById("save-edit-btn")
    ?.addEventListener("click", submitEditMalla);

  document
    .getElementById("cancel-delete-btn")
    ?.addEventListener("click", closeDeleteModal);
  document
    .getElementById("confirm-delete-btn")
    ?.addEventListener("click", submitDeleteMalla);

  refreshBtn?.addEventListener("click", () => loadMallas(currentPage));
  prevBtn?.addEventListener("click", () => loadMallas(currentPage - 1));
  nextBtn?.addEventListener("click", () => loadMallas(currentPage + 1));
  addMallaBtn?.addEventListener("click", addMalla);

  // Custom Select Events
  customSelectTrigger?.addEventListener("click", (e) => {
    e.stopPropagation();
    const isHidden = customSelectDropdown?.classList.contains("hidden");
    if (isHidden) {
      customSelectDropdown?.classList.remove("hidden");
      customSelectChevron?.classList.add("rotate-180");
      customSelectTrigger?.classList.add(
        "border-global-primary",
        "ring-1",
        "ring-global-primary",
      );
    } else {
      closeCustomSelect();
    }
  });

  function closeCustomSelect() {
    customSelectDropdown?.classList.add("hidden");
    customSelectChevron?.classList.remove("rotate-180");
    customSelectTrigger?.classList.remove(
      "border-global-primary",
      "ring-1",
      "ring-global-primary",
    );
  }

  document.addEventListener("click", (e) => {
    if (!customSelectContainer?.contains(e.target as Node)) {
      closeCustomSelect();
    }
  });

  customSelectDropdown?.querySelectorAll("[data-value]").forEach((item) => {
    item.addEventListener("click", () => {
      const val = item.getAttribute("data-value") || "";
      const text = item.textContent?.trim() || "";
      if (specSelect) {
        specSelect.value = val;
      }
      if (customSelectLabel) {
        customSelectLabel.textContent = text;
        if (val === "") {
          customSelectLabel.classList.add("text-global-text-muted");
          customSelectLabel.classList.remove("text-white");
        } else {
          customSelectLabel.classList.remove("text-global-text-muted");
          customSelectLabel.classList.add("text-white");
        }
      }
      closeCustomSelect();
    });
  });

  loadMallas();
</script>

