---
/*
Página de perfil de un profesor.
Muestra:
  - Avatar, nombre y puntuación general
  - Barras de estadísticas por dimensión (didáctica, dificultad, etc.)
  - Cursos asociados
  - Comentarios paginados
  - Modal para calificar y botón para eliminar calificación propia
*/
export const prerender = false;
import Layout from "../../layouts/Layout.astro";
import TeacherRatingForm from "../../components/TeacherRatingForm.astro";
import TeacherAvatar from "../../components/TeacherAvatar.astro";
import ModalConfirm from "../../components/ModalConfirm.astro";
import { getTeacherDetail } from "../../lib/data";
import { getUserSession } from "../../lib/auth";

const { user } = await getUserSession(Astro.cookies);
const isLoggedIn = !!user;

const teacherId = Number(Astro.params.id);
const page = Number(Astro.url.searchParams.get("page") ?? 1);
const pageSize = Number(Astro.url.searchParams.get("pageSize") ?? 5);

if (!teacherId) {
  return Astro.redirect("/profesores");
}

const detail = await getTeacherDetail(teacherId, page, pageSize);

if (!detail) {
  return Astro.redirect("/profesores");
}

const statsItems = [
  {
    label: "Didáctica",
    value: detail.stats.avg_didactic,
    description: "Capacidad para explicar y hacerse entender.",
  },
  {
    label: "Dificultad",
    value: detail.stats.avg_difficulty,
    description: "Nivel de exigencia en exámenes y tareas.",
  },
  {
    label: "Material",
    value: detail.stats.avg_resources,
    description: "Avance de cursos usando presentaciones, libros, etc.",
  },
  {
    label: "Responsabilidad",
    value: detail.stats.avg_responsability,
    description: "Puntualidad en llegar y subir notas.",
  },
  {
    label: "Calif. justa",
    value: detail.stats.avg_grading,
    description: "¿Qué tan justo es calificando?",
  },
];

const formatScore = (n: number | null) =>
  n === null || n === undefined ? "—" : Number(n).toFixed(1);

const formatDate = (iso: string) => {
  const date = new Date(iso);
  if (Number.isNaN(date.getTime())) return "Fecha desconocida";
  return date.toLocaleDateString("es-PE", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
};

/**
 * Define el color de la barra de estadística según el puntaje:
 * 0-2: Rojo (Malo), 2-3: Naranja (Regular), 3-4: Amarillo (Bueno), 4-5: Verde (Excelente)
 */
const getBarColor = (value: number | null): string => {
  if (value === null || value === undefined) return "#6B7280";
  if (value <= 2.0) return "#EF4444";
  if (value <= 3.0) return "#F97316";
  if (value <= 4.0) return "#EAB308";
  return "#22C55E";
};

const safeBio =
  detail.teacher.bio && detail.teacher.bio.trim().length > 0
    ? detail.teacher.bio
    : "Sin descripción disponible.";

/** Construye la URL pública del avatar desde Supabase Storage o usa el fallback */
const toAvatarUrl = (src?: string | null) => {
  const fallback = "/img/fallback_teacher.jpeg";
  const cleanSrc = (src || "").trim();
  if (!cleanSrc) return fallback;
  if (cleanSrc.startsWith("http")) return cleanSrc;
  const base = import.meta.env.PUBLIC_SUPABASE_URL;
  if (!base) return fallback;
  const clean = cleanSrc.replace(/^\/+/, "");
  return `${base}/storage/v1/object/public/avatars/${clean}`;
};
const avatarUrl = toAvatarUrl(detail.teacher.avatar_url);

const toStudentAvatarUrl = (src?: string | null) => {
  const cleanSrc = (src || "").trim();
  if (!cleanSrc) return null;
  if (cleanSrc.startsWith("http")) return cleanSrc;
  const base = import.meta.env.PUBLIC_SUPABASE_URL;
  if (!base) return null;
  const clean = cleanSrc.replace(/^\/+/, "");
  return `${base}/storage/v1/object/public/avatars/${clean}`;
};
---

<Layout title={`Profesor ${detail.teacher.full_name}`}>
  <main class="mx-auto max-w-7xl px-2 sm:px-4 py-10 text-global-text">
    <!-- Contenedor principal con fondo estructurado -->
    <div
      class="rounded-3xl p-4 sm:p-10 shadow-2xl bg-global-surface border border-global-border"
    >
      <div class="grid gap-6 lg:grid-cols-3 items-stretch">
        <!-- Columna izquierda: avatar, nombre, score y CTA -->
        <section
          class="rounded-3xl bg-global-card border border-global-border p-6 flex flex-col shadow-lg"
        >
          <div class="flex flex-col items-center gap-4">
            <TeacherAvatar
              name={detail.teacher.full_name}
              avatarSrc={detail.teacher.avatar_url}
              size="lg"
            />
            <div
              class="w-full rounded-2xl border border-global-border bg-global-surface px-4 py-3 text-center"
            >
              <p class="text-lg font-semibold">{detail.teacher.full_name}</p>
            </div>
            <div
              class="w-full flex items-center justify-between bg-global-bg/60 rounded-2xl px-4 py-3"
            >
              <div class="text-sm text-global-text-muted leading-tight text-left">
                <p>Puntuación</p>
                <p>General</p>
              </div>
              <div class="text-right">
                <p class="text-4xl font-bold">
                  {formatScore(detail.teacher.avg_overall)}
                </p>
                <p class="text-xs text-global-text-muted mt-1">
                  {detail.teacher.rating_count} reseñas
                </p>
              </div>
            </div>
          </div>

          <div class="mt-auto pt-6 flex flex-col gap-2">
            <button
              id="open-rating-modal"
              type="button"
              data-is-logged-in={isLoggedIn ? "true" : "false"}
              class="w-full rounded-2xl bg-global-primary hover:bg-global-primary-hover px-4 py-3 text-sm font-bold text-black shadow-md transition-all active:scale-95 cursor-pointer text-center"
            >
              Califica al profesor
            </button>
            <!-- Botón para eliminar calificación (oculto por defecto) -->
            <button
              id="delete-rating-btn"
              type="button"
              data-teacher-id={detail.teacher.id}
              class="hidden w-full items-center justify-center gap-2 rounded-2xl border border-red-500/20 bg-red-500/10 px-4 py-2.5 text-sm font-semibold text-red-400 transition-all hover:bg-red-500/20 hover:text-red-300 cursor-pointer shadow-sm active:scale-95 text-center"
            >
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
              </svg>
              <span>Eliminar mi calificación</span>
            </button>
            <p
              id="rating-status-msg"
              class="text-xs text-center text-global-text-muted"
            >
            </p>
          </div>
        </section>

        <!-- Columna centro: descripción y estadísticas -->
        <section
          class="rounded-3xl bg-global-card border border-global-border-subtle p-6 space-y-6 shadow-lg"
        >
          <div class="space-y-3">
            <h2 class="text-2xl font-semibold">Descripción</h2>
            <p
              class="text-global-text-muted leading-relaxed max-h-40 overflow-y-auto pr-1 teacher-scroll text-justify-bio"
            >
              {safeBio}
            </p>
          </div>
          <div class="space-y-4">
            <h3 class="text-2xl font-semibold">Estadísticas</h3>
            <div class="space-y-3">
              {
                statsItems.map((item) => (
                  <div class="flex items-center gap-3">
                    <div class="min-w-[130px] flex items-center gap-2">
                      <span>{item.label}</span>
                      <div class="relative group/info cursor-help">
                        <svg
                          class="w-4 h-4 text-global-text-muted hover:text-global-primary transition-colors"
                          fill="none"
                          stroke="currentColor"
                          viewBox="0 0 24 24"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                          />
                        </svg>
                        <div class="absolute left-1/2 -translate-x-1/2 bottom-full mb-2 w-48 p-2 bg-global-surface border border-global-border rounded-lg text-xs text-center text-global-text shadow-xl opacity-0 invisible group-hover/info:opacity-100 group-hover/info:visible transition-all z-20 pointer-events-none">
                          {item.description}
                          <div class="absolute left-1/2 -translate-x-1/2 top-full w-0 h-0 border-x-4 border-x-transparent border-t-4 border-t-global-border" />
                        </div>
                      </div>
                    </div>
                    <div
                      class="flex-1 h-8 rounded-md border border-global-border-subtle relative overflow-hidden"
                      style="background-color: rgba(42, 50, 64, 0.3);"
                    >
                      {item.value !== null ? (
                        <div
                          class="absolute inset-y-0 left-0"
                          style={{
                            width: `${Math.min(100, (item.value / 5) * 100)}%`,
                            backgroundColor: "#2A3240",
                          }}
                        />
                      ) : null}
                      <span class="absolute right-2 top-1/2 -translate-y-1/2 text-sm font-semibold">
                        {formatScore(item.value)}
                      </span>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        </section>

        <!-- Columna derecha: cursos y comentarios -->
        <section
          class="rounded-3xl bg-global-card border border-global-border-subtle p-6 space-y-6 shadow-lg"
        >
          <div class="space-y-3">
            <h3 class="text-2xl font-semibold text-center">Cursos</h3>
            {
              detail.courses.length === 0 ? (
                <p class="text-center text-global-text-muted text-sm">
                  Sin cursos asociados.
                </p>
              ) : (
                <div class="flex flex-col gap-3">
                  {detail.courses.map((course) => (
                    <a
                      href={`/curso/${course.code}`}
                      class="rounded-xl border border-global-border-subtle px-4 py-2 text-center font-medium hover:border-global-primary transition"
                      style="background-color: #2A3240;"
                    >
                      {course.code} · {course.name}
                    </a>
                  ))}
                </div>
              )
            }
          </div>

          <div class="space-y-3">
            <h3 class="text-2xl font-semibold text-center">Comentarios</h3>
            {
              detail.reviews.length === 0 ? (
                <p class="text-center text-global-text-muted text-sm">
                  Sin comentarios visibles.
                </p>
              ) : (
                <div class="flex flex-col gap-3 max-h-80 overflow-y-auto pr-2 teacher-scroll">
                  {detail.reviews.map((review) => (
                    <article
                      class="rounded-xl border border-global-border-subtle px-4 py-3 space-y-2"
                      style="background-color: #2A3240;"
                    >
                      <header class="flex items-center justify-between text-sm">
                        <div class="flex items-center gap-3">
                          <div class="w-8 h-8 flex-shrink-0 rounded-full border border-global-border bg-global-background overflow-hidden flex items-center justify-center">
                            {(!review.is_anonymous && toStudentAvatarUrl(review.avatar_url)) ? (
                              <img src={toStudentAvatarUrl(review.avatar_url)} class="w-full h-full object-cover" />
                            ) : (
                              <svg class="w-4 h-4 text-global-text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                            )}
                          </div>
                          <div class="leading-tight">
                            <span class="font-semibold block">
                              {review.is_anonymous === false ? (
                                review.user_id ? (
                                  <a href={review.user_id === user?.id ? "/profile" : `/profile/${review.user_id}`} class="hover:text-global-primary transition-colors">
                                    {review.user_name || "Estudiante"}
                                  </a>
                                ) : (
                                  review.user_name || "Estudiante"
                                )
                              ) : (
                                "Anónimo"
                              )}
                            </span>
                            <time class="text-[11px] text-global-text-muted/80">
                              {formatDate(review.created_at)}
                            </time>
                          </div>
                        </div>
                        <span class="text-global-text-muted font-semibold">
                          {formatScore(review.overall)}
                        </span>
                      </header>
                      {review.comment && (
                        <p class="text-sm text-global-text-muted leading-relaxed text-justify max-h-24 overflow-y-auto teacher-scroll pr-1">
                          {review.comment}
                        </p>
                      )}
                    </article>
                  ))}
                </div>
              )
            }
            {
              detail.pagination.totalPages > 1 && (
                <div class="flex items-center justify-between text-sm text-global-text-muted">
                  <a
                    class={`px-3 py-2 rounded-lg border ${page > 1 ? "border-global-border hover:border-global-primary" : "border-transparent opacity-50 pointer-events-none"}`}
                    href={`/profesores/${teacherId}?page=${Math.max(1, page - 1)}&pageSize=${pageSize}`}
                  >
                    ← Anterior
                  </a>
                  <span>
                    Página {page} de {detail.pagination.totalPages}
                  </span>
                  <a
                    class={`px-3 py-2 rounded-lg border ${page < detail.pagination.totalPages ? "border-global-border hover:border-global-primary" : "border-transparent opacity-50 pointer-events-none"}`}
                    href={`/profesores/${teacherId}?page=${Math.min(detail.pagination.totalPages, page + 1)}&pageSize=${pageSize}`}
                  >
                    Siguiente →
                  </a>
                </div>
              )
            }
          </div>
        </section>
      </div>
    </div>
  </main>
</Layout>

<div
  id="rating-modal"
  class="hidden fixed inset-0 z-[60] flex items-center justify-center bg-black/60 backdrop-blur-sm p-4 sm:p-6 animate-modal-backdrop"
>
  <div
    class="rating-modal relative w-full max-w-3xl max-h-[92vh] overflow-y-auto rounded-3xl bg-global-card border border-global-border p-5 sm:p-6 shadow-2xl animate-modal-content teacher-scroll"
  >
    <button
      type="button"
      id="close-rating-modal"
      class="absolute right-5 top-5 text-xl text-global-text-muted hover:text-global-primary transition-colors cursor-pointer"
      aria-label="Cerrar"
    >
      ✕
    </button>
    <h3 class="text-xl font-bold mb-4 truncate pr-8">
      Calificar a {detail.teacher.full_name}
    </h3>
    <TeacherRatingForm
      teacherId={detail.teacher.id}
      avg={detail.teacher.avg_overall}
      count={detail.teacher.rating_count}
      showSummary={false}
    />
  </div>
</div>

<ModalConfirm
  id="delete-rating-modal"
  title="Eliminar Calificación"
  message="¿Estás seguro de que quieres eliminar tu calificación? Esta acción no se puede deshacer."
  confirmText="Sí, eliminar"
  cancelText="Cancelar"
  confirmId="confirm-delete-rating-btn"
  cancelId="cancel-delete-rating-btn"
/>

<style>
  /* Fuerza el formulario abierto dentro del modal y oculta el toggle interno */
  .rating-modal [data-toggle-form],
  .rating-modal .teacher-rating > div:first-child {
    display: none !important;
  }
  .rating-modal [data-rating-form] {
    display: block !important;
  }
  .rating-modal .teacher-rating {
    /* Mantener el borde del card pero quitar padding y background duplicado */
    background: transparent;
    padding: 0;
  }

  /* Animación suave de aparición del modal */
  @keyframes fade-in {
    from {
      opacity: 0;
      transform: scale(0.95);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .animate-fade-in {
    animation: fade-in 0.2s ease-out;
  }
</style>

<script>
  const openBtn = document.getElementById("open-rating-modal");
  const modal = document.getElementById("rating-modal");
  const closeBtn = document.getElementById("close-rating-modal");

  const openModal = () => {
    const logged = openBtn?.dataset.isLoggedIn === "true";
    if (!logged) {
      window.location.href = "/login?redirect=" + encodeURIComponent(window.location.pathname);
      return;
    }
    modal?.classList.remove("hidden");
  };
  const closeModal = () => modal?.classList.add("hidden");

  openBtn?.addEventListener("click", openModal);
  closeBtn?.addEventListener("click", closeModal);
  modal?.addEventListener("click", (e) => {
    if (e.target === modal) closeModal();
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeModal();
  });
</script>

<script>
  /**
   * Gestiona el flujo de eliminación de calificación:
   * 1. Consulta si el usuario ya votó (GET /api/profesores/:id/rate?device_id=...)
   * 2. Si ya votó, muestra el botón "Eliminar mi calificación"
   * 3. Al hacer clic, envía DELETE y recarga la página con stats actualizadas
   */
  const initDeleteRating = async () => {
    const deleteBtn = document.getElementById(
      "delete-rating-btn",
    ) as HTMLButtonElement | null;
    const statusMsg = document.getElementById("rating-status-msg");

    if (!deleteBtn) return;

    const teacherId = deleteBtn.dataset.teacherId;
    if (!teacherId) return;

    const logged = document.getElementById("open-rating-modal")?.dataset.isLoggedIn === "true";
    if (!logged) return;

    // Consulta si el usuario ya votó para mostrar/ocultar el botón de eliminar
    try {
      const response = await fetch(
        `/api/profesores/${teacherId}/rate`
      );
      if (response.ok) {
        const data = await response.json();
        if (data.hasVoted) {
          deleteBtn.classList.remove("hidden");
          deleteBtn.classList.add("flex");
          
          const openBtn = document.getElementById("open-rating-modal");
          if (openBtn) {
            openBtn.textContent = "Editar mi calificación";
          }
        }
      }
    } catch (err) {
      console.error("Error verificando votación:", err);
    }

    /* Manejo del modal de confirmación de eliminación */
    const deleteModal = document.getElementById("delete-rating-modal");
    const confirmDeleteBtn = document.getElementById("confirm-delete-rating-btn") as HTMLButtonElement;
    const cancelDeleteBtn = document.getElementById("cancel-delete-rating-btn");

    deleteBtn.addEventListener("click", () => {
      deleteModal?.classList.remove("hidden");
      deleteModal?.classList.add("flex");
    });

    cancelDeleteBtn?.addEventListener("click", () => {
      deleteModal?.classList.add("hidden");
      deleteModal?.classList.remove("flex");
    });

    confirmDeleteBtn?.addEventListener("click", async () => {
      confirmDeleteBtn.disabled = true;
      confirmDeleteBtn.textContent = "Eliminando...";
      const originalText = deleteBtn.innerHTML;
      deleteBtn.innerHTML = "<span>Eliminando...</span>";

      try {
        const response = await fetch(`/api/profesores/${teacherId}/rate`, {
          method: "DELETE",
          headers: { "Content-Type": "application/json" }
        });

        if (!response.ok) {
          const error = await response.json().catch(() => ({}));
          if (statusMsg) {
            statusMsg.textContent = error?.error ?? "Error al eliminar";
            statusMsg.classList.add("text-red-400");
          }
          confirmDeleteBtn.disabled = false;
          confirmDeleteBtn.textContent = "Sí, eliminar";
          deleteBtn.innerHTML = originalText;
          return;
        }

        if (statusMsg) {
          statusMsg.textContent = "¡Calificación eliminada! Recargando...";
          statusMsg.classList.remove("text-red-400");
          statusMsg.classList.add("text-green-500");
        }
        
        deleteModal?.classList.add("hidden");
        deleteModal?.classList.remove("flex");

        setTimeout(() => {
          window.location.reload();
        }, 1000);
      } catch (err) {
        console.error("Error eliminando calificación:", err);
        if (statusMsg) {
          statusMsg.textContent = "Error de conexión";
          statusMsg.classList.add("text-red-400");
        }
        deleteBtn.disabled = false;
        deleteBtn.textContent = "Eliminar mi calificación";
      }
    });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initDeleteRating, {
      once: true,
    });
  } else {
    initDeleteRating();
  }
</script>
