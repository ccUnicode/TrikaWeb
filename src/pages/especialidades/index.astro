---
export const prerender = false;
import Layout from "../../layouts/Layout.astro";
import { supabaseAdmin } from "../../lib/supabaseAdmin";
import Badge from "../../components/ui/Badge.astro";

// Obtener todos los planes publicados (is_published = true), con su especialidad y conteo de cursos
const { data: publishedPlans, error: plansError } = await supabaseAdmin
    .from("study_plans")
    .select(
        `
        id,
        year,
        is_current,
        specialties (
            id,
            name
        ),
        plan_courses (count)
    `,
        { count: "exact" },
    )
    .eq("is_published", true)
    .order("year", { ascending: false });

if (plansError) {
    console.error("Error fetching published plans:", plansError);
}

const plans = publishedPlans || [];

const uniqueSpecialties = new Map();
plans.forEach((plan: any) => {
    const specData = Array.isArray(plan.specialties) ? plan.specialties[0] : plan.specialties;
    const specId = specData?.id;
    if (!specId) return;

    if (!uniqueSpecialties.has(specId)) {
        uniqueSpecialties.set(specId, plan);
    } else {
        const existingPlan = uniqueSpecialties.get(specId);
        if (!existingPlan.is_current && plan.is_current) {
            uniqueSpecialties.set(specId, plan);
        } else if (existingPlan.is_current === plan.is_current && plan.year > existingPlan.year) {
            uniqueSpecialties.set(specId, plan);
        }
    }
});
const groupedPlans = Array.from(uniqueSpecialties.values());
---

<Layout
    title="Especialidades - Mallas Curriculares | TrikaWeb"
    description="Explora las mallas curriculares de todas las especialidades de la Universidad Nacional de Ingeniería. Visualiza planes de estudio, cursos y pre-requisitos."
    keywords="especialidades uni, mallas curriculares, plan de estudios, universidad nacional de ingenieria, carreras uni"
>
  <main class="mx-auto max-w-screen-xl px-4 sm:px-6 lg:px-12 py-10 space-y-8">
    <header class="flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <h1 class="text-3xl font-bold text-global-text">Especialidades</h1>
        <p class="text-global-text-muted mt-2">
          Explora las mallas curriculares vigentes de cada carrera.
        </p>
      </div>
    </header>

            <!-- Cards Grid -->
            {
                groupedPlans.length === 0 ? (
                    <div class="flex flex-col items-center justify-center py-20 text-global-text-muted rounded-2xl border border-dashed border-global-border bg-global-surface">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="48"
                            height="48"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="mb-4 opacity-50"
                        >
                            <circle cx="12" cy="12" r="10" />
                            <line x1="12" y1="8" x2="12" y2="12" />
                            <line x1="12" y1="16" x2="12.01" y2="16" />
                        </svg>
                        <p class="text-lg font-medium">
                            No hay mallas publicadas
                        </p>
                        <p class="text-sm mt-1">
                            Las mallas aparecerán aquí cuando un administrador
                            las marque como vigentes.
                        </p>
                    </div>
                ) : (
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 min-h-[720px] content-start">
                        {groupedPlans.map((plan: any) => {
                            const specData = Array.isArray(plan.specialties)
                                ? plan.specialties[0]
                                : plan.specialties;
                            const specName = specData?.name || "Especialidad";
                            const coursesCount =
                                plan.plan_courses?.[0]?.count || 0;

                            return (
                                <a
                                    href={`/especialidades/${plan.id}`}
                                    class="group flex flex-col items-center gap-4 rounded-2xl border border-global-border bg-global-card p-8 transition-all duration-300 hover:border-global-primary hover:shadow-[0_0_24px_rgba(34,197,94,0.15)] hover:scale-[1.02]"
                                >
                                    <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-global-primary/10 text-global-primary transition-colors group-hover:bg-global-primary/20">
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            width="32"
                                            height="32"
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="1.5"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                        >
                                            <rect
                                                x="3"
                                                y="3"
                                                width="7"
                                                height="7"
                                                rx="1"
                                            />
                                            <rect
                                                x="14"
                                                y="3"
                                                width="7"
                                                height="7"
                                                rx="1"
                                            />
                                            <rect
                                                x="3"
                                                y="14"
                                                width="7"
                                                height="7"
                                                rx="1"
                                            />
                                            <rect
                                                x="14"
                                                y="14"
                                                width="7"
                                                height="7"
                                                rx="1"
                                            />
                                            <path d="M10 6.5h4" />
                                            <path d="M6.5 10v4" />
                                            <path d="M17.5 10v4" />
                                            <path d="M10 17.5h4" />
                                        </svg>
                                    </div>
                                    <div class="text-center space-y-1">
                                        <h3 class="text-lg font-semibold text-global-text group-hover:text-global-primary transition-colors">
                                            {specName}
                                        </h3>
                                        <p class="text-sm text-global-text-muted">
                                            Plan de Estudios {plan.year} ·{" "}
                                            {coursesCount} cursos
                                        </p>
                                    </div>
                                    <div class="flex flex-col items-center gap-2 mt-2">
                                        {plan.is_current ? (
                                            <Badge intent="success">Vigente</Badge>
                                        ) : (
                                            <Badge intent="neutral">Histórica</Badge>
                                        )}
                                        <span class="inline-flex items-center gap-2 rounded-full bg-global-primary/10 px-4 py-1.5 text-xs font-semibold text-global-primary transition-colors group-hover:bg-global-primary group-hover:text-black">
                                            Ver malla curricular
                                            <svg
                                                xmlns="http://www.w3.org/2000/svg"
                                                width="14"
                                                height="14"
                                                viewBox="0 0 24 24"
                                                fill="none"
                                                stroke="currentColor"
                                                stroke-width="2"
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                            >
                                                <path d="M5 12h14" />
                                                <path d="m12 5 7 7-7 7" />
                                            </svg>
                                        </span>
                                    </div>
                                </a>
                            );
                        })}
                    </div>
                )
            }
  </main>
</Layout>
