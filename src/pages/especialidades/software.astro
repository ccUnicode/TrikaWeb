---
export const prerender = false;
import Layout from "../../layouts/Layout.astro";
import Curriculum from "../../components/Malla/Curriculum";
import { supabaseAdmin } from "../../lib/supabaseAdmin";
import type {
    CurriculumData,
    CurriculumCourse,
    CoursePrerequisite,
} from "../../lib/curriculumTypes";

console.log("========== [Malla] Inicio de queries ==========");

// 1. Buscar la especialidad por nombre
const { data: specialty, error: specError } = await supabaseAdmin
    .from("specialties")
    .select("id, name")
    .eq("name", "Ingeniería de Software")
    .single();

console.log("[Malla] Query 1 — specialty:", JSON.stringify(specialty));
if (specError) {
    console.error(
        "[Malla] Query 1 — ERROR specialty:",
        JSON.stringify(specError),
    );
}

// 2. Buscar el plan vigente de esa especialidad
let planYear = "2021";
let planId: number | null = null;

if (specialty) {
    const { data: plan, error: planError } = await supabaseAdmin
        .from("study_plans")
        .select("id, year, is_current")
        .eq("specialty_id", specialty.id)
        .eq("is_current", true)
        .single();

    console.log("[Malla] Query 2 — plan:", JSON.stringify(plan));
    if (planError) {
        console.error(
            "[Malla] Query 2 — ERROR plan:",
            JSON.stringify(planError),
        );
    }

    if (plan) {
        planId = plan.id;
        planYear = String(plan.year);
    }
} else {
    console.warn("[Malla] Specialty no encontrada, saltando queries 2-4.");
}

console.log("[Malla] planId resuelto:", planId, "| planYear:", planYear);

// 3. Obtener los cursos del plan (join con courses para code y name)
let courses: CurriculumCourse[] = [];
if (planId) {
    const { data: planCourses, error: pcError } = await supabaseAdmin
        .from("plan_courses")
        .select(
            "plan_id, course_id, cycle, pos_x, pos_y, courses (id, code, name, credits, evaluation_systems (system_cod))",
        )
        .eq("plan_id", planId);

    console.log(
        "[Malla] Query 3 — planCourses count:",
        planCourses?.length ?? 0,
    );
    console.log(
        "[Malla] Query 3 — planCourses (primeros 3):",
        JSON.stringify(planCourses?.slice(0, 3)),
    );
    if (pcError) {
        console.error(
            "[Malla] Query 3 — ERROR planCourses:",
            JSON.stringify(pcError),
        );
    }

    if (planCourses) {
        courses = planCourses.map((pc: any) => ({
            course_id: pc.course_id,
            code: pc.courses?.code ?? "",
            name: pc.courses?.name ?? "",
            cycle: pc.cycle,
            credits: pc.courses?.credits ?? undefined,
            evaluation_system:
                pc.courses?.evaluation_systems?.system_cod ?? "N/A",
            pos_x: pc.pos_x,
            pos_y: pc.pos_y,
        }));
    }
} else {
    console.warn("[Malla] planId es null, saltando query de cursos.");
}

// 4. Obtener los pre-requisitos del plan
let prerequisites: CoursePrerequisite[] = [];
if (planId) {
    const { data: prereqs, error: prError } = await supabaseAdmin
        .from("course_prerequisites")
        .select("course_id, prerequisite_id")
        .eq("plan_id", planId);

    console.log("[Malla] Query 4 — prereqs count:", prereqs?.length ?? 0);
    console.log(
        "[Malla] Query 4 — prereqs (primeros 3):",
        JSON.stringify(prereqs?.slice(0, 3)),
    );
    if (prError) {
        console.error(
            "[Malla] Query 4 — ERROR prereqs:",
            JSON.stringify(prError),
        );
    }

    if (prereqs) {
        prerequisites = prereqs.map((pr: any) => ({
            course_id: pr.course_id,
            prerequisite_id: pr.prerequisite_id,
        }));
    }
} else {
    console.warn("[Malla] planId es null, saltando query de pre-requisitos.");
}

// 5. Estructurar data para el componente
const curriculumData: CurriculumData = {
    specialtyName: specialty?.name ?? "Ingeniería de Software",
    planYear,
    courses,
    prerequisites,
};

console.log("========== [Malla] Resumen final ==========");
console.log(`  specialtyName: ${curriculumData.specialtyName}`);
console.log(`  planYear: ${curriculumData.planYear}`);
console.log(`  courses: ${curriculumData.courses.length}`);
console.log(`  prerequisites: ${curriculumData.prerequisites.length}`);
console.log("============================================");
---

<Layout
    title={`Malla Curricular - ${curriculumData.specialtyName} | TrikaWeb`}
    description={`Plan de estudios ${curriculumData.planYear} de ${curriculumData.specialtyName} en la Universidad Nacional de Ingeniería. Visualiza cursos, ciclos y pre-requisitos.`}
    keywords="malla curricular, ingeniería de software, plan de estudios, uni, universidad nacional de ingenieria, cursos, pre-requisitos"
>
    <div
        class="flex min-h-screen w-full flex-col items-center gap-4 mt-4 sm:mt-6 px-4 pb-4"
    >
        <section
            class="mx-auto flex w-full max-w-[1400px] flex-col gap-4"
        >
            <div class="flex flex-col md:flex-row justify-between items-end w-full gap-4">
                <div class="flex flex-col items-start gap-2">
                    <!-- Breadcrumb -->
                    <nav class="flex items-center gap-2 text-sm text-global-text-muted">
                        <a href="/" class="hover:text-global-primary transition-colors"
                            >Inicio</a
                        >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="14"
                            height="14"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg
                        >
                        <span class="text-global-text">Especialidades</span>
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="14"
                            height="14"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg
                        >
                        <span class="text-global-primary font-medium"
                            >{curriculumData.specialtyName}</span
                        >
                    </nav>

                    <!-- Title -->
                    <div class="space-y-1">
                        <h1 class="text-3xl sm:text-4xl font-bold text-global-text">
                            {curriculumData.specialtyName}
                        </h1>
                        <p class="text-global-text-muted text-base">
                            Plan de Estudios {curriculumData.planYear} · {
                                curriculumData.courses.length
                            } cursos
                        </p>
                    </div>
                </div>

                <!-- Legend -->
                <div
                    class="flex flex-wrap items-center gap-4 text-sm text-global-text-muted"
                >
                    <div class="flex items-center gap-2">
                        <div
                            class="w-3 h-3 rounded-sm bg-[#1E2430] border border-[#2A3240]"
                        >
                        </div>
                        <span>Curso</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <div class="w-6 h-0.5 bg-[#22c55e]"></div>
                        <span>Pre-requisito</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="14"
                            height="14"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="text-global-text-muted"
                            ><path d="M15 15l-2 5L9 9l11 4-5 2z"></path><path
                                d="M14 14L22 22"></path></svg
                        >
                        <span>Click en un curso</span>
                    </div>
                </div>
            </div>

            <!-- React Flow Container -->
            <div
                class="w-full border border-global-border rounded-2xl overflow-hidden shadow-lg"
            >
                {
                    courses.length === 0 ? (
                        <div class="flex flex-col items-center justify-center py-20 text-global-text-muted">
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="48"
                                height="48"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="mb-4 opacity-50"
                            >
                                <>
                                    <circle cx="12" cy="12" r="10" />
                                    <line x1="12" y1="8" x2="12" y2="12" />
                                    <line x1="12" y1="16" x2="12.01" y2="16" />
                                </>
                            </svg>
                            <p class="text-lg font-medium">
                                No se encontraron cursos
                            </p>
                            <p class="text-sm mt-1">
                                Verifica que el plan de estudios esté
                                configurado en la base de datos.
                            </p>
                        </div>
                    ) : (
                        <Curriculum client:load data={curriculumData} />
                    )
                }
            </div>
        </section>
    </div>
</Layout>
