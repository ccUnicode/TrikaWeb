---
/*
Página de detalle de una plancha (examen).
Muestra:
  - Visor de PDF/video conmutador entre examen y solucionario
  - Widget de votación de dificultad (SheetRating)
  - Botón de favoritos (localStorage)
  - Botón "Pedir solucionario" (registro de interés con API + localStorage)
  - Registro automático de vista al cargar la página (sendBeacon)
*/
export const prerender = false;

import "../../styles/global.css";
import Layout from "../../layouts/Layout.astro";
import SheetRating from "../../components/SheetRating.astro";
import SheetFeedback from "../../components/SheetFeedback.astro";
import { supabaseAdmin } from "../../lib/supabaseAdmin";
import { getUserSession } from "../../lib/auth";
import { getVisibleSheetById } from "../../lib/server/getVisibleSheet";

const { user } = await getUserSession(Astro.cookies);
const isLoggedIn = Boolean(user);

const sheetId = Number(Astro.params.id);

if (!Number.isSafeInteger(sheetId) || sheetId <= 0) {
  return Astro.redirect("/cursos");
}

/*
 * Valida explícitamente que tanto la plancha como su curso
 * asociado estén visibles antes de generar URLs firmadas.
 */
const { data: sheet, error: sheetError } = await getVisibleSheetById(sheetId);

if (sheetError) {
  console.error("Error al validar la visibilidad de la plancha:", sheetError);

  return Astro.redirect("/cursos");
}

if (!sheet) {
  return Astro.redirect("/cursos");
}

const solutionKind = sheet.solution_kind?.trim().toLowerCase();

const hasValidSolution =
  (solutionKind === "pdf" && Boolean(sheet.solution_storage_path?.trim())) ||
  (solutionKind === "video" && Boolean(sheet.solution_video_url?.trim()));

// RF-04: Fetch interest_count separately (graceful fallback if column doesn't exist yet)
const interestCount = Number(sheet.interest_count ?? 0);

const course = Array.isArray(sheet.courses) ? sheet.courses[0] : sheet.courses;

if (!course) {
  return Astro.redirect("/cursos");
}

const courseCode = course.code ?? "Curso";
const courseName = course.name ?? "Curso";

const headerTitle =
  `${courseCode} - ${sheet.exam_type || "Plancha"} ${sheet.cycle || ""}`.trim();

/**
 * Determina si la ruta almacenada corresponde a una imagen.
 */
const isImage = (path: string | null): boolean => {
  if (!path) {
    return false;
  }

  const extension = path.split(".").pop()?.toLowerCase();

  return ["png", "jpg", "jpeg", "webp"].includes(extension ?? "");
};

const examIsImage = isImage(sheet.exam_storage_path);

let examUrl: string | null = null;

if (sheet.exam_storage_path) {
  const { data, error } = await supabaseAdmin.storage
    .from("exams")
    .createSignedUrl(sheet.exam_storage_path, 600);

  if (error) {
    console.error("Error al generar la URL firmada de la plancha:", error);
  } else {
    examUrl = data?.signedUrl ?? null;
  }
}

let solutionUrl: string | null = null;

if (solutionKind === "pdf" && sheet.solution_storage_path) {
  const { data, error } = await supabaseAdmin.storage
    .from("solutions")
    .createSignedUrl(sheet.solution_storage_path, 600);

  if (error) {
    console.error("Error al generar la URL firmada del solucionario:", error);
  } else {
    solutionUrl = data?.signedUrl ?? null;
  }
}
---

<Layout title={headerTitle}>
  <main class="mx-auto max-w-7xl space-y-8 px-4 py-10 sm:px-6 lg:px-12">
    <header class="space-y-4 border-b border-global-border/50 pb-6">
      <div
        class="grid grid-cols-1 items-start gap-4 lg:grid-cols-[1fr_auto] lg:gap-8"
      >
        <div class="space-y-3">
          <h1 class="text-3xl font-bold text-global-text">
            {courseCode} - {courseName}
          </h1>

          <div
            class="flex flex-wrap items-center gap-3 text-sm text-global-text-muted"
          >
            <span
              class="rounded-full bg-global-surface px-3 py-1 font-semibold text-global-text"
            >
              {sheet.exam_type} - {sheet.cycle}
            </span>

            {
              sheet.view_count !== null && (
                <span>
                  Vistas: <strong>{sheet.view_count}</strong>
                </span>
              )
            }

            {
              sheet.rating_count !== null && (
                <span>
                  Votos: <strong>{sheet.rating_count}</strong>
                </span>
              )
            }
            {
              !hasValidSolution && (
                <span>
                  Solicitudes:{" "}
                  <strong id="interest-count-display">{interestCount}</strong>
                </span>
              )
            }
          </div>

          {
            sheet.teacher_hint &&
              sheet.teacher_hint.toLowerCase() !== "todos los profesores" &&
              sheet.teacher_hint.toLowerCase() !== "todos" && (
                <p class="text-sm text-global-text-muted">
                  <span class="text-global-text/70">Profesor:</span>{" "}
                  {sheet.teacher_hint}
                </p>
              )
          }
        </div>

        <!-- Right side: Action buttons -->
        <div class="flex flex-wrap gap-3 items-center">
          {
            /* RF-03: Botón "Pedir solucionario" — solo si NO tiene solucionario */
          }
          {
            !hasValidSolution && (
              <button
                id="interest-btn"
                data-sheet-id={sheet.id}
                type="button"
                class="inline-flex items-center justify-center gap-2 rounded-full border-2 px-4 py-2 text-sm font-semibold transition-all group cursor-pointer"
                style="border-color: rgb(var(--global-primary)); color: rgb(var(--global-primary));"
                title="Solicitar solucionario para esta plancha"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="transition-all"
                >
                  <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2" />
                  <rect x="8" y="2" width="8" height="4" rx="1" ry="1" />
                  <path d="m9 14 2 2 4-4" />
                </svg>
                <span class="interest-detail-label">Pedir solucionario</span>
              </button>
            )
          }

          <!-- Save/Favorite Button -->
          <button
            id="favorite-btn"
            data-sheet-id={sheet.id}
            data-is-logged-in={isLoggedIn ? "true" : "false"}
            type="button"
            class="group inline-flex cursor-pointer items-center justify-center gap-2 rounded-full border-2 border-global-border px-4 py-2 text-sm font-semibold text-global-text transition-all hover:border-red-500"
            title="Guardar plancha"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="favorite-icon transition-all"
            >
              <path
                d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"
              >
              </path>
            </svg>

            <span class="favorite-text">Guardar</span>
          </button>

          {
            examUrl && (
              <a
                id="action-download-btn"
                href={`/api/sheets/${sheet.id}/file?mode=download`}
                data-exam-href={`/api/sheets/${sheet.id}/file?mode=download`}
                data-solution-href={
                  solutionKind === "pdf" && sheet.solution_storage_path
                    ? `/api/sheets/${sheet.id}/file?mode=download&type=solution`
                    : ""
                }
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2 rounded-full bg-global-primary px-4 py-2 text-sm font-semibold text-black transition-colors hover:bg-global-primary-hover"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                  <polyline points="7 10 12 15 17 10" />
                  <line x1="12" y1="15" x2="12" y2="3" />
                </svg>

                <span id="action-download-text">Descargar examen</span>
              </a>
            )
          }

          {
            (solutionUrl ||
              (sheet.solution_kind === "video" &&
                sheet.solution_video_url)) && (
              <button
                id="view-solution-btn"
                data-solution-url={solutionUrl}
                data-video-url={sheet.solution_video_url}
                data-solution-type={sheet.solution_kind}
                data-sheet-id={sheet.id}
                type="button"
                class="inline-flex cursor-pointer items-center justify-center gap-2 rounded-full bg-global-primary px-4 py-2 text-sm font-semibold text-black transition-colors hover:bg-global-primary-hover"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                  <polyline points="14 2 14 8 20 8" />
                  <line x1="16" y1="13" x2="8" y2="13" />
                  <line x1="16" y1="17" x2="8" y2="17" />
                  <polyline points="10 9 9 9 8 9" />
                </svg>

                <span>Ver solucionario</span>
              </button>
            )
          }

          <button
            id="view-exam-btn"
            data-exam-url={examUrl}
            type="button"
            class="hidden cursor-pointer items-center justify-center gap-2 rounded-full bg-global-primary px-4 py-2 text-sm font-semibold text-black transition-colors hover:bg-global-primary-hover"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"
              >
              </path>
              <polyline points="14 2 14 8 20 8"> </polyline>
              <line x1="16" y1="13" x2="8" y2="13"> </line>
              <line x1="16" y1="17" x2="8" y2="17"> </line>
              <polyline points="10 9 9 9 8 9"> </polyline>
            </svg>

            <span>Ver examen</span>
          </button>
        </div>
      </div>
    </header>

    <section class="space-y-6">
      <div class="space-y-6">
        <div
          class="mx-auto max-w-4xl rounded-2xl border border-global-border-subtle bg-global-surface p-2 sm:p-4"
        >
          {
            examUrl ? (
              <div
                id="viewer-container"
                class="relative min-h-[500px] w-full overflow-hidden rounded-xl bg-black/40 shadow-lg sm:aspect-[3/4] sm:min-h-0"
              >
                <iframe
                  id="pdf-viewer-iframe"
                  src={
                    examIsImage
                      ? ""
                      : `${examUrl}#toolbar=0&navpanes=0&view=FitH`
                  }
                  data-exam-url={examUrl}
                  class={`absolute inset-0 h-full w-full rounded-xl border-0 ${
                    examIsImage ? "hidden" : ""
                  }`}
                  loading="lazy"
                  allowfullscreen
                />

                <img
                  id="image-viewer"
                  src={examIsImage ? examUrl : ""}
                  alt="Visor de recurso"
                  class={`absolute inset-0 h-full w-full rounded-xl object-contain ${
                    examIsImage ? "" : "hidden"
                  }`}
                />
              </div>
            ) : (
              <p class="rounded-xl border border-dashed border-global-border/50 bg-black/10 p-6 text-center text-global-text-muted">
                No pudimos generar el visor para esta plancha.
              </p>
            )
          }
        </div>
      </div>

      <div
        id="rating-widget-container"
        class="mx-auto max-w-4xl rounded-2xl border border-global-border-subtle bg-global-surface p-4 sm:p-6 transition-all duration-300"
      >
        <div class="space-y-4">
          <div class="flex items-center justify-between">
            <p class="text-sm text-global-text-muted">
              Evaluación:
              <span class="text-xl font-bold text-global-text">
                {sheet.exam_type}
              </span>
            </p>

            <p class="text-sm text-global-text-muted">
              Ciclo:
              <span class="text-xl font-bold text-global-text">
                {sheet.cycle}
              </span>
            </p>
          </div>

          {
            sheet.teacher_hint &&
              sheet.teacher_hint.toLowerCase() !== "todos los profesores" &&
              sheet.teacher_hint.toLowerCase() !== "todos" && (
                <p class="text-sm text-global-text-muted">
                  Profesor:{" "}
                  <span class="text-global-text">{sheet.teacher_hint}</span>
                </p>
              )
          }

          <div class="rounded-xl bg-global-card p-4">
            <SheetRating
              sheetId={sheet.id}
              avg={sheet.avg_difficulty}
              count={sheet.rating_count}
              isLoggedIn={isLoggedIn}
            />
          </div>
        </div>
      </div>

      <!-- Sección de comentarios (Solo para solucionarios) -->
      {
        (solutionUrl ||
          (sheet.solution_kind === "video" && sheet.solution_video_url)) && (
          <div id="feedback-section" class="hidden transition-all duration-300">
            <SheetFeedback sheetId={sheet.id} />
          </div>
        )
      }
    </section>
  </main>
</Layout>

<script>
  /**
   * Extrae el identificador de un video de YouTube.
   */
  function getYouTubeId(url: string): string | null {
    const expression =
      /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|&v=)([^#&?]*).*/;

    const match = url.match(expression);

    return match && match[2].length === 11 ? match[2] : null;
  }

  /**
   * Inicializa el cambio entre examen, solucionario y video.
   */
  function initViewerSwitcher(): void {
    const iframe = document.getElementById(
      "pdf-viewer-iframe",
    ) as HTMLIFrameElement | null;

    const imageViewer = document.getElementById(
      "image-viewer",
    ) as HTMLImageElement | null;

    const container = document.getElementById("viewer-container");

    const solutionButton = document.getElementById("view-solution-btn");

    const examButton = document.getElementById("view-exam-btn");

    const downloadButton = document.getElementById(
      "action-download-btn",
    ) as HTMLAnchorElement | null;

    const downloadText = document.getElementById("action-download-text");
    const feedbackSection = document.getElementById("feedback-section");
    const ratingWidget = document.getElementById("rating-widget-container");

    if (!iframe || !container || !imageViewer) {
      return;
    }

    const pdfClasses = ["sm:aspect-[3/4]", "min-h-[500px]", "sm:min-h-0"];

    const videoClasses = ["aspect-video"];

    const isImageUrl = (url: string | null): boolean => {
      if (!url) {
        return false;
      }

      const cleanUrl = url.split("?")[0].split("#")[0];

      const extension = cleanUrl.split(".").pop()?.toLowerCase();

      return ["png", "jpg", "jpeg", "webp"].includes(extension ?? "");
    };

    if (solutionButton) {
      solutionButton.addEventListener("click", () => {
        const solutionType = solutionButton.getAttribute("data-solution-type");

        const solutionUrl = solutionButton.getAttribute("data-solution-url");

        const videoUrl = solutionButton.getAttribute("data-video-url");

        if (downloadButton && downloadText) {
          if (solutionType === "pdf") {
            const solutionHref = downloadButton.dataset.solutionHref;

            if (solutionHref) {
              downloadButton.href = solutionHref;
              downloadText.textContent = "Descargar sol.";

              downloadButton.classList.remove("hidden");
              downloadButton.classList.add("inline-flex");
            } else {
              downloadButton.classList.add("hidden");
              downloadButton.classList.remove("inline-flex");
            }
          } else {
            downloadButton.classList.add("hidden");
            downloadButton.classList.remove("inline-flex");
          }
        }

        if (solutionType === "video" && videoUrl) {
          const videoId = getYouTubeId(videoUrl);

          if (!videoId) {
            return;
          }

          imageViewer.classList.add("hidden");

          iframe.classList.remove("hidden");
          iframe.src = `https://www.youtube.com/embed/${videoId}?autoplay=1`;

          iframe.setAttribute(
            "allow",
            "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture",
          );

          container.classList.remove(...pdfClasses);
          container.classList.add(...videoClasses);
        } else if (solutionUrl) {
          const solutionIsImage = isImageUrl(solutionUrl);

          if (solutionIsImage) {
            iframe.classList.add("hidden");
            iframe.src = "";

            imageViewer.src = solutionUrl;
            imageViewer.classList.remove("hidden");
          } else {
            imageViewer.classList.add("hidden");

            iframe.src = `${solutionUrl}#toolbar=0&navpanes=0&view=FitH`;

            iframe.classList.remove("hidden");
            iframe.removeAttribute("allow");
          }

          container.classList.remove(...videoClasses);
          container.classList.add(...pdfClasses);
        } else {
          return;
        }

        solutionButton.classList.add("hidden");
        solutionButton.classList.remove("inline-flex");

        if (examButton) {
          examButton.classList.remove("hidden");
          examButton.classList.add("inline-flex");
        }

        // Show feedback section and hide rating widget
        if (feedbackSection) {
          feedbackSection.classList.remove("hidden");
        }
        if (ratingWidget) {
          ratingWidget.classList.add("hidden");
        }
      });
    }

    if (examButton) {
      examButton.addEventListener("click", () => {
        const examUrl = examButton.getAttribute("data-exam-url");

        if (downloadButton && downloadText) {
          const examHref = downloadButton.dataset.examHref;

          if (examHref) {
            downloadButton.href = examHref;
            downloadText.textContent = "Descargar examen";

            downloadButton.classList.remove("hidden");
            downloadButton.classList.add("inline-flex");
          }
        }

        if (!examUrl) {
          return;
        }

        const examIsImage = isImageUrl(examUrl);

        if (examIsImage) {
          iframe.classList.add("hidden");
          iframe.src = "";

          imageViewer.src = examUrl;
          imageViewer.classList.remove("hidden");
        } else {
          imageViewer.classList.add("hidden");

          iframe.src = `${examUrl}#toolbar=0&navpanes=0&view=FitH`;

          iframe.classList.remove("hidden");
          iframe.removeAttribute("allow");
        }

        container.classList.remove(...videoClasses);
        container.classList.add(...pdfClasses);

        examButton.classList.add("hidden");
        examButton.classList.remove("inline-flex");

        if (solutionButton) {
          solutionButton.classList.remove("hidden");
          solutionButton.classList.add("inline-flex");
        }

        // Hide feedback section and show rating widget
        if (feedbackSection) {
          feedbackSection.classList.add("hidden");
        }
        if (ratingWidget) {
          ratingWidget.classList.remove("hidden");
        }
      });
    }
  }

  document.addEventListener("astro:page-load", initViewerSwitcher);

  document.addEventListener("DOMContentLoaded", initViewerSwitcher);
</script>

<script>
  /**
   * Obtiene la lista de favoritos almacenada localmente.
   */
  function getFavorites(): number[] {
    try {
      const stored = localStorage.getItem("trikaweb:favorites");

      if (!stored) {
        return [];
      }

      const parsed: unknown = JSON.parse(stored);

      if (!Array.isArray(parsed)) {
        return [];
      }

      return parsed.filter(
        (value): value is number => Number.isSafeInteger(value) && value > 0,
      );
    } catch {
      return [];
    }
  }

  /**
   * Agrega o elimina una plancha de favoritos.
   */
  function toggleFavorite(id: number): boolean {
    const favorites = getFavorites();
    const index = favorites.indexOf(id);

    if (index >= 0) {
      favorites.splice(index, 1);
    } else {
      favorites.push(id);
    }

    localStorage.setItem("trikaweb:favorites", JSON.stringify(favorites));

    window.dispatchEvent(
      new CustomEvent("favorites:updated", {
        detail: {
          id,
          active: index === -1,
        },
      }),
    );

    return index === -1;
  }

  /**
   * Inicializa el botón para guardar la plancha.
   */
  function initFavoriteButton(): void {
    const button = document.getElementById("favorite-btn");

    if (!button) {
      return;
    }

    const sheetId = Number(button.getAttribute("data-sheet-id"));

    if (!Number.isSafeInteger(sheetId) || sheetId <= 0) {
      return;
    }

    const icon = button.querySelector(".favorite-icon");

    const text = button.querySelector(".favorite-text");

    const updateUI = (isFavorited: boolean): void => {
      if (isFavorited) {
        icon?.setAttribute("fill", "currentColor");

        icon?.classList.add("text-red-500", "group-hover:text-red-700");

        if (text) {
          text.textContent = "Guardado";
        }

        button.classList.add(
          "border-red-500",
          "text-red-500",
          "hover:border-red-700",
          "hover:text-red-700",
          "hover:bg-red-500/10",
        );

        button.classList.remove(
          "border-global-border",
          "text-global-text",
          "hover:border-red-500",
        );

        return;
      }

      icon?.setAttribute("fill", "none");

      icon?.classList.remove("text-red-500", "group-hover:text-red-700");

      if (text) {
        text.textContent = "Guardar";
      }

      button.classList.remove(
        "border-red-500",
        "text-red-500",
        "hover:border-red-700",
        "hover:text-red-700",
        "hover:bg-red-500/10",
      );

      button.classList.add(
        "border-global-border",
        "text-global-text",
        "hover:border-red-500",
      );
    };

    updateUI(getFavorites().includes(sheetId));

    button.addEventListener("click", () => {
      const isAuthenticated = button.dataset.isLoggedIn === "true";

      if (!isAuthenticated) {
        window.location.href = `/login?redirect=${encodeURIComponent(
          window.location.pathname,
        )}`;

        return;
      }

      const isFavorited = toggleFavorite(sheetId);

      updateUI(isFavorited);

      button.classList.add("scale-110");

      setTimeout(() => {
        button.classList.remove("scale-110");
      }, 200);
    });
  }

  document.addEventListener("astro:page-load", initFavoriteButton);

  document.addEventListener("DOMContentLoaded", initFavoriteButton);
</script>

<script is:inline define:vars={{ sheetId }}>
  **
   * Registra automáticamente una vista al cargar la página
   * usando sendBeacon (o fetch con keepalive como fallback),
   * para que el contador se actualice incluso si el usuario navega inmediatamente.
   */
  const DEVICE_STORAGE_KEY = "tw_device_id";
  const SHEET_ID = sheetId;

  /**
   * Obtiene o crea un identificador anónimo para registrar vistas.
   */
  function ensureDeviceId() {
    if (typeof window === "undefined") {
      return "";
    }

    let current = window.localStorage.getItem(DEVICE_STORAGE_KEY);

    if (!current) {
      current = crypto.randomUUID();

      window.localStorage.setItem(DEVICE_STORAGE_KEY, current);
    }

    return current;
  }

  /**
   * Registra una vista de la plancha.
   */
  const registerView = () => {
    const payload = JSON.stringify({
      device_id: ensureDeviceId(),
      type: "view",
    });

    const url = `/api/sheets/${SHEET_ID}/view`;

    if (navigator.sendBeacon) {
      navigator.sendBeacon(
        url,
        new Blob([payload], {
          type: "application/json",
        }),
      );

      return;
    }

    fetch(url, {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
      },
      body: payload,
      keepalive: true,
    }).catch(() => undefined);
  };

  if (typeof window !== "undefined") {
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", registerView, {
        once: true,
      });
    } else {
      registerView();
    }
  }
</script>

<script>
  /**
   * Resalta las estrellas hasta el puntaje indicado.
   */
  const highlight = (widget: Element, score: number): void => {
    widget.querySelectorAll("[data-score]").forEach((button) => {
      const value = Number((button as HTMLElement).dataset.score);

      const active = value <= score;
      const icon = button.querySelector("svg");

      if (!icon) {
        return;
      }

      if (active) {
        icon.classList.remove("star-inactive");

        icon.classList.add("fill-global-primary", "text-global-primary");
      } else {
        icon.classList.add("star-inactive");

        icon.classList.remove("fill-global-primary", "text-global-primary");
      }
    });
  };

  /**
   * Inicializa los widgets de calificación.
   */
  const initRatings = (): void => {
    document.querySelectorAll("[data-rating-widget]").forEach((widget) => {
      const currentSheetId = widget.getAttribute("data-sheet-id");

      const valueElement = widget.querySelector("[data-rating-value]");

      const countElement = widget.querySelector("[data-rating-count]");

      const statusElement = widget.querySelector("[data-rating-status]");

      const removeButton = widget.querySelector(
        "[data-remove-vote]",
      ) as HTMLButtonElement | null;

      const initialAverage = Number(
        widget.getAttribute("data-current-rating") || 0,
      );

      let userVoted = false;
      let currentUserScore = 0;

      highlight(widget, Math.round(initialAverage));

      const updateRemoveButton = (show: boolean): void => {
        if (!removeButton) {
          return;
        }

        if (show) {
          removeButton.classList.remove("hidden");
        } else {
          removeButton.classList.add("hidden");
        }
      };

      const isLoggedIn = widget.getAttribute("data-is-logged-in") === "true";

      /*
       * Consulta el voto de la sesión autenticada.
       */
      if (isLoggedIn && currentSheetId) {
        fetch(`/api/sheets/${currentSheetId}/rate`)
          .then(async (response) => {
            if (!response.ok) {
              throw new Error("No se pudo consultar el voto");
            }

            return response.json();
          })
          .then((data) => {
            if (!data.hasVoted) {
              return;
            }

            userVoted = true;
            currentUserScore = data.rating?.score ?? 0;

            highlight(widget, currentUserScore);

            updateRemoveButton(true);
          })
          .catch((error) => {
            console.error("Error cargando voto:", error);
          });
      }

      if (removeButton) {
        removeButton.addEventListener("click", async (event) => {
          event.preventDefault();
          event.stopPropagation();

          if (!currentSheetId) {
            return;
          }

          const authenticated =
            widget.getAttribute("data-is-logged-in") === "true";

          if (!authenticated) {
            window.location.href = `/login?redirect=${encodeURIComponent(
              window.location.pathname,
            )}`;

            return;
          }

          widget.classList.add("opacity-80", "pointer-events-none");

          try {
            const response = await fetch(`/api/sheets/${currentSheetId}/rate`, {
              method: "DELETE",
              headers: {
                "Content-Type": "application/json",
              },
            });

            if (!response.ok) {
              const error = await response.json().catch(() => ({}));

              if (statusElement) {
                statusElement.textContent =
                  error?.error ?? "Error al quitar voto";

                statusElement.classList.add("text-red-400");
              }

              return;
            }

            const result = await response.json();

            const average = result?.stats?.avg_difficulty ?? 0;

            const count = result?.stats?.rating_count ?? 0;

            if (valueElement) {
              valueElement.textContent =
                count > 0 ? Number(average).toFixed(2) : "-";
            }

            if (countElement) {
              countElement.textContent = String(count);
            }

            highlight(widget, count > 0 ? Math.round(average) : 0);

            userVoted = false;
            currentUserScore = 0;

            if (statusElement) {
              statusElement.textContent = "Voto eliminado";

              statusElement.classList.remove("text-red-400");
            }

            updateRemoveButton(false);

            setTimeout(() => {
              if (statusElement) {
                statusElement.textContent = "";
              }
            }, 2000);
          } catch (error) {
            console.error(error);

            if (statusElement) {
              statusElement.textContent = "Error inesperado";

              statusElement.classList.add("text-red-400");
            }
          } finally {
            setTimeout(() => {
              widget.classList.remove("opacity-80", "pointer-events-none");
            }, 250);
          }
        });
      }

      widget.querySelectorAll("[data-score]").forEach((button) => {
        button.addEventListener("click", async (event) => {
          event.preventDefault();
          event.stopPropagation();

          const authenticated =
            widget.getAttribute("data-is-logged-in") === "true";

          if (!authenticated) {
            window.location.href = `/login?redirect=${encodeURIComponent(
              window.location.pathname,
            )}`;

            return;
          }

          const score = Number((button as HTMLElement).dataset.score);

          if (
            !Number.isInteger(score) ||
            score < 1 ||
            score > 5 ||
            !currentSheetId
          ) {
            return;
          }

          highlight(widget, score);

          widget.classList.add("opacity-80", "pointer-events-none");

          try {
            const response = await fetch(`/api/sheets/${currentSheetId}/rate`, {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
              },
              body: JSON.stringify({
                score,
              }),
            });

            if (!response.ok) {
              const error = await response.json().catch(() => ({}));

              if (statusElement) {
                statusElement.textContent = error?.error ?? "Error al enviar";

                statusElement.classList.add("text-red-400");
              }

              return;
            }

            const result = await response.json();

            const average = result?.stats?.avg_difficulty ?? score;

            const count = result?.stats?.rating_count ?? 0;

            if (valueElement) {
              valueElement.textContent = Number(average).toFixed(2);
            }

            if (countElement) {
              countElement.textContent = String(count);
            }

            highlight(widget, score);

            userVoted = true;
            currentUserScore = score;

            if (statusElement) {
              statusElement.textContent = "Voto guardado";

              statusElement.classList.remove("text-red-400");
            }

            updateRemoveButton(true);
          } catch (error) {
            console.error(error);

            if (statusElement) {
              statusElement.textContent = "Error inesperado";

              statusElement.classList.add("text-red-400");
            }
          } finally {
            setTimeout(() => {
              widget.classList.remove("opacity-80", "pointer-events-none");
            }, 250);
          }
        });

        button.addEventListener("mouseenter", () => {
          const score = Number((button as HTMLElement).dataset.score);

          highlight(widget, score);
        });
      });

      widget
        .querySelector("[data-stars-container]")
        ?.addEventListener("mouseleave", () => {
          if (userVoted) {
            highlight(widget, currentUserScore);
          } else {
            highlight(widget, Math.round(initialAverage));
          }
        });
    });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initRatings, {
      once: true,
    });
  } else {
    initRatings();
  }
</script>

<script>
  import { ensureDeviceId } from "../../lib/client/device";

  /**
   * Botón "Pedir solucionario".
   *
   * Guarda un estado local para mostrar una respuesta inmediata y
   * lo sincroniza con la fuente de verdad almacenada en el servidor.
   */
  const INTEREST_STORAGE_KEY = "trikaweb:interests";

  interface InterestResponse {
    interested?: unknown;
    interest_count?: unknown;
    error?: unknown;
  }

  function getStoredInterests(): number[] {
    try {
      const stored = localStorage.getItem(INTEREST_STORAGE_KEY);

      if (!stored) {
        return [];
      }

      const parsed: unknown = JSON.parse(stored);

      if (!Array.isArray(parsed)) {
        return [];
      }

      return parsed.filter(
        (value): value is number => Number.isSafeInteger(value) && value > 0,
      );
    } catch {
      return [];
    }
  }

  function isSheetInterested(id: number): boolean {
    return getStoredInterests().includes(id);
  }

  function setLocalInterest(id: number, interested: boolean): void {
    const interests = getStoredInterests();
    const index = interests.indexOf(id);

    if (interested && index === -1) {
      interests.push(id);
    } else if (!interested && index >= 0) {
      interests.splice(index, 1);
    }

    localStorage.setItem(INTEREST_STORAGE_KEY, JSON.stringify(interests));
  }

  function applyDetailInterestState(
    btn: HTMLButtonElement,
    sheetId: number,
  ): void {
    const label = btn.querySelector(".interest-detail-label");
    const svg = btn.querySelector("svg");
    const isInterested = isSheetInterested(sheetId);

    if (isInterested) {
      if (label) {
        label.textContent = "¡Solicitud enviada!";
      }

      svg?.setAttribute("fill", "currentColor");

      btn.style.backgroundColor = "rgb(var(--global-primary))";
      btn.style.color = "black";
      btn.style.borderColor = "rgb(var(--global-primary))";

      return;
    }

    if (label) {
      label.textContent = "Pedir solucionario";
    }

    svg?.setAttribute("fill", "none");

    btn.style.backgroundColor = "transparent";
    btn.style.color = "rgb(var(--global-primary))";
    btn.style.borderColor = "rgb(var(--global-primary))";
  }

  function initInterestButton(): void {
    const element = document.getElementById("interest-btn");

    if (!(element instanceof HTMLButtonElement)) {
      return;
    }

    const btn = element;

    /*
     * Evita añadir los listeners dos veces cuando se disparan
     * DOMContentLoaded y astro:page-load sobre el mismo elemento.
     */
    if (btn.dataset.initialized === "true") {
      return;
    }

    btn.dataset.initialized = "true";

    const sheetId = Number(btn.dataset.sheetId);

    if (!Number.isSafeInteger(sheetId) || sheetId <= 0) {
      return;
    }

    const countDisplay = document.getElementById("interest-count-display");

    applyDetailInterestState(btn, sheetId);

    btn.disabled = true;
    btn.setAttribute("aria-busy", "true");

    let userInteracted = false;

    /*
     * Sincronizar localStorage con la base de datos.
     * El botón permanece deshabilitado hasta terminar para evitar
     * que una respuesta GET tardía sobrescriba un clic del usuario.
     */
    const initialDeviceId = ensureDeviceId();

    fetch(
      `/api/sheets/${sheetId}/interest?device_id=${encodeURIComponent(
        initialDeviceId,
      )}`,
    )
      .then(async (response) => {
        if (!response.ok) {
          return null;
        }

        return (await response.json()) as InterestResponse;
      })
      .then((result) => {
        if (userInteracted) {
          return;
        }

        if (!result || typeof result.interested !== "boolean") {
          return;
        }

        setLocalInterest(sheetId, result.interested);
        applyDetailInterestState(btn, sheetId);
      })
      .catch(() => {
        // La sincronización inicial no debe bloquear la página.
      })
      .finally(() => {
        if (!userInteracted && btn.dataset.pending !== "true") {
          btn.disabled = false;
          btn.removeAttribute("aria-busy");
        }
      });

    btn.addEventListener("mouseenter", () => {
      if (!isSheetInterested(sheetId)) {
        btn.style.backgroundColor = "rgb(var(--global-primary))";
        btn.style.color = "black";
      } else {
        btn.style.backgroundColor = "rgb(var(--global-primary-hover))";
      }
    });

    btn.addEventListener("mouseleave", () => {
      applyDetailInterestState(btn, sheetId);
    });

    btn.addEventListener("click", async () => {
      if (btn.dataset.pending === "true") {
        return;
      }

      userInteracted = true;
      btn.dataset.pending = "true";
      btn.disabled = true;
      btn.setAttribute("aria-busy", "true");

      const wasInterested = isSheetInterested(sheetId);

      // Actualización optimista.
      setLocalInterest(sheetId, !wasInterested);
      applyDetailInterestState(btn, sheetId);

      btn.classList.add("scale-110");

      window.setTimeout(() => {
        btn.classList.remove("scale-110");
      }, 200);

      try {
        const deviceId = ensureDeviceId();

        const response = await fetch(`/api/sheets/${sheetId}/interest`, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            device_id: deviceId,
          }),
        });

        const result = (await response
          .json()
          .catch(() => null)) as InterestResponse | null;

        if (!response.ok) {
          setLocalInterest(sheetId, wasInterested);
          applyDetailInterestState(btn, sheetId);

          console.error(
            "Error al registrar interés:",
            typeof result?.error === "string" ? result.error : response.status,
          );

          return;
        }

        const interestCount = Number(result?.interest_count);

        if (
          typeof result?.interested !== "boolean" ||
          !Number.isSafeInteger(interestCount) ||
          interestCount < 0
        ) {
          throw new Error("Respuesta inválida del endpoint de intereses");
        }

        setLocalInterest(sheetId, result.interested);
        applyDetailInterestState(btn, sheetId);

        if (countDisplay) {
          countDisplay.textContent = String(interestCount);
        }
      } catch (error) {
        setLocalInterest(sheetId, wasInterested);
        applyDetailInterestState(btn, sheetId);

        console.error("Error al registrar interés:", error);
      } finally {
        btn.dataset.pending = "false";
        btn.disabled = false;
        btn.removeAttribute("aria-busy");
      }
    });
  }

  document.addEventListener("astro:page-load", initInterestButton);

  document.addEventListener("DOMContentLoaded", initInterestButton);
</script>
