---
import Layout from '../layouts/Layout.astro';
import { getUserSession } from '../lib/auth';

// Si ya está logueado
const { user } = await getUserSession(Astro.cookies);

if (user) {
  return Astro.redirect('/profile');
}
---

<Layout title="Acceder - TrikaWeb">
  <div class="flex min-h-[calc(100vh-100px)] w-full items-center justify-center px-4 py-12">
    <div class="w-full max-w-md overflow-hidden rounded-2xl border-2 border-global-border bg-global-surface shadow-2xl">
      <div class="p-8">
        <div class="text-center mb-8">
          <img
            src="/img/mascota.png"
            alt="Trika Logo"
            class="mx-auto h-20 w-20 object-contain drop-shadow-md mb-4"
          />

          <h1 class="text-2xl font-bold text-global-text">Iniciar Sesión</h1>

          <p class="text-sm text-global-text-muted mt-2">
            Accede con tu cuenta institucional @uni.pe
          </p>
        </div>

        <div
          id="error-message"
          class="hidden mb-4 rounded-lg bg-red-500/10 p-4 text-sm text-red-500 border border-red-500/20"
        ></div>

        <button
          id="google-login-btn"
          type="button"
          class="w-full rounded-xl bg-global-primary py-3 px-4 text-sm font-bold text-black transition-all hover:bg-global-primary-hover focus:outline-none focus:ring-2 focus:ring-global-primary focus:ring-offset-2 focus:ring-offset-global-surface disabled:opacity-50 shadow-[0_0_15px_rgba(34,197,94,0.2)]"
        >
          Continuar con Google
        </button>

        <p class="mt-4 text-center text-xs text-global-text-muted">
          Solo se permiten correos institucionales de la UNI.
        </p>

      </div>
    </div>
  </div>
</Layout>

<script>
  import {
    auth,
    provider,
    signInWithPopup,
    signOut as firebaseSignOut,
  } from '../../firebase/firebaseConfig.js';

  document.addEventListener('DOMContentLoaded', () => {
    const googleBtn =
      document.getElementById('google-login-btn') as HTMLButtonElement;

    const errorBox =
      document.getElementById('error-message')!;

    function showError(message: string) {
      errorBox.textContent = message;
      errorBox.classList.remove('hidden');
    }

    function clearError() {
      errorBox.classList.add('hidden');
      errorBox.textContent = '';
    }

    googleBtn?.addEventListener(
      'click',
      async () => {

        try {
          clearError();

          const result = await signInWithPopup(auth, provider);
          const idToken = await result.user.getIdToken(true);

          const response = await fetch('/api/auth/login', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({ idToken })
          });

          const data = await response.json();

          if (!response.ok) {
            await firebaseSignOut(auth);
            throw new Error(data.error || 'Error iniciando sesión');
          }

          window.location.href = '/profile';

        } catch (err: any) {

          showError(
            err.message ||
            'Error iniciando sesión'
          );
        }
      }
    );
  });
</script>