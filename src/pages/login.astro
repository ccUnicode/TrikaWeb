---
import Layout from "../layouts/Layout.astro";
import { getUserSession } from "../lib/auth";
import { getSafeRedirect } from "../lib/urlUtils";

const { user } = await getUserSession(Astro.cookies);
const redirectUrl = Astro.url.searchParams.get("redirect") || "/profile";
const safeRedirect = getSafeRedirect(redirectUrl);

if (user) {
  return Astro.redirect(safeRedirect);
}
---

<Layout title="Acceder - TrikaWeb">
  <div
    class="flex min-h-[calc(100vh-100px)] w-full items-center justify-center px-4 py-12"
  >
    <div
      class="w-full max-w-md overflow-hidden rounded-2xl border-2 border-global-border bg-global-surface shadow-2xl"
    >
      <div class="p-8">
        <div class="text-center mb-8">
          <img
            src="/img/mascota.png"
            alt="Trika Logo"
            class="mx-auto h-20 w-20 object-contain drop-shadow-md mb-4"
          />
          <h1 class="text-2xl font-bold text-global-text">Iniciar Sesión</h1>
          <p class="text-sm text-global-text-muted mt-2">
            Accede con tu cuenta institucional @uni.pe
          </p>
        </div>

        <div
          id="error-message"
          role="alert"
          aria-live="polite"
          class="hidden mb-4 rounded-lg bg-red-500/10 p-4 text-sm text-red-500 border border-red-500/20"
        >
        </div>

        <!-- Contenedor modificado para Google Identity -->
        <div
          id="google-btn-wrapper"
          class="relative w-full opacity-50 transition-opacity"
        >
          <!-- Capa bloqueadora que desaparece al aceptar términos -->
          <div
            id="google-btn-overlay"
            class="absolute inset-0 z-10 cursor-not-allowed"
            title="Acepta los términos para continuar"
          >
          </div>
          <!-- Aquí se renderiza el botón oficial de Google -->
          <div
            id="google-button-container"
            class="flex justify-center w-full min-h-[44px]"
          >
          </div>
        </div>

        <p class="mt-4 text-center text-xs text-global-text-muted">
          Solo se permiten correos institucionales de la UNI.
        </p>
        <div class="mt-5 flex items-start gap-2 px-4">
          <input
            type="checkbox"
            id="terms-checkbox"
            class="mt-0.5 rounded border-global-border bg-global-bg text-global-primary focus:ring-global-primary focus:ring-offset-global-surface cursor-pointer"
          />
          <label
            for="terms-checkbox"
            class="text-xs leading-relaxed text-global-text-muted text-left cursor-pointer select-none"
          >
            He leído y acepto los <a
              href="/terminos"
              class="font-medium underline hover:text-global-primary transition-colors"
              >Términos de Servicio</a
            > y la <a
              href="/privacidad"
              class="font-medium underline hover:text-global-primary transition-colors"
              >Política de Privacidad</a
            >.
          </label>
        </div>
      </div>
    </div>
  </div>
</Layout>

<!-- Script oficial de Google Identity -->
<script src="https://accounts.google.com/gsi/client" async defer></script>

<script>
  // Asegúrate de importar la configuración correcta de tu cliente Supabase para frontend
  import { createBrowserClient } from "@supabase/ssr";

  document.addEventListener("DOMContentLoaded", () => {
    const errorBox = document.getElementById("error-message");
    const termsCheckbox = document.getElementById(
      "terms-checkbox",
    ) as HTMLInputElement;
    const googleWrapper = document.getElementById("google-btn-wrapper");
    const googleOverlay = document.getElementById("google-btn-overlay");

    // Manejo de UI: Activar/Desactivar el botón de Google
    function updateButtonState() {
      if (termsCheckbox.checked) {
        googleWrapper?.classList.remove("opacity-50");
        googleOverlay?.classList.add("hidden");
      } else {
        googleWrapper?.classList.add("opacity-50");
        googleOverlay?.classList.remove("hidden");
      }
    }

    if (termsCheckbox) {
      updateButtonState();
      termsCheckbox.addEventListener("change", updateButtonState);
    }

    // Manejo de parámetros URL
    const urlParams = new URLSearchParams(window.location.search);
    const errorParam = urlParams.get("error");
    const redirectParam = urlParams.get("redirect") || "/profile";

    if (errorParam && errorBox) {
      errorBox.textContent = errorParam.replace(/\+/g, " ");
      errorBox.classList.remove("hidden");
    }

    // Renderizado del botón de Google al cargar la ventana
    window.onload = () => {
      const GOOGLE_CLIENT_ID =
        "815175741640-tjkrdqmd25b72bh7uodbei6u9vjh8r7i.apps.googleusercontent.com";

      if (window.google) {
        window.google.accounts.id.initialize({
          client_id: GOOGLE_CLIENT_ID,
          callback: handleCredentialResponse,
          hd: "uni.pe",
        });

        const buttonContainer = document.getElementById(
          "google-button-container",
        );

        if (buttonContainer) {
          window.google.accounts.id.renderButton(buttonContainer, {
            type: "standard",
            theme: "filled_black", // Opciones: "outline" (blanco), "filled_blue", "filled_black"
            size: "large", // Opciones: "small", "medium", "large"
            shape: "pill", // Opciones: "rectangular" (por defecto), "pill" (bordes muy redondeados), "circle", "square"
            text: "signin_with", // Opciones de frase predefinida
            width: 384,
            logo_alignment: "left", // Opciones: "left", "center"
          });
        }
      }

      // Función que procesa el login exitoso en el popup de Google
      async function handleCredentialResponse(response: any) {
        try {
          // Inicializa Supabase usando las variables de entorno de Astro
          const supabase = createBrowserClient(
            import.meta.env.PUBLIC_SUPABASE_URL,
            import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
          );

          // Pasamos el token directamente a Supabase sin salir de la página
          const { error } = await supabase.auth.signInWithIdToken({
            provider: "google",
            token: response.credential,
          });

          if (error) throw error;

          // Asegura que la redirección empiece con '/' (ruta local) y no sea '//' (dominio externo)
          const safeClientRedirect =
            redirectParam.startsWith("/") && !redirectParam.startsWith("//")
              ? redirectParam
              : "/profile";

          window.location.href = safeClientRedirect;
        } catch (error) {
          console.error("Error en autenticación:", error);
          if (errorBox) {
            errorBox.textContent =
              "Error al conectar con el servidor. Inténtalo de nuevo.";
            errorBox.classList.remove("hidden");
          }
        }
      }
    };
  });
</script>
