---
import Layout from '../layouts/Layout.astro';
import { getUserSession } from '../lib/auth';

// Si ya está logueado, lo mandamos al profile
const { user } = await getUserSession(Astro.cookies);
if (user) {
  return Astro.redirect('/profile');
}
---

<Layout title="Acceder - TrikaWeb">
  <div class="flex min-h-[calc(100vh-100px)] w-full items-center justify-center px-4 py-12">
    <div class="w-full max-w-md overflow-hidden rounded-2xl border-2 border-global-border bg-global-surface shadow-2xl">
      <div class="p-8">
        <div class="text-center mb-8">
          <img src="/img/mascota.png" alt="Trika Logo" class="mx-auto h-20 w-20 object-contain drop-shadow-md mb-4" />
          <h1 id="form-title" class="text-2xl font-bold text-global-text">Iniciar Sesión</h1>
          <p id="form-subtitle" class="text-sm text-global-text-muted mt-2">Accede con tu cuenta institucional de la UNI</p>
        </div>

        <form id="auth-form" class="space-y-6">
          <div id="error-message" class="hidden rounded-lg bg-red-500/10 p-4 text-sm text-red-500 border border-red-500/20"></div>

          <div id="fullname-field" class="space-y-2 hidden">
            <label for="fullName" class="block text-sm font-medium text-global-text">Nombre completo</label>
            <input 
              type="text" 
              id="fullName" 
              name="fullName"
              placeholder="Juan Pérez"
              class="w-full rounded-xl border border-global-border bg-global-background px-4 py-3 text-global-text focus:border-global-primary focus:outline-none focus:ring-1 focus:ring-global-primary transition-all"
            />
          </div>

          <div class="space-y-2">
            <label for="email" class="block text-sm font-medium text-global-text">Correo Electrónico</label>
            <input 
              type="email" 
              id="email" 
              name="email"
              placeholder="tu.correo@uni.pe"
              required
              pattern=".*@uni\.pe$"
              title="Debe ser un correo institucional que termine en @uni.pe"
              class="w-full rounded-xl border border-global-border bg-global-background px-4 py-3 text-global-text focus:border-global-primary focus:outline-none focus:ring-1 focus:ring-global-primary transition-all"
            />
          </div>

          <div class="space-y-2">
            <label for="password" class="block text-sm font-medium text-global-text">Contraseña</label>
            <input 
              type="password" 
              id="password" 
              name="password"
              placeholder="••••••••"
              required
              minlength="6"
              class="w-full rounded-xl border border-global-border bg-global-background px-4 py-3 text-global-text focus:border-global-primary focus:outline-none focus:ring-1 focus:ring-global-primary transition-all"
            />
          </div>

          <button 
            type="submit" 
            id="submit-btn"
            class="w-full rounded-xl bg-global-primary py-3 px-4 text-sm font-bold text-black transition-all hover:bg-global-primary-hover focus:outline-none focus:ring-2 focus:ring-global-primary focus:ring-offset-2 focus:ring-offset-global-surface disabled:opacity-50 disabled:cursor-not-allowed shadow-[0_0_15px_rgba(34,197,94,0.2)]"
          >
            Ingresar
          </button>
        </form>

        <div class="mt-6 text-center text-sm">
          <p class="text-global-text-muted">
            <span id="toggle-text">¿No tienes cuenta?</span>
            <button id="toggle-mode" class="ml-1 font-semibold text-global-primary hover:underline focus:outline-none">
              Regístrate aquí
            </button>
          </p>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    let isLogin = true;

    const form = document.getElementById('auth-form') as HTMLFormElement;
    const title = document.getElementById('form-title');
    const subtitle = document.getElementById('form-subtitle');
    const toggleBtn = document.getElementById('toggle-mode');
    const toggleText = document.getElementById('toggle-text');
    const fullnameField = document.getElementById('fullname-field');
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    const errorContainer = document.getElementById('error-message');
    
    // Toggle Mode
    toggleBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      isLogin = !isLogin;
      
      if (title && subtitle && toggleText && toggleBtn && fullnameField && submitBtn && errorContainer) {
        errorContainer.classList.add('hidden');
        errorContainer.textContent = '';
        
        if (isLogin) {
          title.textContent = 'Iniciar Sesión';
          subtitle.textContent = 'Accede con tu cuenta institucional de la UNI';
          toggleText.textContent = '¿No tienes cuenta?';
          toggleBtn.textContent = 'Regístrate aquí';
          fullnameField.classList.add('hidden');
          const fnInput = document.getElementById('fullName') as HTMLInputElement;
          fnInput.required = false;
          submitBtn.textContent = 'Ingresar';
        } else {
          title.textContent = 'Crear Cuenta';
          subtitle.textContent = 'Únete a la comunidad TrikaWeb';
          toggleText.textContent = '¿Ya tienes cuenta?';
          toggleBtn.textContent = 'Inicia sesión';
          fullnameField.classList.remove('hidden');
          const fnInput = document.getElementById('fullName') as HTMLInputElement;
          fnInput.required = true;
          submitBtn.textContent = 'Registrarse';
        }
      }
    });

    // Form Submit
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      if (!submitBtn || !errorContainer) return;
      
      const email = (document.getElementById('email') as HTMLInputElement).value;
      const password = (document.getElementById('password') as HTMLInputElement).value;
      const fullName = (document.getElementById('fullName') as HTMLInputElement).value;

      if (!email.endsWith('@uni.pe')) {
        errorContainer.textContent = 'Solo se permiten correos institucionales terminados en @uni.pe';
        errorContainer.classList.remove('hidden');
        return;
      }

      // Loading state
      const originalText = submitBtn.textContent;
      submitBtn.textContent = 'Cargando...';
      submitBtn.disabled = true;
      errorContainer.classList.add('hidden');

      try {
        const endpoint = isLogin ? '/api/auth/login' : '/api/auth/register';
        const payload = isLogin ? { email, password } : { email, password, full_name: fullName };

        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const data = await res.json();

        if (!res.ok) {
          throw new Error(data.error || 'Ocurrió un error al procesar tu solicitud.');
        }

        // Success -> Redirect to profile
        window.location.href = '/profile';

      } catch (err: any) {
        errorContainer.textContent = err.message;
        errorContainer.classList.remove('hidden');
        submitBtn.textContent = originalText;
        submitBtn.disabled = false;
      }
    });
  });
</script>
