---
import Layout from "../layouts/Layout.astro";
import { getUserSession } from "../lib/auth";
import { validateAdminSession } from "../lib/adminAuth";
import { supabaseAdmin } from "../lib/supabaseAdmin";
import Badge from "../components/ui/Badge.astro";

const { user, profile } = await getUserSession(Astro.cookies);

if (!user) {
  return Astro.redirect("/login");
}

const isAdminSession = await validateAdminSession(Astro.cookies);

const initialProfile =
  profile ?? {
    id: user.id,
    email: user.email || "",
    full_name: user.name || "Estudiante",
    role: isAdminSession ? "admin" : "student",
  };

const isStudent = initialProfile?.role === "student";
const isAdmin = initialProfile?.role === "admin";

// Obtener lista de cursos para el dropdown de donación (RF-23)
const { data: courses } = await supabaseAdmin
  .from("courses")
  .select("id, code, name")
  .order("code", { ascending: true });

const currentYear = new Date().getFullYear();
const years = Array.from({ length: 6 }, (_, i) => currentYear - i);

// Obtener lista de especialidades para el modal de edición
const { data: specialties } = await supabaseAdmin
  .from("specialties")
  .select("id, name")
  .order("name", { ascending: true });

// Obtener aportes del alumno (RF-22)
const { data: contributions } = await supabaseAdmin
  .from("contributions")
  .select("*, courses(code, name)")
  .eq("user_id", user.id)
  .order("created_at", { ascending: false });

// Obtener perfil completo desde Supabase para especialidad y avatar
const { data: userProfileDb } = await supabaseAdmin
  .from("student_details")
  .select("avatar_url, specialty")
  .eq("user_id", user.id)
  .maybeSingle();

const displaySpecialty = userProfileDb?.specialty || "Estudiante UNI";
const avatarUrl = userProfileDb?.avatar_url
  ? userProfileDb.avatar_url.startsWith("http")
    ? userProfileDb.avatar_url
    : `${import.meta.env.PUBLIC_SUPABASE_URL}/storage/v1/object/public/avatars/${userProfileDb.avatar_url}`
  : null;

---

<Layout title="Mi Perfil | TrikaWeb">
  <div class="w-full flex flex-col items-center justify-center px-4 sm:px-6 lg:px-8 py-6 min-h-[calc(100vh-140px)]">
    
    <!-- Tarjeta Principal de Perfil -->
    <div class="w-full max-w-5xl min-h-[60vh] rounded-3xl border border-global-border bg-global-surface shadow-2xl p-6 sm:p-8 flex flex-col profile-card-container">
      
      <!-- Información del Usuario -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-4 shrink-0">
        <div class="flex flex-col sm:flex-row sm:items-center gap-4">
          <!-- Avatar -->
          <div class="relative flex-shrink-0 rounded-full border-4 border-global-surface bg-global-bg p-1 shadow-lg group">
            {avatarUrl ? (
              <img
                src={avatarUrl}
                alt={initialProfile?.full_name}
                class="h-20 w-20 sm:h-24 sm:w-24 rounded-full object-cover shadow-[0_0_15px_rgba(34,197,94,0.15)]"
                onerror="this.style.display='none'; document.getElementById('profile-initial').style.display='flex';"
              />
            ) : null}
            <div
              id="profile-initial"
              class={`flex h-20 w-20 sm:h-24 sm:w-24 items-center justify-center rounded-full bg-global-primary/10 border border-global-primary text-3xl sm:text-4xl font-bold text-global-primary shadow-[0_0_15px_rgba(34,197,94,0.15)] ${avatarUrl ? "hidden" : "flex"}`}
            >
              {
                initialProfile?.full_name
                  ? initialProfile.full_name.charAt(0).toUpperCase()
                  : initialProfile?.email
                    ? initialProfile.email.charAt(0).toUpperCase()
                    : "?"
              }
            </div>
            <!-- Botón flotante para editar foto -->
            <button
              id="quick-edit-avatar-btn"
              class="absolute bottom-0 right-0 bg-global-primary text-black p-1.5 sm:p-2 rounded-full shadow-md hover:scale-110 transition-transform cursor-pointer border-2 border-global-surface"
            >
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-3.5 h-3.5 sm:w-4 sm:h-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L6.832 19.82a4.5 4.5 0 01-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 011.13-1.897L16.863 4.487zm0 0L19.5 7.125" />
              </svg>
            </button>
          </div>

          <!-- Datos del Usuario -->
          <div class="space-y-1">
            <div class="flex flex-wrap items-center gap-3">
              <h1 id="profile-name" class="text-2xl sm:text-3xl font-extrabold text-global-text tracking-tight leading-none">
                {initialProfile?.full_name || "Estudiante"}
              </h1>
              <span
                id="profile-role"
                class={`inline-flex items-center rounded-full px-2.5 py-0.5 text-[10px] font-bold border uppercase tracking-wider ${
                  isAdmin
                    ? "bg-purple-950/30 text-purple-400 border-purple-500 shadow-[0_0_10px_rgba(168,85,247,0.15)]"
                    : "bg-green-950/30 text-green-400 border-green-500 shadow-[0_0_10px_rgba(34,197,94,0.15)]"
                }`}
              >
                {(initialProfile?.role || "student").toUpperCase()}
              </span>
            </div>

            <!-- Correo y Especialidad -->
            <div class="flex flex-wrap items-center gap-4 text-global-text-muted text-sm mt-1">
              <div class="flex items-center gap-1.5">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-global-text-muted">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
                </svg>
                <span id="profile-email">{initialProfile?.email}</span>
              </div>
              <div class="flex items-center gap-1.5">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-global-text-muted">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.438 60.438 0 00-.491 6.347A48.62 48.62 0 0112 20.904a48.62 48.62 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.636 50.636 0 00-2.658-.813A59.906 59.906 0 0112 3.493a59.903 59.903 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0112 13.489a50.702 50.702 0 017.74-3.342M6.75 15a.75.75 0 100-1.5.75.75 0 000 1.5zm0 0v-3.675A55.378 55.378 0 0112 8.443m-7.007 11.55A5.981 5.981 0 006.75 15.75v-1.5" />
                </svg>
                <span id="profile-specialty" class="font-medium text-global-primary">{displaySpecialty}</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Cerrar Sesión (Esquina superior derecha) -->
        <div class="flex items-center sm:self-start shrink-0">
          <form id="logout-form" method="POST" action="/api/auth/logout">
            <button
              type="submit"
              class="inline-flex items-center justify-center gap-2 rounded-xl border border-red-500/20 bg-red-500/10 px-4 py-2 text-xs font-semibold text-red-400 transition-all hover:bg-red-500 hover:text-white cursor-pointer shadow-sm"
              title="Cerrar sesión"
            >
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15M12 9l-3 3m0 0l3 3m-3-3h12.75" />
              </svg>
              <span>Cerrar Sesión</span>
            </button>
          </form>
        </div>
      </div>

      <!-- Segmented Navigation Tabs -->
      <div class="flex p-1 space-x-1 bg-global-bg rounded-xl mb-4 w-fit border border-global-border shadow-inner shrink-0">
        <button
          id="tab-btn-info"
          class="tab-btn relative px-6 py-2 text-sm font-semibold rounded-lg text-white bg-global-surface shadow-md transition-all focus:outline-none cursor-pointer"
          data-tab="info"
        >
          Mi Perfil
        </button>
        <button
          id="tab-btn-aportes"
          class="tab-btn relative px-6 py-2 text-sm font-semibold rounded-lg text-global-text-muted hover:text-global-text bg-transparent hover:bg-global-surface/50 transition-all focus:outline-none cursor-pointer flex items-center gap-2"
          data-tab="aportes"
        >
          <span>Mis Aportes</span>
          {contributions && contributions.length > 0 && (
            <span class="px-2 py-0.5 rounded-full text-xs font-bold bg-global-bg text-global-text border border-global-border shadow-inner">
              {contributions.length}
            </span>
          )}
        </button>
      </div>

      <!-- Tab panels container -->
      <div class="w-full">
        <!-- Panel 1: Mi Perfil -->
        <div id="tab-panel-info" class="tab-panel">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            
            <!-- Card 1: Información de Perfil -->
            <div class="rounded-2xl border border-global-border bg-global-card p-5 flex flex-col justify-between">
              <div>
                <div class="flex items-center gap-2.5 mb-3">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-global-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
                  </svg>
                  <h2 class="text-base sm:text-lg font-bold text-white">Información del Perfil</h2>
                </div>
                <p class="text-sm text-global-text-muted leading-relaxed mb-5">
                  Estás conectado mediante tu cuenta institucional de la Universidad Nacional de Ingeniería. Personaliza tu especialidad y foto pública.
                </p>
              </div>
              <button
                type="button"
                id="edit-profile-btn"
                class="inline-flex w-full sm:w-auto items-center justify-center gap-2 rounded-xl bg-global-primary hover:bg-global-primary-hover px-5 py-2.5 text-sm font-bold text-black shadow-md transition-all active:scale-95 cursor-pointer self-start"
              >
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" />
                </svg>
                Editar Perfil
              </button>
            </div>

            <!-- Card 2: Opciones de Cuenta -->
            <div class="rounded-2xl border border-global-border bg-global-card p-5 flex flex-col justify-start">
              <div class="flex items-center gap-2.5 mb-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-global-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.324.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.431l-1.003.827c-.293.24-.438.613-.431.992a6.759 6.759 0 0 1 0 .255c-.007.378.138.75.43.99l1.005.828c.424.35.534.954.26 1.43l-1.298 2.247a1.125 1.125 0 0 1-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.57 6.57 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.28c-.09.543-.56.941-1.11.941h-2.594c-.55 0-1.02-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 0 1-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.431l1.004-.827c.292-.24.437-.613.43-.992a6.932 6.932 0 0 1 0-.255c.007-.378-.138-.75-.43-.99l-1.004-.828a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.087.22-.128.332-.183.582-.495.644-.869l.214-1.281Z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                </svg>
                <h2 class="text-base sm:text-lg font-bold text-white">Opciones de Cuenta</h2>
              </div>
              <ul class="space-y-2">
                {isAdmin && (
                  <li>
                    <a
                      href="/admin/courses"
                      class="flex items-center gap-3 p-2 rounded-xl text-global-text-muted hover:text-purple-400 hover:bg-global-surface/50 border border-transparent hover:border-purple-500/20 transition-all"
                    >
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-purple-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                        <line x1="3" y1="9" x2="21" y2="9"></line>
                        <line x1="9" y1="21" x2="9" y2="9"></line>
                      </svg>
                      <span class="text-sm font-medium">Panel de Administración</span>
                    </a>
                  </li>
                )}
                <li>
                  <a
                    href="#"
                    class="flex items-center gap-3 p-2 rounded-xl text-global-text-muted hover:text-global-text hover:bg-global-surface/50 border border-transparent hover:border-global-border transition-all"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-4 w-4 text-global-primary shrink-0">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M17.593 3.322c1.1.128 1.907 1.077 1.907 2.185V21L12 17.25 4.5 21V5.507c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0111.186 0z" />
                    </svg>
                    <span class="text-sm font-medium">Mis planchas guardadas</span>
                  </a>
                </li>
              </ul>
            </div>

          </div>
        </div>

        <!-- Panel 2: Mis Aportes -->
        <div id="tab-panel-aportes" class="tab-panel hidden space-y-6">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
            
            <!-- Formulario de Donación (Lado Izquierdo) -->
            <div class="lg:col-span-5 flex flex-col pt-1">
              <h2 class="text-xl font-bold text-white mb-1">Subir nuevo aporte</h2>
              <p class="text-sm text-global-text-muted mb-5">Dona material para que el equipo lo digitalice y diseñe.</p>

              <form id="contribution-form" class="space-y-4">
                <!-- Buscador de Curso (Combobox estilo Admin Upload) -->
                <div class="relative" id="contrib-course-combobox-container">
                  <label for="course_search" class="block text-sm font-medium text-global-text-muted mb-1.5">
                    Curso *
                  </label>
                  <div class="relative">
                    <input type="hidden" name="course_id" id="course_id" required />
                    <input
                      type="text"
                      id="course_search"
                      placeholder="Buscar curso (ej: BMA02, Cálculo)..."
                      autocomplete="off"
                      required
                      class="w-full rounded-xl border border-global-border bg-global-card pl-3.5 pr-10 py-2.5 text-sm text-global-text placeholder:text-gray-500 outline-none focus:border-global-primary focus:ring-1 focus:ring-global-primary transition-colors cursor-pointer"
                    />
                    <div class="absolute inset-y-0 right-3 flex items-center pointer-events-none text-global-text-muted">
                      <svg id="course_chevron" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 transition-transform duration-200">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                      </svg>
                    </div>
                    <!-- Dropdown de Cursos -->
                    <ul
                      id="course_dropdown"
                      class="hidden absolute z-50 left-0 right-0 max-h-56 overflow-y-auto rounded-xl border border-global-border bg-global-card p-1 shadow-2xl mt-1.5 teacher-scroll"
                    >
                      {courses?.map((c) => (
                        <li
                          class="course-option px-3.5 py-2 text-sm text-global-text cursor-pointer hover:bg-[#222938] hover:text-white rounded-lg transition-colors"
                          data-value={c.id}
                          data-text={`[${c.code}] ${c.name}`}
                          data-search={`${c.code} ${c.name}`.toLowerCase()}
                        >
                          <span class="font-semibold text-global-primary">[{c.code}]</span> {c.name}
                        </li>
                      ))}
                      <li id="no-courses-found" class="hidden px-3.5 py-3 text-sm text-global-text-muted text-center">
                        No se encontraron cursos
                      </li>
                    </ul>
                  </div>
                </div>

                <!-- Ciclo (Año + Semestre) y Evaluación en Grid -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <!-- Ciclo (Dividido en Año y Semestre) -->
                  <div>
                    <label class="block text-sm font-medium text-global-text-muted mb-1.5">
                      Ciclo *
                    </label>
                    <input type="hidden" name="cycle" id="cycle" required />
                    
                    <div class="flex gap-2 items-start">
                      <!-- Dropdown Año -->
                      <div class="w-1/2 relative" id="contrib-year-container">
                        <input type="hidden" id="contrib-year-hidden" />
                        <button
                          type="button"
                          id="contrib-year-display"
                          class="w-full flex items-center justify-between rounded-xl border border-global-border bg-global-card px-3 py-2.5 text-sm text-global-text outline-none focus:border-global-primary focus:ring-1 focus:ring-global-primary transition-all cursor-pointer"
                        >
                          <span id="contrib-year-label" class="text-global-text-muted truncate">Año</span>
                          <svg id="contrib-year-chevron" class="h-4 w-4 text-gray-400 transition-transform shrink-0 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                          </svg>
                        </button>
                        <ul
                          id="contrib-year-dropdown"
                          class="teacher-scroll absolute z-50 top-full left-0 mt-1.5 w-full max-h-48 overflow-auto rounded-xl border border-global-border bg-global-card p-1 shadow-2xl hidden"
                        >
                          {years.map((y) => (
                            <li
                              data-value={y}
                              class="year-opt px-3 py-2 text-sm text-global-text hover:bg-[#222938] hover:text-white rounded-lg cursor-pointer transition-colors"
                            >
                              {y}
                            </li>
                          ))}
                          <li
                            data-value="otro"
                            class="year-opt px-3 py-2 text-sm font-medium text-global-primary hover:bg-[#222938] rounded-lg cursor-pointer transition-colors border-t border-global-border mt-1"
                          >
                            Otro
                          </li>
                        </ul>
                      </div>

                      <!-- Dropdown Semestre -->
                      <div class="w-1/2 relative" id="contrib-term-container">
                        <input type="hidden" id="contrib-term-hidden" />
                        <button
                          type="button"
                          id="contrib-term-display"
                          class="w-full flex items-center justify-between rounded-xl border border-global-border bg-global-card px-3 py-2.5 text-sm text-global-text outline-none focus:border-global-primary focus:ring-1 focus:ring-global-primary transition-all cursor-pointer"
                        >
                          <span id="contrib-term-label" class="text-global-text-muted truncate">Sem.</span>
                          <svg id="contrib-term-chevron" class="h-4 w-4 text-gray-400 transition-transform shrink-0 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                          </svg>
                        </button>
                        <ul
                          id="contrib-term-dropdown"
                          class="teacher-scroll absolute z-50 top-full left-0 mt-1.5 w-full max-h-48 overflow-auto rounded-xl border border-global-border bg-global-card p-1 shadow-2xl hidden"
                        >
                          <li data-value="I" class="term-opt px-3 py-2 text-sm text-global-text hover:bg-[#222938] hover:text-white rounded-lg cursor-pointer transition-colors">
                            I
                          </li>
                          <li data-value="II" class="term-opt px-3 py-2 text-sm text-global-text hover:bg-[#222938] hover:text-white rounded-lg cursor-pointer transition-colors">
                            II
                          </li>
                          <li data-value="III" class="term-opt px-3 py-2 text-sm text-global-text hover:bg-[#222938] hover:text-white rounded-lg cursor-pointer transition-colors">
                            III
                          </li>
                        </ul>
                      </div>
                    </div>

                    <!-- Input personalizado cuando se elige "Otro" año -->
                    <input
                      type="number"
                      id="contrib-year-custom"
                      placeholder="Ingresar año (ej: 2020)"
                      class="hidden mt-2 w-full rounded-xl border border-global-border bg-global-card px-3 py-2 text-sm text-global-text outline-none focus:border-global-primary focus:ring-1 focus:ring-global-primary transition-colors placeholder-gray-500"
                    />
                  </div>

                  <!-- Evaluación (Custom Dropdown dinámico según el curso) -->
                  <div class="relative" id="contrib-eval-container">
                    <label class="block text-sm font-medium text-global-text-muted mb-1.5">
                      Evaluación *
                    </label>
                    <input type="hidden" name="exam_type" id="exam_type_input" value="" required />
                    
                    <button
                      type="button"
                      id="contrib-eval-display"
                      disabled
                      class="w-full flex items-center justify-between rounded-xl border border-global-border bg-global-card px-3.5 py-2.5 text-sm text-global-text outline-none focus:border-global-primary focus:ring-1 focus:ring-global-primary transition-all cursor-not-allowed opacity-60"
                    >
                      <span id="contrib-eval-label" class="text-global-text-muted truncate">Selecciona un curso primero</span>
                      <svg id="contrib-eval-chevron" class="h-4 w-4 text-gray-400 transition-transform shrink-0 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                      </svg>
                    </button>
                    
                    <ul
                      id="contrib-eval-dropdown"
                      class="teacher-scroll absolute z-50 top-full left-0 mt-1.5 w-full max-h-56 overflow-auto rounded-xl border border-global-border bg-global-card p-1 shadow-2xl hidden"
                    >
                      <li class="px-3.5 py-3 text-sm text-global-text-muted text-center">
                        Selecciona un curso primero
                      </li>
                    </ul>
                  </div>
                </div>

                <!-- Tipo de Documento -->
                <div>
                  <label class="block text-sm font-medium text-global-text-muted mb-2">
                    Tipo de Aporte *
                  </label>
                  <div class="flex gap-6">
                    <label class="flex items-center gap-2 text-sm text-global-text cursor-pointer">
                      <input type="radio" name="contribution_type" value="sheet" checked class="w-4 h-4 accent-global-primary" />
                      <span>Plancha</span>
                    </label>
                    <label class="flex items-center gap-2 text-sm text-global-text cursor-pointer">
                      <input type="radio" name="contribution_type" value="solution" class="w-4 h-4 accent-global-primary" />
                      <span>Solucionario</span>
                    </label>
                  </div>
                </div>

                <!-- File Selector -->
                <div>
                  <label class="block text-sm font-medium text-global-text-muted mb-1.5">
                    Archivo (PDF/Img, máx 10MB) *
                  </label>
                  <label
                    for="file"
                    class="flex justify-between items-center gap-3 w-full rounded-xl border border-global-border bg-global-card px-3.5 py-2.5 cursor-pointer hover:border-global-primary transition-colors"
                  >
                    <span class="inline-flex items-center rounded-lg bg-global-primary px-4 py-1.5 text-sm font-bold text-black whitespace-nowrap shadow-sm">
                      Seleccionar
                    </span>
                    <span id="file-name-display" class="text-sm text-global-text-muted truncate text-right flex-1 pr-1">
                      Sin archivo
                    </span>
                  </label>
                  <input type="file" name="file" id="file" accept="application/pdf,image/png,image/jpeg,image/webp" required class="hidden" />
                </div>

                <div id="form-status" class="hidden p-3 text-sm rounded-xl border text-center font-medium"></div>

                <button
                  type="submit"
                  id="submit-contrib-btn"
                  class="w-full rounded-xl bg-global-primary hover:bg-global-primary-hover px-4 py-3 text-sm font-bold text-black shadow-md transition-all cursor-pointer mt-3"
                >
                  Enviar Donación
                </button>
              </form>
            </div>

            <!-- Historial de Aportes (Lado Derecho) -->
            <div class="lg:col-span-7 flex flex-col">
              <div class="flex items-center justify-between mb-4 flex-wrap gap-2 px-1">
                <h2 class="text-lg font-bold text-white flex items-center gap-2">
                  Mi Historial de Aportes
                  {contributions && contributions.length > 0 && (
                    <span class="text-sm font-semibold px-2.5 py-0.5 rounded-full bg-global-card border border-global-border text-gray-400">
                      {contributions.length}
                    </span>
                  )}
                </h2>
                {contributions && contributions.length > 0 && (
                  <button
                    type="button"
                    id="clear-history-btn"
                    class="px-3 py-1.5 bg-red-600/10 hover:bg-red-600/20 text-red-500 text-xs font-semibold rounded-lg cursor-pointer transition-colors border border-red-600/20 flex items-center gap-1.5"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
                    </svg>
                    Vaciar Historial
                  </button>
                )}
              </div>

              <!-- Lista de Aportes -->
              <div class="flex-1 space-y-4">
                {contributions && contributions.length > 0 ? (
                  contributions.map((contrib) => {
                    const isPending = contrib.status === "pending";
                    const isApproved = contrib.status === "approved";
                    const isRejected = contrib.status === "rejected";
                    const isSheet = contrib.contribution_type === "sheet";

                    return (
                      <div class="rounded-xl border border-global-border bg-global-card p-4 sm:p-5 flex flex-col md:flex-row md:items-start justify-between gap-4 transition-all shadow-sm relative group overflow-hidden">
                        <div class="min-w-0 flex-1 flex flex-col gap-2 z-10">
                          <!-- Badges Superiores -->
                          <div class="flex flex-wrap items-center gap-2">
                            <span class="font-mono text-xs font-semibold text-gray-300 bg-[#1E2633] border border-[#2B374A] px-2 py-0.5 rounded-md">
                              {contrib.courses?.code || "CURSO"}
                            </span>
                            <span class="text-xs font-semibold text-gray-300 bg-[#1E2633] border border-[#2B374A] px-2.5 py-0.5 rounded-md">
                              {contrib.exam_type}{contrib.cycle ? ` · ${contrib.cycle}` : ""}
                            </span>
                            <Badge intent={isSheet ? "primary" : "info"} class="px-2 py-0.5 text-[10px] tracking-wide uppercase">
                              {isSheet ? "Plancha" : "Solucionario"}
                            </Badge>
                          </div>

                          <!-- Nombre de Curso -->
                          <h3 class="text-base font-bold text-white transition-colors leading-snug mt-1">
                            {contrib.courses?.name || "Sin nombre de curso"}
                          </h3>

                          <!-- Nota del Administrador -->
                          {contrib.admin_notes && (
                            <div class="text-xs text-gray-300 mt-2 bg-[#131923] px-3.5 py-2.5 rounded-xl flex items-start gap-2">
                              <span class="text-gray-400 font-semibold shrink-0">Nota Admin:</span>
                              <span class="text-gray-300 italic">{contrib.admin_notes}</span>
                            </div>
                          )}
                        </div>

                        <!-- Estado del Aporte -->
                        <div class="flex items-center justify-end gap-3 shrink-0 pt-2 md:pt-0 z-10 border-t md:border-t-0 border-global-border/40 md:border-transparent mt-2 md:mt-0">
                          <Badge intent={isApproved ? "success" : isPending ? "warning" : "danger"} showDot={true}>
                            {isApproved ? "Aprobado" : isPending ? "Pendiente" : "Rechazado"}
                          </Badge>
                        </div>
                      </div>
                    );
                  })
                ) : (
                  <div class="py-12 text-center text-gray-500">
                    <svg xmlns="http://www.w3.org/2000/svg" class="mx-auto h-10 w-10 text-gray-600 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 16.5V9.75m0 0l3 3m-3-3l-3 3M6.75 19.5a4.5 4.5 0 01-1.41-8.775 5.25 5.25 0 0110.233-2.33 3 3 0 013.758 3.848A3.752 3.752 0 0118 19.5H6.75z" />
                    </svg>
                    <p class="text-sm font-semibold">Aún no has realizado aportes</p>
                    <p class="text-xs mt-1">¡Apoya a la comunidad universitaria subiendo material!</p>
                  </div>
                )}
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- Modal de Confirmación para Vaciar Historial -->
  <div id="clear-history-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/50 backdrop-blur-sm hidden">
    <div class="w-full max-w-md rounded-xl bg-global-surface border border-global-border p-6 shadow-xl text-left transform scale-95 transition-transform duration-300">
      <h3 class="text-lg font-bold text-global-text mb-2">¿Vaciar historial de aportes?</h3>
      <p class="text-sm text-global-text-muted mb-6 leading-relaxed">
        Esta acción eliminará todos tus registros de aportes de la lista y los borradores asociados.
      </p>
      <div class="flex justify-end gap-3">
        <button type="button" id="close-clear-modal-btn" class="px-4 py-2 rounded-lg text-sm font-medium text-global-text bg-global-card border border-global-border hover:bg-global-bg transition cursor-pointer select-none">
          Cancelar
        </button>
        <button type="button" id="confirm-clear-history-btn" class="px-4 py-2 rounded-lg text-sm font-medium text-red-400 bg-red-600/20 border border-red-600/30 hover:bg-red-600/30 transition cursor-pointer select-none">
          Confirmar y Vaciar
        </button>
      </div>
    </div>
  </div>

  <!-- Modal de Edición de Perfil -->
  <div id="edit-profile-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm hidden">
    <div class="w-full max-w-lg rounded-3xl border border-global-border bg-global-surface p-6 sm:p-7 shadow-2xl relative">
      <!-- Encabezado del Modal -->
      <div class="flex items-start justify-between pb-4 border-b border-global-border mb-5">
        <div class="flex items-center gap-3.5">
          <div class="w-12 h-12 rounded-2xl bg-global-primary/10 flex items-center justify-center text-global-primary shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" />
            </svg>
          </div>
          <div>
            <h3 class="text-lg sm:text-xl font-bold text-white tracking-tight">Editar Mi Perfil</h3>
            <p class="text-xs text-global-text-muted mt-0.5">Actualiza tu foto pública y especialidad</p>
          </div>
        </div>
        <button
          type="button"
          id="close-edit-profile-modal-x"
          class="p-2 rounded-xl text-global-text-muted hover:text-white bg-global-card/60 hover:bg-global-card border border-global-border transition-all cursor-pointer"
          aria-label="Cerrar modal"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      
      <form id="edit-profile-form" class="space-y-4">
        <!-- Foto de Perfil -->
        <div class="rounded-2xl border border-global-border bg-global-card p-4">
          <label class="block text-xs font-semibold text-global-text-muted uppercase tracking-wider mb-2.5">
            Foto de Perfil
          </label>
          <div class="flex items-center gap-4">
            <div class="relative w-16 h-16 rounded-full border-2 border-global-border bg-global-surface overflow-hidden flex items-center justify-center shrink-0 shadow-inner">
              <img id="avatar-preview" src={avatarUrl || ""} class={avatarUrl ? "h-full w-full object-cover" : "hidden"} />
              <div
                id="avatar-preview-fallback"
                class={`flex h-full w-full items-center justify-center bg-global-primary/10 text-global-primary font-bold text-2xl ${avatarUrl ? "hidden" : "flex"}`}
              >
                {initialProfile?.full_name ? initialProfile.full_name.charAt(0).toUpperCase() : "U"}
              </div>
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2">
                <button
                  type="button"
                  id="edit-avatar-btn"
                  class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-global-primary text-black font-bold text-xs hover:bg-global-primary-hover transition-all shadow-sm cursor-pointer active:scale-95"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
                  </svg>
                  <span>Subir Imagen</span>
                </button>
              </div>
              <input type="file" id="avatar-input" name="avatar" accept="image/jpeg,image/png,image/webp" class="hidden" />
              <p id="avatar-filename" class="text-xs text-global-text-muted mt-1.5 truncate">
                Solo JPG, PNG o WebP (máx. 5MB)
              </p>
            </div>
          </div>
        </div>

        <!-- Especialidad (Custom Dropdown estilo Admin/Mallas) -->
        <div>
          <label class="block text-sm font-medium text-global-text-muted mb-1.5">
            Especialidad (Carrera)
          </label>
          <div class="relative" id="specialty-custom-select-container">
            <input type="hidden" name="specialty" id="specialty-input" value={userProfileDb?.specialty || ""} />
            
            <!-- Trigger Button -->
            <button
              type="button"
              id="specialty-select-trigger"
              class="w-full flex items-center justify-between rounded-xl border border-global-border bg-global-card px-3.5 py-2.5 text-sm text-global-text outline-none focus:border-global-primary focus:ring-1 focus:ring-global-primary transition-all cursor-pointer"
            >
              <span id="specialty-select-label" class={userProfileDb?.specialty ? "text-global-text font-medium truncate" : "text-global-text-muted"}>
                {userProfileDb?.specialty || "Selecciona tu carrera..."}
              </span>
              <svg
                id="specialty-select-chevron"
                class="h-4 w-4 text-gray-400 transition-transform duration-200 shrink-0 ml-2"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>

            <!-- Dropdown List -->
            <div
              id="specialty-select-dropdown"
              class="absolute z-50 left-0 right-0 mt-1.5 max-h-56 overflow-y-auto rounded-xl border border-global-border bg-global-card p-1 shadow-2xl hidden teacher-scroll"
            >
              <div
                class="specialty-option px-3.5 py-2 text-sm text-global-text-muted hover:bg-[#222938] hover:text-white rounded-lg cursor-pointer transition-colors"
                data-value=""
              >
                Selecciona tu carrera...
              </div>
              {specialties?.map((spec) => {
                const isSelected = userProfileDb?.specialty === spec.name;
                return (
                  <div
                    class={`specialty-option px-3.5 py-2 text-sm rounded-lg cursor-pointer transition-colors ${
                      isSelected
                        ? "bg-global-primary/10 text-global-primary font-semibold"
                        : "text-global-text hover:bg-[#222938] hover:text-white"
                    }`}
                    data-value={spec.name}
                  >
                    {spec.name}
                  </div>
                );
              })}
            </div>
          </div>
        </div>

        <div id="edit-profile-status" class="hidden p-3 text-sm rounded-xl border text-center font-medium"></div>

        <div class="flex justify-end items-center gap-3 pt-3 border-t border-global-border mt-5">
          <button
            type="button"
            id="close-edit-profile-modal"
            class="px-4 py-2 text-sm font-semibold text-global-text-muted hover:text-white rounded-xl border border-global-border bg-global-card hover:bg-global-border/60 transition-all cursor-pointer"
          >
            Cancelar
          </button>
          <button
            type="submit"
            id="submit-edit-profile"
            class="px-5 py-2 text-sm font-bold text-black bg-global-primary hover:bg-global-primary-hover rounded-xl shadow-sm transition-all cursor-pointer active:scale-95"
          >
            Guardar Cambios
          </button>
        </div>
      </form>
    </div>
  </div>
</Layout>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    // 1. Manejo de Pestañas
    const tabButtons = document.querySelectorAll(".tab-btn");
    const tabPanels = document.querySelectorAll(".tab-panel");

    tabButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const tabId = btn.getAttribute("data-tab");
        if (tabId && window.location.hash !== `#${tabId}`) {
          history.replaceState(null, "", `#${tabId}`);
        }

        // Activar botón de pestaña actual
        tabButtons.forEach((b) => {
          b.className = "tab-btn relative px-5 py-2 text-xs sm:text-sm font-semibold rounded-lg text-global-text-muted hover:text-global-text bg-transparent hover:bg-global-surface/50 transition-all focus:outline-none cursor-pointer flex items-center gap-2";
        });
        btn.className = "tab-btn relative px-5 py-2 text-xs sm:text-sm font-semibold rounded-lg text-white bg-global-surface shadow-md transition-all focus:outline-none cursor-pointer flex items-center gap-2";

        // Activar panel correspondiente
        tabPanels.forEach((panel) => {
          if (panel.id === `tab-panel-${tabId}`) {
            panel.classList.remove("hidden");
          } else {
            panel.classList.add("hidden");
          }
        });
      });
    });

    // Activar pestaña según el hash del URL al cargar (ej: #aportes)
    const initialHash = window.location.hash.replace("#", "");
    if (initialHash) {
      const activeTabBtn = document.querySelector(`.tab-btn[data-tab="${initialHash}"]`);
      if (activeTabBtn) {
        (activeTabBtn as HTMLButtonElement).click();
      }
    }

    // 1.5. Buscador de Cursos Desplegable (Estilo Admin Upload)
    const courseSearch = document.getElementById("course_search") as HTMLInputElement;
    const courseIdInput = document.getElementById("course_id") as HTMLInputElement;
    const courseDropdown = document.getElementById("course_dropdown")!;
    const courseOptions = document.querySelectorAll(".course-option");
    const noCoursesFound = document.getElementById("no-courses-found")!;
    const courseChevron = document.getElementById("course_chevron");

    if (courseSearch && courseDropdown) {
      const openCourseDropdown = () => {
        courseDropdown.classList.remove("hidden");
        courseChevron?.classList.add("rotate-180");
        courseSearch.classList.add("border-global-primary", "ring-1", "ring-global-primary");
      };

      const closeCourseDropdown = () => {
        courseDropdown.classList.add("hidden");
        courseChevron?.classList.remove("rotate-180");
        courseSearch.classList.remove("border-global-primary", "ring-1", "ring-global-primary");
      };

      courseSearch.addEventListener("focus", openCourseDropdown);

      const normalize = (value = "") =>
        value.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").trim();

      courseSearch.addEventListener("input", function () {
        openCourseDropdown();
        const query = normalize(this.value);
        let matches = 0;

        courseOptions.forEach((opt) => {
          const searchData = normalize(opt.getAttribute("data-search") || "");
          if (searchData.includes(query)) {
            opt.classList.remove("hidden");
            matches++;
          } else {
            opt.classList.add("hidden");
          }
        });

        if (matches === 0) {
          noCoursesFound.classList.remove("hidden");
        } else {
          noCoursesFound.classList.add("hidden");
        }

        if (!this.value.trim()) {
          courseIdInput.value = "";
        }
      });

      courseOptions.forEach((opt) => {
        opt.addEventListener("click", () => {
          const value = opt.getAttribute("data-value") || "";
          const text = opt.getAttribute("data-text") || "";
          courseSearch.value = text;
          courseIdInput.value = value;
          closeCourseDropdown();
          loadCourseEvaluations(value);
        });
      });

      document.addEventListener("click", (e) => {
        const target = e.target as HTMLElement;
        if (!target.closest("#contrib-course-combobox-container")) {
          closeCourseDropdown();
          if (!courseIdInput.value) {
            courseSearch.value = "";
            loadCourseEvaluations("");
          }
        }
      });
    }

    // 1.6. Desplegables de Ciclo (Año + Semestre) estilo Admin Upload
    const yearContainer = document.getElementById("contrib-year-container");
    const yearDisplay = document.getElementById("contrib-year-display");
    const yearDropdown = document.getElementById("contrib-year-dropdown");
    const yearHidden = document.getElementById("contrib-year-hidden") as HTMLInputElement;
    const yearLabel = document.getElementById("contrib-year-label");
    const yearChevron = document.getElementById("contrib-year-chevron");
    const yearCustom = document.getElementById("contrib-year-custom") as HTMLInputElement;

    const termContainer = document.getElementById("contrib-term-container");
    const termDisplay = document.getElementById("contrib-term-display");
    const termDropdown = document.getElementById("contrib-term-dropdown");
    const termHidden = document.getElementById("contrib-term-hidden") as HTMLInputElement;
    const termLabel = document.getElementById("contrib-term-label");
    const termChevron = document.getElementById("contrib-term-chevron");

    const cycleInput = document.getElementById("cycle") as HTMLInputElement;

    function updateCycle() {
      let y = yearHidden?.value || "";
      if (y === "otro") {
        y = yearCustom?.value || "";
      }
      const t = termHidden?.value || "";
      if (y && t && cycleInput) {
        cycleInput.value = `${y}-${t}`;
      } else if (cycleInput) {
        cycleInput.value = "";
      }
    }

    function closeYearDropdown() {
      yearDropdown?.classList.add("hidden");
      yearChevron?.classList.remove("rotate-180");
      yearDisplay?.classList.remove("border-global-primary", "ring-1", "ring-global-primary");
    }

    function closeTermDropdown() {
      termDropdown?.classList.add("hidden");
      termChevron?.classList.remove("rotate-180");
      termDisplay?.classList.remove("border-global-primary", "ring-1", "ring-global-primary");
    }

    yearDisplay?.addEventListener("click", (e) => {
      e.stopPropagation();
      closeTermDropdown();
      const isHidden = yearDropdown?.classList.contains("hidden");
      if (isHidden) {
        yearDropdown?.classList.remove("hidden");
        yearChevron?.classList.add("rotate-180");
        yearDisplay?.classList.add("border-global-primary", "ring-1", "ring-global-primary");
      } else {
        closeYearDropdown();
      }
    });

    yearDropdown?.querySelectorAll(".year-opt").forEach((item) => {
      item.addEventListener("click", () => {
        const val = item.getAttribute("data-value") || "";
        const text = item.textContent?.trim() || "";
        yearHidden.value = val;

        if (val === "otro") {
          if (yearLabel) yearLabel.textContent = "Otro";
          yearCustom?.classList.remove("hidden");
          yearCustom?.focus();
        } else {
          if (yearLabel) yearLabel.textContent = text;
          if (yearLabel) yearLabel.className = "text-global-text font-medium truncate";
          yearCustom?.classList.add("hidden");
          yearCustom.value = "";
        }

        closeYearDropdown();
        updateCycle();
      });
    });

    yearCustom?.addEventListener("input", updateCycle);

    termDisplay?.addEventListener("click", (e) => {
      e.stopPropagation();
      closeYearDropdown();
      const isHidden = termDropdown?.classList.contains("hidden");
      if (isHidden) {
        termDropdown?.classList.remove("hidden");
        termChevron?.classList.add("rotate-180");
        termDisplay?.classList.add("border-global-primary", "ring-1", "ring-global-primary");
      } else {
        closeTermDropdown();
      }
    });

    termDropdown?.querySelectorAll(".term-opt").forEach((item) => {
      item.addEventListener("click", () => {
        const val = item.getAttribute("data-value") || "";
        const text = item.textContent?.trim() || "";
        termHidden.value = val;
        if (termLabel) {
          termLabel.textContent = text;
          termLabel.className = "text-global-text font-medium truncate";
        }
        closeTermDropdown();
        updateCycle();
      });
    });

    // 1.7. Desplegable Dinámico de Evaluación (según el curso seleccionado)
    const evalContainer = document.getElementById("contrib-eval-container");
    const evalDisplay = document.getElementById("contrib-eval-display");
    const evalDropdown = document.getElementById("contrib-eval-dropdown");
    const evalInput = document.getElementById("exam_type_input") as HTMLInputElement;
    const evalLabel = document.getElementById("contrib-eval-label");
    const evalChevron = document.getElementById("contrib-eval-chevron");

    let evalAbortController: AbortController | null = null;

    function closeEvalDropdown() {
      evalDropdown?.classList.add("hidden");
      evalChevron?.classList.remove("rotate-180");
      evalDisplay?.classList.remove("border-global-primary", "ring-1", "ring-global-primary");
    }

    evalDisplay?.addEventListener("click", (e) => {
      e.stopPropagation();
      if (evalDisplay.hasAttribute("disabled")) return;
      closeYearDropdown();
      closeTermDropdown();
      const isHidden = evalDropdown?.classList.contains("hidden");
      if (isHidden) {
        evalDropdown?.classList.remove("hidden");
        evalChevron?.classList.add("rotate-180");
        evalDisplay?.classList.add("border-global-primary", "ring-1", "ring-global-primary");
      } else {
        closeEvalDropdown();
      }
    });

    async function loadCourseEvaluations(courseId: string) {
      if (!courseId) {
        if (evalInput) evalInput.value = "";
        if (evalLabel) {
          evalLabel.textContent = "Selecciona un curso primero";
          evalLabel.className = "text-global-text-muted truncate";
        }
        evalDisplay?.setAttribute("disabled", "true");
        evalDisplay?.classList.add("cursor-not-allowed", "opacity-60");
        if (evalDropdown) {
          evalDropdown.innerHTML = `<li class="px-3.5 py-3 text-sm text-global-text-muted text-center">Selecciona un curso primero</li>`;
        }
        return;
      }

      evalAbortController?.abort();
      evalAbortController = new AbortController();

      if (evalLabel) {
        evalLabel.textContent = "Cargando evaluaciones...";
        evalLabel.className = "text-global-text-muted truncate";
      }
      evalDisplay?.setAttribute("disabled", "true");
      evalDisplay?.classList.add("cursor-not-allowed", "opacity-60");

      try {
        const res = await fetch(`/api/contributions/course-evaluations?course_id=${courseId}`, {
          signal: evalAbortController.signal,
        });
        const data = await res.json();
        const evaluations: any[] = data.evaluations || [];

        if (evalDropdown) {
          evalDropdown.innerHTML = "";
        }

        if (evaluations.length === 0) {
          if (evalLabel) {
            evalLabel.textContent = "Sin evaluaciones registradas";
            evalLabel.className = "text-global-text-muted truncate";
          }
          if (evalInput) evalInput.value = "";
          if (evalDropdown) {
            evalDropdown.innerHTML = `<li class="px-3.5 py-3 text-sm text-global-text-muted text-center">No hay evaluaciones para este curso</li>`;
          }
          return;
        }

        // Seleccionar por defecto la primera evaluación
        const first = evaluations[0];
        const firstVal = first.evaluation_abr || first.evaluation_name;
        if (evalInput) evalInput.value = firstVal;
        if (evalLabel) {
          evalLabel.textContent = `${first.evaluation_abr} – ${first.evaluation_name}`;
          evalLabel.className = "text-global-text font-medium truncate";
        }

        evalDisplay?.removeAttribute("disabled");
        evalDisplay?.classList.remove("cursor-not-allowed", "opacity-60");

        evaluations.forEach((ev: any, idx: number) => {
          const li = document.createElement("li");
          const val = ev.evaluation_abr || ev.evaluation_name;
          const isSelected = idx === 0;

          li.className = `eval-opt px-3.5 py-2 text-sm rounded-lg cursor-pointer transition-colors ${
            isSelected
              ? "bg-global-primary/10"
              : "hover:bg-[#222938]"
          }`;
          li.setAttribute("data-value", val);

          li.innerHTML = `<span class="font-semibold text-global-primary">${ev.evaluation_abr}</span> <span class="text-global-text-muted">–</span> <span class="text-global-text">${ev.evaluation_name}</span>`;

          li.addEventListener("click", () => {
            if (evalInput) evalInput.value = val;
            if (evalLabel) {
              evalLabel.textContent = `${ev.evaluation_abr} – ${ev.evaluation_name}`;
              evalLabel.className = "text-global-text font-medium truncate";
            }

            evalDropdown?.querySelectorAll(".eval-opt").forEach((opt) => {
              if (opt.getAttribute("data-value") === val) {
                opt.className = "eval-opt px-3.5 py-2 text-sm rounded-lg cursor-pointer transition-colors bg-global-primary/10";
              } else {
                opt.className = "eval-opt px-3.5 py-2 text-sm rounded-lg cursor-pointer transition-colors hover:bg-[#222938]";
              }
            });

            closeEvalDropdown();
          });

          evalDropdown?.appendChild(li);
        });
      } catch (err: any) {
        if (err.name !== "AbortError") {
          console.error("Error cargando evaluaciones del curso:", err);
          if (evalLabel) {
            evalLabel.textContent = "Error al cargar evaluaciones";
          }
        }
      }
    }

    document.addEventListener("click", (e) => {
      const target = e.target as Node;
      if (!yearContainer?.contains(target)) closeYearDropdown();
      if (!termContainer?.contains(target)) closeTermDropdown();
      if (!evalContainer?.contains(target)) closeEvalDropdown();
    });

    // 1.8. Manejo del input de archivo personalizado
    const fileInput = document.getElementById("file") as HTMLInputElement;
    const fileNameDisplay = document.getElementById("file-name-display")!;

    if (fileInput && fileNameDisplay) {
      fileInput.addEventListener("change", function () {
        if (this.files && this.files.length > 0) {
          fileNameDisplay.textContent = this.files[0].name;
          fileNameDisplay.classList.remove("text-global-text-muted");
          fileNameDisplay.classList.add("text-global-text");
        } else {
          fileNameDisplay.textContent = "Sin archivo";
          fileNameDisplay.classList.remove("text-global-text");
          fileNameDisplay.classList.add("text-global-text-muted");
        }
      });
    }

    // 2. Subida del Formulario de Aportes
    const form = document.getElementById("contribution-form") as HTMLFormElement;
    const formStatus = document.getElementById("form-status")!;
    const submitBtn = document.getElementById("submit-contrib-btn") as HTMLButtonElement;

    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      submitBtn.disabled = true;
      submitBtn.textContent = "Enviando...";

      formStatus.className = "p-3 text-sm rounded-xl border bg-global-primary/10 border-global-primary/20 text-global-primary text-center mt-4";
      formStatus.textContent = "Subiendo aporte a la plataforma...";
      formStatus.classList.remove("hidden");

      try {
        const formData = new FormData(form);
        const res = await fetch("/api/contributions/create", {
          method: "POST",
          body: formData,
        });

        const data = await res.json();
        if (!res.ok) {
          throw new Error(data.error || "Ocurrió un error inesperado");
        }

        formStatus.className = "p-3 text-sm rounded-xl border bg-green-500/10 border-green-500/20 text-green-400 text-center mt-4";
        formStatus.textContent = "¡Aporte recibido con éxito! Será revisado pronto.";
        form.reset();
        if (fileNameDisplay) {
          fileNameDisplay.textContent = "Sin archivo";
          fileNameDisplay.classList.remove("text-global-text");
          fileNameDisplay.classList.add("text-global-text-muted");
        }

        setTimeout(() => window.location.reload(), 1500);
      } catch (err: any) {
        formStatus.className = "p-3 text-sm rounded-xl border bg-red-500/10 border-red-500/20 text-red-500 text-center mt-4";
        formStatus.textContent = err.message || "Error al procesar el aporte.";
        submitBtn.disabled = false;
        submitBtn.textContent = "Enviar Donación";
      }
    });

    // 2.5. Vaciar Historial de Aportes
    const clearHistoryBtn = document.getElementById("clear-history-btn");
    const clearHistoryModal = document.getElementById("clear-history-modal");
    const closeClearModalBtn = document.getElementById("close-clear-modal-btn");
    const confirmClearHistoryBtn = document.getElementById("confirm-clear-history-btn") as HTMLButtonElement;

    if (clearHistoryBtn && clearHistoryModal && closeClearModalBtn && confirmClearHistoryBtn) {
      clearHistoryBtn.addEventListener("click", () => clearHistoryModal.classList.remove("hidden"));
      closeClearModalBtn.addEventListener("click", () => clearHistoryModal.classList.add("hidden"));
      clearHistoryModal.addEventListener("click", (e) => {
        if (e.target === clearHistoryModal) clearHistoryModal.classList.add("hidden");
      });

      confirmClearHistoryBtn.addEventListener("click", async () => {
        try {
          confirmClearHistoryBtn.disabled = true;
          confirmClearHistoryBtn.textContent = "Vaciando...";

          const res = await fetch("/api/contributions/clear-history", { method: "POST" });
          const data = await res.json();

          if (!res.ok) throw new Error(data.error || "Ocurrió un error inesperado al vaciar el historial");
          window.location.reload();
        } catch (err: any) {
          alert(err.message || "Error al vaciar el historial.");
          confirmClearHistoryBtn.disabled = false;
          confirmClearHistoryBtn.textContent = "Confirmar y Vaciar";
        }
      });
    }

    // 4. Modal de Edición de Perfil
    const editProfileBtn = document.getElementById("edit-profile-btn");
    const quickEditAvatarBtn = document.getElementById("quick-edit-avatar-btn");
    const editProfileModal = document.getElementById("edit-profile-modal");
    const closeEditProfileModalBtn = document.getElementById("close-edit-profile-modal");
    const closeEditProfileModalX = document.getElementById("close-edit-profile-modal-x");
    const editProfileForm = document.getElementById("edit-profile-form") as HTMLFormElement;
    const editProfileStatus = document.getElementById("edit-profile-status");
    const submitEditProfileBtn = document.getElementById("submit-edit-profile") as HTMLButtonElement;
    
    const avatarInput = document.getElementById("avatar-input") as HTMLInputElement;
    const editAvatarBtn = document.getElementById("edit-avatar-btn");
    const avatarFilename = document.getElementById("avatar-filename");
    const avatarPreview = document.getElementById("avatar-preview") as HTMLImageElement;

    if (editProfileBtn && editProfileModal && editProfileForm) {
      const openModal = () => editProfileModal.classList.remove("hidden");
      const closeModal = () => editProfileModal.classList.add("hidden");

      editProfileBtn.addEventListener("click", openModal);
      if (quickEditAvatarBtn) quickEditAvatarBtn.addEventListener("click", openModal);
      if (closeEditProfileModalBtn) closeEditProfileModalBtn.addEventListener("click", closeModal);
      if (closeEditProfileModalX) closeEditProfileModalX.addEventListener("click", closeModal);
      
      editProfileModal.addEventListener("click", (e) => {
        if (e.target === editProfileModal) closeModal();
      });

      // Manejo de Custom Select de Especialidad
      const specialtyContainer = document.getElementById("specialty-custom-select-container");
      const specialtyTrigger = document.getElementById("specialty-select-trigger");
      const specialtyDropdown = document.getElementById("specialty-select-dropdown");
      const specialtyLabel = document.getElementById("specialty-select-label");
      const specialtyChevron = document.getElementById("specialty-select-chevron");
      const specialtyInput = document.getElementById("specialty-input") as HTMLInputElement;

      function closeSpecialtySelect() {
        specialtyDropdown?.classList.add("hidden");
        specialtyChevron?.classList.remove("rotate-180");
        specialtyTrigger?.classList.remove("border-global-primary", "ring-1", "ring-global-primary");
      }

      if (specialtyTrigger && specialtyDropdown && specialtyInput) {
        specialtyTrigger.addEventListener("click", (e) => {
          e.stopPropagation();
          const isHidden = specialtyDropdown.classList.contains("hidden");
          if (isHidden) {
            specialtyDropdown.classList.remove("hidden");
            specialtyChevron?.classList.add("rotate-180");
            specialtyTrigger.classList.add("border-global-primary", "ring-1", "ring-global-primary");
          } else {
            closeSpecialtySelect();
          }
        });

        document.addEventListener("click", (e) => {
          if (!specialtyContainer?.contains(e.target as Node)) {
            closeSpecialtySelect();
          }
        });

        specialtyDropdown.querySelectorAll(".specialty-option").forEach((item) => {
          item.addEventListener("click", () => {
            const val = item.getAttribute("data-value") || "";
            const text = item.textContent?.trim() || "";
            specialtyInput.value = val;
            if (specialtyLabel) {
              specialtyLabel.textContent = text;
              specialtyLabel.className = val ? "text-global-text font-medium truncate" : "text-global-text-muted truncate";
            }
            
            specialtyDropdown.querySelectorAll(".specialty-option").forEach((opt) => {
              if (opt.getAttribute("data-value") === val && val !== "") {
                opt.className = "specialty-option px-3.5 py-2 text-sm rounded-lg cursor-pointer transition-colors bg-global-primary/10 text-global-primary font-semibold";
              } else {
                opt.className = "specialty-option px-3.5 py-2 text-sm text-global-text hover:bg-[#222938] hover:text-white rounded-lg cursor-pointer transition-colors";
              }
            });

            closeSpecialtySelect();
          });
        });
      }

      if (editAvatarBtn && avatarInput && avatarFilename && avatarPreview) {
        editAvatarBtn.addEventListener("click", () => avatarInput.click());
        
        avatarInput.addEventListener("change", function() {
          if (this.files && this.files.length > 0) {
            const file = this.files[0];
            avatarFilename!.textContent = file.name;
            
            const reader = new FileReader();
            reader.onload = (e) => {
              if (e.target?.result) {
                avatarPreview.src = e.target.result as string;
                avatarPreview.classList.remove("hidden");
                avatarPreview.nextElementSibling?.classList.add("hidden");
              }
            };
            reader.readAsDataURL(file);
          } else {
            avatarFilename!.textContent = "Solo JPG, PNG o WebP";
          }
        });
      }

      editProfileForm.addEventListener("submit", async (e) => {
        e.preventDefault();
        
        submitEditProfileBtn.disabled = true;
        submitEditProfileBtn.textContent = "Guardando...";
        
        editProfileStatus!.className = "p-3 text-sm rounded-xl border bg-global-primary/10 border-global-primary/20 text-global-primary text-center mt-3";
        editProfileStatus!.textContent = "Guardando cambios en el perfil...";
        editProfileStatus!.classList.remove("hidden");

        try {
          const formData = new FormData(editProfileForm);
          const res = await fetch("/api/profile/update", {
            method: "POST",
            body: formData,
          });

          const data = await res.json();
          if (!res.ok) throw new Error(data.error || "Ocurrió un error inesperado al actualizar perfil");

          editProfileStatus!.className = "p-3 text-sm rounded-xl border bg-green-500/10 border-green-500/20 text-green-400 text-center mt-3";
          editProfileStatus!.textContent = "¡Perfil actualizado con éxito!";
          
          setTimeout(() => window.location.reload(), 1000);
        } catch (err: any) {
          editProfileStatus!.className = "p-3 text-sm rounded-xl border bg-red-500/10 border-red-500/20 text-red-500 text-center mt-3";
          editProfileStatus!.textContent = err.message || "Error al actualizar perfil.";
          submitEditProfileBtn.disabled = false;
          submitEditProfileBtn.textContent = "Guardar Cambios";
        }
      });
    }
  });
</script>

<style>
  @keyframes fadeInTab {
    from {
      opacity: 0;
      transform: translateY(3px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .tab-panel:not(.hidden) {
    animation: fadeInTab 0.18s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
</style>
