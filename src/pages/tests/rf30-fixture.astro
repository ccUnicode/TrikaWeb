---
// Este archivo sirve únicamente para probar la UI del Dropdown (RF-30) con Playwright
// en un entorno controlado (sin autenticación, mocking de API)
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Test Fixture RF-30">
  <div class="min-h-screen py-8">
    <div class="mx-auto w-full max-w-3xl px-4">
      <section class="rounded-2xl bg-global-surface border border-global-border p-6 mb-6">
        <h2 class="text-lg font-semibold text-global-text mb-4">
          Test Fixture RF-30
        </h2>
        
        <form id="upload-form" class="space-y-4">
          <div class="grid gap-4 sm:grid-cols-2">
            <div class="relative" id="course-combobox-container">
              <label class="block text-sm font-medium text-global-text-muted mb-1.5" for="course-search">
                Curso
              </label>
              <div class="relative">
                <input type="hidden" id="course-code" name="course_code" />
                <input
                  type="text"
                  id="course-search"
                  autocomplete="off"
                  class="w-full rounded-xl border border-global-border bg-global-card px-3 py-2.5 text-sm text-global-text outline-none focus:border-global-primary focus:ring-1 focus:ring-global-primary transition-colors"
                  placeholder="Cargando cursos..."
                />
              </div>
              <ul
                id="course-dropdown"
                class="absolute z-10 top-full left-0 mt-1 w-full max-h-60 overflow-auto rounded-xl border border-global-border bg-global-surface shadow-lg hidden"
              >
              </ul>
            </div>
            
            <div>
              <label class="block text-sm font-medium text-global-text-muted mb-1.5" for="teacher-select">
                Docente
              </label>
              <select
                id="teacher-select"
                name="teacher_hint"
                class="w-full rounded-xl border border-global-border bg-global-card px-3 py-2.5 text-sm text-global-text outline-none focus:border-global-primary focus:ring-1 focus:ring-global-primary transition-colors cursor-pointer disabled:opacity-60 disabled:cursor-not-allowed"
                disabled
              >
                <option value="">-- Ingresa un curso primero --</option>
              </select>
              <p id="teacher-loading" class="hidden mt-1 text-xs text-global-text-muted">
                Cargando profesores...
              </p>
            </div>
          </div>
        </form>
      </section>
    </div>
  </div>

  <script>
    import { initCourseTeacherDropdown } from "../../scripts/course-teacher-dropdown";
    document.addEventListener("DOMContentLoaded", () => {
      initCourseTeacherDropdown();
    });
  </script>
</Layout>
