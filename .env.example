# ==========================================================
# TRIKAWEB - Variables de entorno
# Copiar este archivo como: .env
#
# IMPORTANTE:
# - Nunca subir el archivo .env al repositorio.
# - Completar únicamente las variables necesarias.
# - No utilizar credenciales reales como valores de ejemplo.
# ==========================================================


# ==========================================================
# SERVIDOR
# Estas variables NO se exponen al navegador.
# ==========================================================

# ---------- Supabase ----------

# URL del proyecto de Supabase.
# Ejemplo: https://xxxxx.supabase.co
SUPABASE_URL=""

# Service Role Key utilizada exclusivamente desde el servidor.
# NUNCA exponer esta clave al cliente.
SUPABASE_SERVICE_KEY=""

# Algunos scripts admiten este nombre alternativo para la Service Role Key.
# Configurarlo solo si el script o entorno utilizado lo requiere.
# SUPABASE_SERVICE_ROLE_KEY=""


# ---------- Seguridad ----------

# Cadena aleatoria larga utilizada para generar hashes asociados a IP.
IP_SALT=""


# ---------- Google Drive Sync ----------

# Ruta al archivo JSON de credenciales de la cuenta de servicio de Google.
# No subir este archivo de credenciales al repositorio.
GOOGLE_APPLICATION_CREDENTIALS=""

# IDs de las carpetas utilizadas por los scripts de sincronización.
DRIVE_EXAMS_FOLDER_ID=""
DRIVE_SOLUTIONS_FOLDER_ID=""


# ==========================================================
# CLIENTE / NAVEGADOR
# Estas variables son públicas.
# En Astro deben iniciar con PUBLIC_.
# ==========================================================

# ---------- Supabase ----------

# URL pública del proyecto de Supabase.
PUBLIC_SUPABASE_URL=""

# Anon / Publishable Key de Supabase.
# Esta clave puede utilizarse desde el navegador.
PUBLIC_SUPABASE_ANON_KEY=""