# ==========================================================
# TRIAKWEB - Variables de Entorno
# Copiar este archivo como: .env
#
# IMPORTANTE:
# - Nunca subir el archivo .env al repositorio.
# - Completar los valores con las credenciales correspondientes.
# ==========================================================


# ==========================================================
# SERVIDOR (NO se expone al navegador)
# ==========================================================

# ---------- Supabase ----------
SUPABASE_URL=""                  # https://xxxxx.supabase.co
SUPABASE_SERVICE_KEY=""          # Service Role Key (NUNCA exponer al cliente)

# ---------- Seguridad ----------
IP_SALT=""                       # Cadena aleatoria larga para hash de IP
ADMIN_PASS=""                    # Contraseña del panel de administración

# ---------- Firebase Admin ----------
# Obtener desde:
# Firebase Console -> Project Settings -> Service Accounts

FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""          # Mantener los '\n' tal como aparecen en el JSON

# ---------- Google Drive Sync ----------
# IDs de carpetas utilizadas por scripts de sincronización

DRIVE_EXAMS_FOLDER_ID=""
DRIVE_SOLUTIONS_FOLDER_ID=""

# (Opcional)
# TURNSTILE_SECRET_KEY=""
# SENTRY_DSN=""


# ==========================================================
# CLIENTE / NAVEGADOR
# (Estas variables son públicas)
# En Astro deben iniciar con PUBLIC_
# ==========================================================

# ---------- Supabase ----------
PUBLIC_SUPABASE_URL=""
PUBLIC_SUPABASE_ANON_KEY=""

# ---------- Firebase Web SDK ----------
# Estas variables SON PÚBLICAS y es correcto que estén en el cliente.

PUBLIC_FIREBASE_API_KEY=""
PUBLIC_FIREBASE_AUTH_DOMAIN=""
PUBLIC_FIREBASE_PROJECT_ID=""
PUBLIC_FIREBASE_STORAGE_BUCKET=""
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
PUBLIC_FIREBASE_APP_ID=""

# (Opcional)
# PUBLIC_APP_ENV="development"
# PUBLIC_TURNSTILE_SITE_KEY=""